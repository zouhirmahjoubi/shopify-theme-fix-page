<header style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid #ccc">
  <strong>fixture header</strong>
  <a id="bagBtn" href="/cart" data-cart-drawer-open aria-label="Cart, {{ cart.item_count }} items">Bag <span data-cart-count>{{ cart.item_count }}</span></a>
</header>
<main style="padding:16px;display:grid;gap:12px;max-width:520px">
  <div class="fixture-card">
    <img data-cvm-fly-img src="{{ 'best-case-detail.png' | asset_url }}" alt="" width="120" height="120">
    <a href="/products/tech-fabric" id="qpBuy" data-cvqp-open data-handle="tech-fabric" data-url="/products/tech-fabric" data-cvqp-buy-now>Quick add (with Buy now)</a>
    <a href="/products/tech-fabric" id="qpPlain" data-cvqp-open data-handle="tech-fabric" data-url="/products/tech-fabric">Quick add</a>
  </div>
  <form data-cart-add-form id="cardForm" action="/cart/add" method="post"><input type="hidden" name="id" value="41003"><button type="submit" id="cardAdd">Add single case (fixture)</button></form>
  <button type="button" id="legacy">fire legacy cart:updated</button>
  <a href="#after" id="after">link after drawer</a>
</main>
{% render 'cart-drawer' %}
{% render 'cv-quick-pick', sid: 'h' %}
