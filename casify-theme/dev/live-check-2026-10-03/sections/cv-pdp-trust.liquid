{%- comment -%}
  Casify product page: secure-checkout bar.
  A single true reassurance at the decision point, distinct from the service
  ribbon (brand facts) and the guarantee section (shipping/returns/dispatch
  promises, stated once at the close): this bar is about payment trust only.

  Payment icons come from shop.enabled_payment_types, the same real, live
  list the footer's payment row reads (sections/footer.liquid) — never a
  hardcoded logo set, so it can never claim a method the store doesn't
  actually accept. With none configured, the bar still shows the lock line
  alone; nothing here is invented to fill the row.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-trust.css' | asset_url | stylesheet_tag }}

<section class="cvw cvw-trust" data-cvw-trust aria-label="{{ section.settings.heading | escape }}">
  <div class="cvp__inner cvw-trust__inner">
    <p class="cvw-trust__line">
      <span class="cvw-trust__lock" data-cvw-trust-lock aria-hidden="true">{%- render 'cv-icon', name: 'lock-secure', size: 22 -%}</span>
      <span>{{ section.settings.heading | escape }}</span>
    </p>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="cvw-trust__pay" aria-label="{{ section.settings.pay_label | escape }}" data-cvw-trust-pay>
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'cvw-trust__pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}<div class="cvw-trust__app" {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product: secure checkout",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Line", "default": "Secure checkout, encrypted payment", "info": "Payment icons below are read live from your enabled payment methods (Settings > Payments) — nothing here is hardcoded." },
    { "type": "text", "id": "pay_label", "label": "Payment icons label (screen readers)", "default": "Accepted payment methods" }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "Product: secure checkout" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
