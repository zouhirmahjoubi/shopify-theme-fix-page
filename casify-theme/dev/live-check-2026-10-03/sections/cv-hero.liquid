{%- comment -%}
  Casify — homepage hero: the copy on the left, the shop window on the right.

  The window photo and the sweets around it were generated with GPT Image 2.5
  on KIE: assets/hero-window.webp (image-to-image from hero-gift-edition.jpg so
  the case design matches the product) and assets/hero-sweet-*.webp (shot on a
  cobalt chroma backdrop and keyed out). A "Window image" upload replaces the
  built-in photo.

  Motion: assets/cv-hero.js (GSAP; it waits for DOMContentLoaded, because this
  deferred script runs before the GSAP bundle at the end of the layout).
  Styles: assets/cv-hero.css. The CSS is the finished state, so the hero reads
  correctly without JS and under reduced motion.
{%- endcomment -%}
{{ 'cv-hero.css' | asset_url | stylesheet_tag }}
<script>
  /* Hide the pieces that animate in until cv-hero.js has set their start
     states. Never under reduced motion, and never for long. */
  (function (root) {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('cvhero-pending');
    setTimeout(function () { root.classList.remove('cvhero-pending'); }, 1600);
  })(document.documentElement);
</script>

{%- liquid
  assign heading = section.settings.heading | default: 'A clear case that survives a 12 ft drop' | escape
  assign accent = section.settings.heading_accent | escape
  assign has_accent = false
  if accent != blank and heading contains accent
    assign has_accent = true
    assign parts = heading | split: accent
    assign before = parts.first | strip
    assign after_start = parts.first.size | plus: accent.size
    assign after = heading | slice: after_start, heading.size | strip
  endif

  assign alt_raw = section.settings.image_alt | default: 'A candy-striped Casify clear case on a marble counter in a vintage candy shop'
  assign alt = alt_raw | escape

  assign metric_count = 0
  assign tag_block = nil
  for b in section.blocks
    if b.type == 'metric'
      assign metric_count = metric_count | plus: 1
    elsif b.type == 'tag' and tag_block == nil
      assign tag_block = b
    endif
  endfor
-%}

<section class="cvhero" data-cv-hero>
  <div class="cvhero__inner">
    <div class="cvhero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cv-eyebrow cvhero__eyebrow" data-cvhero-in>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="cvhero__title">
        <span class="cvhero__sr">{{ heading }}</span>
        <span class="cvhero__lines" aria-hidden="true">
          {%- if has_accent -%}
            {%- if before != blank -%}{%- render 'cv-hero-words', text: before -%}{{ ' ' }}{%- endif -%}
            <em class="cvhero__accent">
              {%- render 'cv-hero-words', text: accent -%}
              <svg class="cvhero__squiggle" viewBox="0 0 300 22" preserveAspectRatio="none" focusable="false"><path d="M4 14C38 5 66 19 102 11s66-9 100 1 64 8 94-4"/></svg>
            </em>
            {%- if after != blank -%}{{ ' ' }}{%- render 'cv-hero-words', text: after -%}{%- endif -%}
          {%- else -%}
            {%- render 'cv-hero-words', text: heading -%}
          {%- endif -%}
        </span>
      </h1>

      {%- if section.settings.subheading != blank -%}
        <div class="cvhero__lede" data-cvhero-in>{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="cvhero__actions" data-cvhero-in>
          <a class="cv-cta cvhero__cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
            <span class="cv-cta__shine" aria-hidden="true"></span>
            {%- render 'cv-icon', name: 'bag', size: 18 -%}
            <span class="cv-cta__label">{{ section.settings.cta_label | escape }}</span>
          </a>
        </div>
      {%- endif -%}

      {%- if metric_count > 0 -%}
        <ul class="cvhero__specs" data-cvhero-in>
          {%- for b in section.blocks -%}
            {%- if b.type == 'metric' -%}
              <li {{ b.shopify_attributes }}>
                <b><span class="cvhero__num" data-cvhero-count="{{ b.settings.value | escape }}" style="min-width:{{ b.settings.value.size }}ch">{{ b.settings.value | escape }}</span><small>{{ b.settings.unit | escape }}</small></b>
                <span class="cvhero__spec-label">{{ b.settings.label | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="cvhero__stage">
      <span class="cvhero__sunburst" aria-hidden="true"></span>

      <div class="cvhero__window">
        <div class="cvhero__glass">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1100 | image_tag: widths: '480, 720, 960, 1100', sizes: '(min-width: 990px) 420px, 76vw', class: 'cvhero__photo', alt: alt_raw, loading: 'eager', fetchpriority: 'high' }}
          {%- else -%}
            <img class="cvhero__photo" src="{{ 'hero-window.webp' | asset_url }}" width="1100" height="1467" alt="{{ alt }}" loading="eager" fetchpriority="high" decoding="async">
          {%- endif -%}
          <span class="cvhero__sheen" aria-hidden="true"></span>
          <span class="cvhero__blind" aria-hidden="true">
            <span class="cvhero__valance"><span class="cvhero__scallops"></span></span>
          </span>
        </div>

        {%- if tag_block != nil -%}
          <div class="cvhero__tag" {{ tag_block.shopify_attributes }}>
            <span class="cvhero__tag-string" aria-hidden="true"></span>
            <p class="cvhero__tag-card"><b>{{ tag_block.settings.title | escape }}</b><i>{{ tag_block.settings.body | escape }}</i></p>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_sweets -%}
        {%- comment -%} name:width:height:kind:depth — "rest" sweets drop onto the sill, "float" ones bob; depth scales pointer drift. {%- endcomment -%}
        {%- assign sweets = 'cane:329:440:rest:0.55,wrapped-teal:440:164:rest:0.8,wrapped-red:440:212:float:1,lollipop:313:440:float:0.45,coin:344:345:float:0.7' | split: ',' -%}
        <div class="cvhero__sweets" aria-hidden="true">
          {%- for entry in sweets -%}
            {%- assign p = entry | split: ':' -%}
            <span class="cvhero__sweet cvhero__sweet--{{ p[0] }}" data-kind="{{ p[3] }}" data-depth="{{ p[4] }}">
              <img src="{{ 'hero-sweet-' | append: p[0] | append: '.webp' | asset_url }}" width="{{ p[1] }}" height="{{ p[2] }}" alt="" loading="eager" decoding="async">
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'cv-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Est. 1920 · Engineered protection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A clear case that survives a 12 ft drop" },
    { "type": "text", "id": "heading_accent", "label": "Highlighted words", "default": "12 ft drop", "info": "Set in red italic with a hand-drawn underline. Must match part of the heading exactly." },
    { "type": "richtext", "id": "subheading", "label": "Sub-heading", "default": "<p>Cut from your phone's own CAD file. Holds 1,400 g on a magnet and stays clear for three years.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Find my model" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Shop window" },
    { "type": "image_picker", "id": "image", "label": "Window image", "info": "Portrait, 3:4. Leave empty to use the built-in candy-shop photo." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "checkbox", "id": "show_sweets", "label": "Show sweets around the window", "default": true }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Spec",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "value", "label": "Number", "default": "12", "info": "Counts up on load when it's a plain number." },
        { "type": "text", "id": "unit", "label": "Unit", "default": "ft" },
        { "type": "text", "id": "label", "label": "Label", "default": "drop tested" }
      ]
    },
    {
      "type": "tag",
      "name": "Hanging tag",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "36 mo" },
        { "type": "text", "id": "body", "label": "Body", "default": "stays clear" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "metric", "settings": { "value": "12", "unit": "ft", "label": "drop tested" } },
        { "type": "metric", "settings": { "value": "1,400", "unit": "g", "label": "magnet hold" } },
        { "type": "metric", "settings": { "value": "2.8", "unit": "mm", "label": "back profile" } },
        { "type": "tag", "settings": { "title": "36 mo", "body": "stays clear" } }
      ]
    }
  ]
}
{% endschema %}
