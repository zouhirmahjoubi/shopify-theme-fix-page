{% doc %}
  Google and Trustpilot store ratings, shown under the price in the product
  counter (sections/cv-product-counter.liquid). Each platform is its own
  ticket with its own score and count, so one platform's number is never
  shown as the other's. A ticket renders only when its rating is filled in,
  and links to the review profile when a link is set.

  Styles: assets/cv-pdp-counter.css (.cvrb).

  @param {object} settings - The product counter section's settings.

  @example
  {% render 'cv-store-ratings', settings: section.settings %}
{% enddoc %}
{%- liquid
  assign g_rating = settings.external_review_rating | strip
  assign g_value = g_rating | replace: ',', '.' | plus: 0 | at_most: 5
  assign g_count = settings.external_review_count | strip
  assign g_url = settings.google_reviews_url

  assign t_rating = settings.trustpilot_rating | strip
  assign t_value = t_rating | replace: ',', '.' | plus: 0 | at_most: 5
  assign t_count = settings.trustpilot_review_count | strip
  assign t_url = settings.trustpilot_url
  assign g_fill = g_value | times: 20
  assign t_fill = t_value | times: 20

  assign show_strip = false
  if settings.show_external_review_badges
    if g_value > 0 or t_value > 0
      assign show_strip = true
    endif
  endif
-%}
{%- if show_strip -%}
  <div class="cvrb" role="group" aria-label="{{ 'products.review_badges.group_label' | t | escape }}">
    {%- if g_value > 0 -%}
      {%- capture g_label -%}
        {%- if g_count != blank -%}
          {{ 'products.review_badges.google_label' | t: rating: g_rating, count: g_count }}
        {%- else -%}
          {{ 'products.review_badges.google_label_no_count' | t: rating: g_rating }}
        {%- endif -%}
      {%- endcapture -%}
      {%- if g_url != blank -%}
        <a class="cvrb__chip cvrb__chip--google" href="{{ g_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ g_label | strip | escape }} {{ 'products.google_rating.new_window' | t | escape }}">
      {%- else -%}
        <p class="cvrb__chip cvrb__chip--google" role="img" aria-label="{{ g_label | strip | escape }}">
      {%- endif -%}
        <span class="cvrb__brand" aria-hidden="true">
          <svg class="cvrb__logo" viewBox="0 0 24 24" width="18" height="18" focusable="false">
            <path fill="#4285f4" d="M21.56 12.25c0-.79-.07-1.54-.2-2.25H12v4.26h5.35a4.58 4.58 0 0 1-1.99 3v2.77h3.23c1.9-1.75 2.97-4.33 2.97-7.78Z"/>
            <path fill="#34a853" d="M12 22c2.7 0 4.96-.9 6.59-2.43l-3.23-2.77c-.9.6-2.05.96-3.36.96-2.6 0-4.81-1.76-5.6-4.13H3.06v2.85A9.96 9.96 0 0 0 12 22Z"/>
            <path fill="#fbbc05" d="M6.4 13.63A6 6 0 0 1 6.09 12c0-.57.11-1.12.31-1.63V7.52H3.06A9.96 9.96 0 0 0 2 12c0 1.61.38 3.14 1.06 4.48l3.34-2.85Z"/>
            <path fill="#ea4335" d="M12 6.24c1.47 0 2.79.5 3.83 1.5l2.83-2.83A9.5 9.5 0 0 0 12 2a9.96 9.96 0 0 0-8.94 5.52l3.34 2.85C7.19 8 9.4 6.24 12 6.24Z"/>
          </svg>
          {{- 'products.review_badges.google' | t -}}
        </span>
        <span class="cvrb__stars" aria-hidden="true">{%- render 'cv-stars', fill: g_fill -%}</span>
        <span class="cvrb__score" aria-hidden="true">
          <strong>{{ 'products.review_badges.score' | t: rating: g_rating }}</strong>
          {%- if g_count != blank -%}<span>{{ 'products.review_badges.reviews' | t: count: g_count }}</span>{%- endif -%}
        </span>
      {%- if g_url != blank -%}</a>{%- else -%}</p>{%- endif -%}
    {%- endif -%}

    {%- if t_value > 0 -%}
      {%- capture t_label -%}
        {%- if t_count != blank -%}
          {{ 'products.review_badges.trustpilot_label' | t: rating: t_rating, count: t_count }}
        {%- else -%}
          {{ 'products.review_badges.trustpilot_label_no_count' | t: rating: t_rating }}
        {%- endif -%}
      {%- endcapture -%}
      {%- comment -%} Trustpilot's own star look: white stars on green squares, filled to the score. {%- endcomment -%}
      {%- capture tp_star -%}<span class="cvrb__tp-box"><svg viewBox="0 0 24 24" focusable="false"><path d="m12 4.2 2.2 5.1 5.5.4-4.2 3.6 1.3 5.4L12 15.8l-4.8 2.9 1.3-5.4-4.2-3.6 5.5-.4z"/></svg></span>{%- endcapture -%}
      {%- if t_url != blank -%}
        <a class="cvrb__chip cvrb__chip--trustpilot" href="{{ t_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ t_label | strip | escape }} {{ 'products.google_rating.new_window' | t | escape }}">
      {%- else -%}
        <p class="cvrb__chip cvrb__chip--trustpilot" role="img" aria-label="{{ t_label | strip | escape }}">
      {%- endif -%}
        <span class="cvrb__brand" aria-hidden="true">
          <svg class="cvrb__logo cvrb__logo--tp" viewBox="0 0 24 24" width="18" height="18" focusable="false"><path d="m12 2.3 2.85 5.78 6.38.93-4.62 4.5 1.09 6.36L12 16.87l-5.7 3 1.09-6.36-4.62-4.5 6.38-.93z"/></svg>
          {{- 'products.review_badges.trustpilot' | t -}}
        </span>
        <span class="cvrb__stars cvrb__tp" style="--fill: {{ t_fill }}%;" aria-hidden="true">
          <span class="cvrb__tp-row">{{ tp_star }}{{ tp_star }}{{ tp_star }}{{ tp_star }}{{ tp_star }}</span>
          <span class="cvrb__tp-row cvrb__tp-row--fill">{{ tp_star }}{{ tp_star }}{{ tp_star }}{{ tp_star }}{{ tp_star }}</span>
        </span>
        <span class="cvrb__score" aria-hidden="true">
          <strong>{{ 'products.review_badges.score' | t: rating: t_rating }}</strong>
          {%- if t_count != blank -%}<span>{{ 'products.review_badges.reviews' | t: count: t_count }}</span>{%- endif -%}
        </span>
      {%- if t_url != blank -%}</a>{%- else -%}</p>{%- endif -%}
    {%- endif -%}
  </div>
{%- endif -%}
