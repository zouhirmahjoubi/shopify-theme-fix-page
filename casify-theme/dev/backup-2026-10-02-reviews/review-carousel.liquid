{%- comment -%}
  Review Carousel — swipeable testimonial slider.
  CSS scroll-snap for native touch swiping, arrows + dots, optional autoplay
  (pauses on hover, focus, hidden tab, and for prefers-reduced-motion).
{%- endcomment -%}

{%- assign sid = section.id -%}

<style>
  #rc-{{ sid }} {
    --rc-bg: {{ section.settings.bg }};
    --rc-card: {{ section.settings.card_bg }};
    --rc-text: {{ section.settings.text }};
    --rc-muted: {{ section.settings.text | color_modify: 'alpha', 0.65 }};
    --rc-line: {{ section.settings.text | color_modify: 'alpha', 0.14 }};
    --rc-star: {{ section.settings.star }};
    --rc-per: {{ section.settings.per_view }};
    --rc-gap: 20px;
    background: var(--rc-bg);
    color: var(--rc-text);
    padding: {{ section.settings.pad_top }}px 0 {{ section.settings.pad_bottom }}px;
  }
  #rc-{{ sid }} .rc-wrap { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  #rc-{{ sid }} .rc-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 32px; }
  #rc-{{ sid }} .rc-head h2 { margin: 0 0 6px; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.15; color: inherit; }
  #rc-{{ sid }} .rc-head p { margin: 0; color: var(--rc-muted); }
  #rc-{{ sid }} .rc-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--rc-muted); margin-top: 8px; }
  #rc-{{ sid }} .rc-badge b { color: var(--rc-text); }

  #rc-{{ sid }} .rc-nav { display: flex; gap: 10px; flex: none; }
  #rc-{{ sid }} .rc-arrow {
    width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--rc-line);
    background: var(--rc-card); color: var(--rc-text); cursor: pointer;
    display: grid; place-items: center; transition: background .15s, color .15s, opacity .15s;
  }
  #rc-{{ sid }} .rc-arrow:hover:not(:disabled) { background: var(--rc-text); color: var(--rc-bg); }
  #rc-{{ sid }} .rc-arrow:disabled { opacity: .35; cursor: default; }

  #rc-{{ sid }} .rc-track {
    display: flex; gap: var(--rc-gap); overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; scrollbar-width: none; padding: 4px 2px 8px;
    -webkit-overflow-scrolling: touch;
  }
  #rc-{{ sid }} .rc-track::-webkit-scrollbar { display: none; }

  #rc-{{ sid }} .rc-slide {
    flex: 0 0 calc((100% - (var(--rc-per) - 1) * var(--rc-gap)) / var(--rc-per));
    scroll-snap-align: start;
    background: var(--rc-card); border: 1px solid var(--rc-line); border-radius: 16px;
    padding: 28px; display: flex; flex-direction: column; gap: 16px;
  }
  #rc-{{ sid }} .rc-stars { color: var(--rc-star); font-size: 18px; letter-spacing: 2px; line-height: 1; }
  #rc-{{ sid }} .rc-stars s { color: var(--rc-line); text-decoration: none; }
  #rc-{{ sid }} blockquote { margin: 0; font-size: 17px; line-height: 1.6; }
  #rc-{{ sid }} blockquote strong { display: block; font-size: 18px; margin-bottom: 6px; }

  #rc-{{ sid }} .rc-author { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--rc-line); }
  #rc-{{ sid }} .rc-avatar { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex: none; background: var(--rc-text); color: var(--rc-bg); display: grid; place-items: center; font-weight: 700; }
  #rc-{{ sid }} .rc-avatar img { width: 100%; height: 100%; object-fit: cover; }
  #rc-{{ sid }} .rc-author small { display: block; color: var(--rc-muted); font-size: 13px; margin-top: 2px; }
  #rc-{{ sid }} .rc-product { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--rc-muted); text-decoration: none; }
  #rc-{{ sid }} .rc-product img { width: 40px; height: 40px; border-radius: 8px; object-fit: cover; }
  #rc-{{ sid }} .rc-product:hover { color: var(--rc-text); }

  #rc-{{ sid }} .rc-dots { display: flex; justify-content: center; gap: 8px; margin-top: 24px; }
  #rc-{{ sid }} .rc-dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 99px; background: var(--rc-line); cursor: pointer; transition: width .25s, background .25s; }
  #rc-{{ sid }} .rc-dot[aria-current="true"] { width: 24px; background: var(--rc-text); }

  @media (max-width: 989px) { #rc-{{ sid }} { --rc-per: {{ section.settings.per_view | at_most: 2 }}; } }
  @media (max-width: 649px) {
    #rc-{{ sid }} { --rc-per: 1.12; --rc-gap: 14px; }
    #rc-{{ sid }} .rc-nav { display: none; }
    #rc-{{ sid }} .rc-slide { padding: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { #rc-{{ sid }} .rc-track { scroll-behavior: auto; } }
</style>

<section id="rc-{{ sid }}" class="rc" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}"
  data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="rc-wrap">
    <div class="rc-head">
      <div>
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.badge != blank -%}
          <div class="rc-badge"><span class="rc-stars" aria-hidden="true">★★★★★</span> {{ section.settings.badge }}</div>
        {%- endif -%}
      </div>
      <div class="rc-nav">
        <button type="button" class="rc-arrow" data-rc-prev aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="rc-arrow" data-rc-next aria-label="Next reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="rc-track" data-rc-track tabindex="0">
      {%- for block in section.blocks -%}
        <article class="rc-slide" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
          <div class="rc-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
            {%- for i in (1..5) -%}{%- if i <= block.settings.rating -%}★{%- else -%}<s>★</s>{%- endif -%}{%- endfor -%}
          </div>

          <blockquote>
            {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong>{%- endif -%}
            {{ block.settings.text }}
          </blockquote>

          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a class="rc-product" href="{{ p.url }}">
              {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}
              <span>Purchased: {{ p.title }}</span>
            </a>
          {%- endif -%}

          <div class="rc-author">
            <span class="rc-avatar">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.author }}
              {%- else -%}
                {{ block.settings.author | slice: 0 | upcase }}
              {%- endif -%}
            </span>
            <div>
              <strong>{{ block.settings.author }}</strong>
              {%- if block.settings.meta != blank -%}<small>{{ block.settings.meta }}</small>{%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div class="rc-dots" data-rc-dots></div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('rc-{{ sid }}');
    if (!root) return;
    var track = root.querySelector('[data-rc-track]');
    var slides = track.querySelectorAll('.rc-slide');
    var prev = root.querySelector('[data-rc-prev]');
    var next = root.querySelector('[data-rc-next]');
    var dotsWrap = root.querySelector('[data-rc-dots]');
    if (!slides.length) return;

    function step() {
      return slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth;
    }
    function maxScroll() { return track.scrollWidth - track.clientWidth; }
    function pages() { return Math.max(1, Math.round(maxScroll() / step()) + 1); }
    function current() { return Math.round(track.scrollLeft / step()); }
    function go(i) { track.scrollTo({ left: Math.max(0, Math.min(i, pages() - 1)) * step() }); }

    function buildDots() {
      dotsWrap.innerHTML = '';
      var n = pages();
      if (n < 2) return;
      for (var i = 0; i < n; i++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'rc-dot';
        b.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        b.addEventListener('click', go.bind(null, i));
        dotsWrap.appendChild(b);
      }
      update();
    }
    function update() {
      var c = current();
      dotsWrap.querySelectorAll('.rc-dot').forEach(function (d, i) { d.setAttribute('aria-current', i === c); });
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll() - 2;
    }

    prev.addEventListener('click', function () { go(current() - 1); });
    next.addEventListener('click', function () { go(current() + 1); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
    });
    window.addEventListener('resize', buildDots);
    buildDots();

    // Autoplay
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var designMode = window.Shopify && Shopify.designMode;
    if (root.dataset.autoplay === 'true' && !reduce && !designMode) {
      var paused = false;
      var ms = (parseInt(root.dataset.speed, 10) || 5) * 1000;
      ['mouseenter', 'focusin', 'touchstart'].forEach(function (t) { root.addEventListener(t, function () { paused = true; }, { passive: true }); });
      ['mouseleave', 'focusout'].forEach(function (t) { root.addEventListener(t, function () { paused = false; }); });
      setInterval(function () {
        if (paused || document.hidden) return;
        current() >= pages() - 1 ? go(0) : go(current() + 1);
      }, ms);
    }

    // Theme editor: scroll to the block being edited
    root.addEventListener('shopify:block:select', function (e) {
      var i = Array.prototype.indexOf.call(slides, e.target);
      if (i > -1) go(i);
    });
  })();
</script>

{% schema %}
{
  "name": "Review carousel",
  "tag": "div",
  "class": "section-review-carousel",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Don't just take our word for it." },
    { "type": "text", "id": "badge", "label": "Rating badge text", "default": "Rated 4.9/5 from 2,000+ reviews" },
    { "type": "header", "content": "Carousel" },
    { "type": "range", "id": "per_view", "label": "Reviews visible (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "speed", "label": "Autoplay speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#f7f7f5" },
    { "type": "color", "id": "text", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "star", "label": "Stars", "default": "#f5a623" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Exceeded my expectations" },
        { "type": "textarea", "id": "text", "label": "Review", "default": "The quality is outstanding and it arrived faster than expected. I get compliments every time I use it." },
        { "type": "text", "id": "author", "label": "Name", "default": "Sarah M." },
        { "type": "text", "id": "meta", "label": "Subtitle", "default": "Verified buyer" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
        { "type": "product", "id": "product", "label": "Product reviewed (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review carousel",
      "blocks": [
        { "type": "review", "settings": { "author": "Sarah M.", "title": "Exceeded my expectations", "text": "The quality is outstanding and it arrived faster than expected. I get compliments every time I use it." } },
        { "type": "review", "settings": { "author": "James K.", "title": "Worth every penny", "text": "Premium feel, perfect fit and great customer service. Already recommended it to friends." } },
        { "type": "review", "settings": { "author": "Lina R.", "title": "My new favorite", "text": "Looks exactly like the photos. The details are beautiful and it feels built to last." } },
        { "type": "review", "settings": { "author": "Omar B.", "rating": 4, "title": "Great purchase", "text": "Really happy with it. Packaging was lovely too, felt like opening a gift." } },
        { "type": "review", "settings": { "author": "Emma T.", "title": "Ordering another", "text": "Bought one for me and now I'm getting one for my sister. Highly recommend!" } }
      ]
    }
  ]
}
{% endschema %}
