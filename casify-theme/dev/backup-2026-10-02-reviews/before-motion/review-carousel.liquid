{%- comment -%}
  Review carousel: a swipeable row of reviews the merchant picks and types in.
  CSS scroll-snap for touch, arrows and dots, optional autoplay (pauses on hover,
  focus, touch, a hidden tab, and for prefers-reduced-motion).

  Shows nothing until a review has both a name and text, so the section never
  fills itself with sample reviews. Reviews customers send through the review
  widget's form appear in the review widget once approved; copy a favourite here
  to feature it.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign st = section.settings
  assign review_count = 0
  for block in section.blocks
    if block.settings.author != blank and block.settings.text != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
-%}

{%- if review_count > 0 -%}
  <style>
    #rc-{{ sid }} {
      --rc-bg: var(--cream-50, #FDF9F1);
      --rc-card: var(--cream-100, #FBF3E4);
      --rc-text: var(--cocoa-700, #33231A);
      --rc-body: var(--cocoa-600, #4A3324);
      --rc-muted: var(--cocoa-500, #6B4229);
      --rc-line: rgba(74, 51, 36, .18);
      --rc-dash: rgba(74, 51, 36, .34);
      --rc-accent: var(--red-500, #C4302B);
      --rc-per: {{ st.per_view }};
      --rc-gap: 20px;
      background: var(--rc-bg);
      color: var(--rc-text);
      padding: {{ st.pad_top }}px 0 {{ st.pad_bottom }}px;
    }
    {%- if st.style == 'custom' %}
    #rc-{{ sid }} {
      --rc-bg: {{ st.bg }};
      --rc-card: {{ st.card_bg }};
      --rc-text: {{ st.text }};
      --rc-body: {{ st.text }};
      --rc-muted: {{ st.text | color_modify: 'alpha', 0.65 }};
      --rc-line: {{ st.text | color_modify: 'alpha', 0.14 }};
      --rc-dash: {{ st.text | color_modify: 'alpha', 0.14 }};
      --rc-accent: {{ st.text }};
    }
    {%- endif %}
    #rc-{{ sid }} .rc-wrap { width: min(1160px, 100% - 40px); margin: 0 auto; }
    #rc-{{ sid }} .rc-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
    #rc-{{ sid }} .rc-title { margin: 0 0 6px; font-family: var(--font-display); font-size: clamp(28px, 3.6vw, 42px); font-weight: 800; line-height: 1.08; letter-spacing: -.02em; color: inherit; }
    #rc-{{ sid }} .rc-sub { margin: 0; font-family: var(--font-body); color: var(--rc-muted); }
    #rc-{{ sid }} .rc-badge { display: inline-flex; align-items: center; gap: 8px; margin: 10px 0 0; font-family: var(--font-label); font-size: 13px; color: var(--rc-body); }
    #rc-{{ sid }} .rc-badge .cv-stars { font-size: 16px; }

    #rc-{{ sid }} .rc-nav { display: flex; flex: none; gap: 10px; }
    #rc-{{ sid }} .rc-nav[hidden] { display: none; }
    #rc-{{ sid }} .rc-arrow {
      display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%;
      border: 1.5px solid var(--rc-text); background: transparent; color: var(--rc-text); cursor: pointer;
      transition: background .16s, color .16s, opacity .16s;
    }
    #rc-{{ sid }} .rc-arrow:hover:not(:disabled) { background: var(--rc-text); color: var(--rc-bg); }
    #rc-{{ sid }} .rc-arrow:disabled { opacity: .3; cursor: default; }
    #rc-{{ sid }} .rc-arrow:focus-visible,
    #rc-{{ sid }} .rc-dot:focus-visible,
    #rc-{{ sid }} .rc-track:focus-visible { outline: 3px solid var(--focus-ring, #4E7C7B); outline-offset: 3px; }

    #rc-{{ sid }} .rc-track {
      display: flex; gap: var(--rc-gap); overflow-x: auto; scroll-snap-type: x mandatory;
      scroll-behavior: smooth; scrollbar-width: none; padding: 4px 2px 10px;
      -webkit-overflow-scrolling: touch;
    }
    #rc-{{ sid }} .rc-track::-webkit-scrollbar { display: none; }

    #rc-{{ sid }} .rc-slide {
      flex: 0 0 calc((100% - (var(--rc-per) - 1) * var(--rc-gap)) / var(--rc-per));
      scroll-snap-align: start;
      display: flex; flex-direction: column; gap: 14px; padding: 26px;
      background: var(--rc-card); border: 1px solid var(--rc-line); border-radius: 6px;
      box-shadow: var(--shadow-diecut, 0 2px 5px rgba(51, 35, 26, .16));
    }
    #rc-{{ sid }} .rc-stars { font-size: 17px; line-height: 0; }
    #rc-{{ sid }} blockquote { margin: 0; font-family: var(--font-body); font-size: 15.5px; line-height: 1.65; color: var(--rc-body); overflow-wrap: anywhere; }
    #rc-{{ sid }} blockquote strong { display: block; margin-bottom: 6px; font-family: var(--font-display); font-size: 18px; font-weight: 800; line-height: 1.25; color: var(--rc-text); }

    #rc-{{ sid }} .rc-author { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 14px; border-top: 1px dashed var(--rc-dash); }
    #rc-{{ sid }} .rc-avatar { display: grid; flex: none; place-items: center; width: 42px; height: 42px; overflow: hidden; border-radius: 50%; background: var(--rc-accent); color: var(--cream-50, #fff); font-family: var(--font-display); font-weight: 800; }
    #rc-{{ sid }} .rc-avatar img { width: 100%; height: 100%; object-fit: cover; }
    #rc-{{ sid }} .rc-author strong { font-family: var(--font-body); color: var(--rc-text); }
    #rc-{{ sid }} .rc-author small { display: block; margin-top: 2px; font-family: var(--font-label); font-size: 12px; color: var(--rc-muted); }
    #rc-{{ sid }} .rc-product { display: flex; align-items: center; gap: 10px; font-family: var(--font-label); font-size: 12px; color: var(--rc-muted); text-decoration: none; }
    #rc-{{ sid }} .rc-product img { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; }
    #rc-{{ sid }} .rc-product:hover { color: var(--rc-text); }

    #rc-{{ sid }} .rc-dots { display: flex; justify-content: center; gap: 4px; margin-top: 18px; }
    #rc-{{ sid }} .rc-dot { position: relative; width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; }
    #rc-{{ sid }} .rc-dot::before { content: ""; position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; border-radius: 99px; background: var(--rc-line); transform: translate(-50%, -50%); transition: width .25s, background .25s; }
    #rc-{{ sid }} .rc-dot[aria-current="true"]::before { width: 22px; background: var(--rc-text); }

    @media (max-width: 989px) { #rc-{{ sid }} { --rc-per: {{ st.per_view | at_most: 2 }}; } }
    @media (max-width: 649px) {
      #rc-{{ sid }} { --rc-per: 1.12; --rc-gap: 14px; }
      #rc-{{ sid }} .rc-wrap { width: calc(100% - 32px); }
      #rc-{{ sid }} .rc-nav { display: none; }
      #rc-{{ sid }} .rc-slide { padding: 22px; }
    }
    @media (max-width: 420px) { #rc-{{ sid }} .rc-title { font-size: 28px !important; } }
    @media (prefers-reduced-motion: reduce) {
      #rc-{{ sid }} .rc-track { scroll-behavior: auto; }
      #rc-{{ sid }} .rc-dot::before, #rc-{{ sid }} .rc-arrow { transition: none; }
    }
  </style>

  <section id="rc-{{ sid }}" class="rc" aria-roledescription="carousel" aria-label="{{ st.heading | default: 'Reviews' | escape }}"
    data-autoplay="{{ st.autoplay }}" data-speed="{{ st.speed }}">
    <div class="rc-wrap">
      <div class="rc-head">
        <div>
          {%- if st.heading != blank -%}<h2 class="rc-title">{{ st.heading | escape }}</h2>{%- endif -%}
          {%- if st.subheading != blank -%}<p class="rc-sub">{{ st.subheading | escape }}</p>{%- endif -%}
          {%- if st.badge != blank -%}
            <p class="rc-badge">{%- render 'cv-stars', fill: 100 -%}<span>{{ st.badge | escape }}</span></p>
          {%- endif -%}
        </div>
        <div class="rc-nav" data-rc-nav>
          <button type="button" class="rc-arrow" data-rc-prev aria-label="Previous reviews">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" class="rc-arrow" data-rc-next aria-label="Next reviews">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="rc-track" data-rc-track tabindex="0" role="region" aria-label="{{ st.heading | default: 'Reviews' | escape }}: use the arrow keys to scroll">
        {%- assign slide_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.author == blank or block.settings.text == blank -%}{%- continue -%}{%- endif -%}
          {%- assign slide_index = slide_index | plus: 1 -%}
          {%- assign fill = block.settings.rating | times: 20 -%}
          <article class="rc-slide" role="group" aria-roledescription="slide" aria-label="{{ slide_index }} of {{ review_count }}" {{ block.shopify_attributes }}>
            <span class="rc-stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">{%- render 'cv-stars', fill: fill -%}</span>

            <blockquote>
              {%- if block.settings.title != blank -%}<strong>{{ block.settings.title | escape }}</strong>{%- endif -%}
              {{ block.settings.text | escape | newline_to_br }}
            </blockquote>

            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              <a class="rc-product" href="{{ p.url }}">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                <span>{{ st.product_label | default: 'Bought:' | escape }} {{ p.title | escape }}</span>
              </a>
            {%- endif -%}

            <div class="rc-author">
              <span class="rc-avatar" aria-hidden="true">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {{ block.settings.author | slice: 0 | upcase | escape }}
                {%- endif -%}
              </span>
              <div>
                <strong>{{ block.settings.author | escape }}</strong>
                {%- if block.settings.meta != blank -%}<small>{{ block.settings.meta | escape }}</small>{%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="rc-dots" data-rc-dots></div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('rc-{{ sid }}');
      if (!root) return;
      var track = root.querySelector('[data-rc-track]');
      var slides = track.querySelectorAll('.rc-slide');
      var nav = root.querySelector('[data-rc-nav]');
      var prev = root.querySelector('[data-rc-prev]');
      var next = root.querySelector('[data-rc-next]');
      var dotsWrap = root.querySelector('[data-rc-dots]');
      if (!slides.length) return;

      function step() { return slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth; }
      function maxScroll() { return Math.max(0, track.scrollWidth - track.clientWidth); }
      function pages() { return maxScroll() < 4 ? 1 : Math.round(maxScroll() / step()) + 1; }
      function current() { return Math.min(pages() - 1, Math.round(track.scrollLeft / step())); }
      function go(i) { track.scrollTo({ left: Math.max(0, Math.min(i, pages() - 1)) * step() }); }

      function update() {
        var c = current();
        dotsWrap.querySelectorAll('.rc-dot').forEach(function (d, i) { d.setAttribute('aria-current', i === c ? 'true' : 'false'); });
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= maxScroll() - 2;
      }
      function build() {
        var n = pages();
        nav.hidden = n < 2;
        dotsWrap.innerHTML = '';
        if (n >= 2) {
          for (var i = 0; i < n; i++) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'rc-dot';
            b.setAttribute('aria-label', 'Go to slide ' + (i + 1) + ' of ' + n);
            b.addEventListener('click', go.bind(null, i));
            dotsWrap.appendChild(b);
          }
        }
        update();
      }

      prev.addEventListener('click', function () { go(current() - 1); });
      next.addEventListener('click', function () { go(current() + 1); });
      track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
      });
      var resizeTimer;
      window.addEventListener('resize', function () { clearTimeout(resizeTimer); resizeTimer = setTimeout(build, 150); });
      build();

      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var designMode = window.Shopify && Shopify.designMode;
      if (root.dataset.autoplay === 'true' && !reduce && !designMode) {
        var hovered = false;
        var focused = false;
        var touched = false;
        var ms = (parseInt(root.dataset.speed, 10) || 5) * 1000;
        root.addEventListener('mouseenter', function () { hovered = true; });
        root.addEventListener('mouseleave', function () { hovered = false; });
        root.addEventListener('focusin', function () { focused = true; });
        root.addEventListener('focusout', function (e) { if (!root.contains(e.relatedTarget)) focused = false; });
        root.addEventListener('touchstart', function () { touched = true; }, { passive: true });
        setInterval(function () {
          if (hovered || focused || touched || document.hidden || pages() < 2) return;
          if (current() >= pages() - 1) go(0); else go(current() + 1);
        }, ms);
      }

      root.addEventListener('shopify:block:select', function (e) {
        var i = Array.prototype.indexOf.call(slides, e.target);
        if (i > -1) go(i);
      });
    })();
  </script>
{%- elsif request.design_mode -%}
  <div style="padding: 32px 20px; text-align: center; font-family: var(--font-body); color: var(--cocoa-600, #4A3324);">
    Review carousel: add a review block with a name and text to show this section. Type reviews exactly as customers wrote them.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Review carousel",
  "tag": "div",
  "class": "section-review-carousel",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "paragraph", "content": "Hidden until a review block has a name and text." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Don't just take our word for it." },
    { "type": "text", "id": "badge", "label": "Rating badge text", "info": "Optional. Only a rating you can show, e.g. \"Rated 4.8/5 on Google from 1,000+ reviews\". Keep it the same as the ratings under the price." },
    { "type": "text", "id": "product_label", "label": "Product label", "default": "Bought:" },
    { "type": "header", "content": "Carousel" },
    { "type": "range", "id": "per_view", "label": "Reviews visible (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "speed", "label": "Autoplay speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Colors" },
    {
      "type": "select",
      "id": "style",
      "label": "Look",
      "default": "shop",
      "options": [
        { "value": "shop", "label": "Casify shop colours" },
        { "value": "custom", "label": "Custom colours below" }
      ]
    },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#f7f7f5" },
    { "type": "color", "id": "text", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "star", "label": "Stars", "default": "#f5a623", "info": "Not used: stars match the rest of the shop." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Type the review exactly as the customer wrote it." },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "author", "label": "Name" },
        { "type": "text", "id": "meta", "label": "Subtitle", "info": "Optional, e.g. a date. Write \"Verified buyer\" only after finding their order." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" },
        { "type": "product", "id": "product", "label": "Product reviewed (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "Review carousel" }
  ]
}
{% endschema %}
