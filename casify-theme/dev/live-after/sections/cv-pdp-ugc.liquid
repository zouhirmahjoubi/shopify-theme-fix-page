{%- comment -%}
  Casify product page: three short clips, set on the counter.

  Sits directly under the main product section on the Shop Counter template.
  Three 9:16 clips of the case being handled — the snap, the turn in the hand,
  the everyday. They play muted when scrolled into view, pause when they leave,
  and each one has its own play/pause and sound buttons (a clip that plays by
  itself must always be stoppable). Tap a clip to open it large.

  Honest by construction, same rule as cv-pdp-snap and cv-pdp-reel: this is shop
  footage of the product, never a customer review. There is no handle, no star
  rating, no "verified buyer" badge and no performance claim anywhere in this
  section or its schema, so none can be typed in later from the theme editor.

  Each clip falls back cleanly: Shopify-hosted video → external MP4 → a file in
  assets/ → the poster on its own. A clip with only a poster still reads as
  intentional, so the section is safe to ship before the videos are wired up.

  Behaviour: assets/cv-pdp-story.js (the clips module) — works with no GSAP.
  Motion: assets/cv-pdp-home-motion.js.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shown = 0
  for b in section.blocks
    if b.type == 'clip'
      if b.settings.video != blank or b.settings.mp4_url != blank or b.settings.asset != blank or b.settings.poster != blank or b.settings.poster_asset != blank
        assign shown = shown | plus: 1
      endif
    endif
  endfor
-%}

{%- if shown > 0 -%}
  <section class="cvw cvw-ugc" data-cvw-ugc aria-labelledby="cvwUgcTitle-{{ section.id }}">
    <div class="cvp__inner">
      <div class="cvw-head">
        <h2 class="cvp__h2" id="cvwUgcTitle-{{ section.id }}" data-cvw-split>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lede != blank -%}<p class="cvp__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      </div>

      <ol class="cvw-ugc__rail" role="list" data-cvw-ugc-rail style="--n:{{ shown }}">
        {%- assign n = 0 -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'clip' -%}
            {%- liquid
              assign vid = b.settings.video
              assign src = ''
              if b.settings.mp4_url != blank
                assign src = b.settings.mp4_url
              elsif b.settings.asset != blank
                assign src = b.settings.asset | asset_url
              endif

              assign poster_src = ''
              if b.settings.poster != blank
                assign poster_src = b.settings.poster | image_url: width: 720
              elsif vid != blank and vid.preview_image != blank
                assign poster_src = vid.preview_image | image_url: width: 720
              elsif b.settings.poster_asset != blank
                assign poster_src = b.settings.poster_asset | asset_url
              endif

              assign has_video = false
              if vid != blank or src != blank
                assign has_video = true
              endif

              assign label = b.settings.caption | default: product.title
            -%}
            {%- if has_video or poster_src != blank -%}
              {%- assign n = n | plus: 1 -%}
              <li class="cvw-ugc__clip" data-cvw-ugc-clip style="--cv-i:{{ n | minus: 1 }}" {{ b.shopify_attributes }}>
                <div class="cvw-ugc__screen" data-cvw-ugc-screen>
                  {%- if has_video -%}
                    <video class="cvw-ugc__video"
                           data-cvw-ugc-video
                           muted playsinline loop preload="metadata"
                           {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}
                           aria-label="{{ label | escape }}">
                      {%- if vid != blank -%}
                        {%- for source in vid.sources -%}
                          {%- if source.format == 'mp4' -%}
                            <source src="{{ source.url }}" type="{{ source.mime_type }}">
                          {%- endif -%}
                        {%- endfor -%}
                      {%- else -%}
                        <source src="{{ src }}" type="video/mp4">
                      {%- endif -%}
                    </video>
                  {%- elsif poster_src != blank -%}
                    <img class="cvw-ugc__still" src="{{ poster_src }}" alt="{{ label | escape }}"
                         width="405" height="720" loading="lazy" decoding="async">
                  {%- endif -%}

                  <span class="cvw-ugc__glass" aria-hidden="true"></span>

                  {%- if has_video -%}
                    <button type="button" class="cvw-ugc__open" data-cvw-ugc-open
                            aria-label="{{ section.settings.open_label | default: 'Open this clip large' | escape }}: {{ label | escape }}">
                      <span class="cvw-ugc__expand" aria-hidden="true">{%- render 'cv-icon', name: 'expand', size: 15 -%}</span>
                    </button>

                    <div class="cvw-ugc__controls">
                      <button type="button" class="cvw-ugc__btn" data-cvw-ugc-play aria-pressed="false"
                              data-play-label="{{ section.settings.play_label | default: 'Play this clip' | escape }}"
                              data-pause-label="{{ section.settings.pause_label | default: 'Pause this clip' | escape }}"
                              aria-label="{{ section.settings.play_label | default: 'Play this clip' | escape }}">
                        <span class="cvw-ugc__ico is-play" aria-hidden="true">{%- render 'cv-icon', name: 'play', size: 14 -%}</span>
                        <span class="cvw-ugc__ico is-pause" aria-hidden="true">{%- render 'cv-icon', name: 'pause', size: 14 -%}</span>
                      </button>
                    </div>

                    <span class="cvw-ugc__bar" aria-hidden="true"><i data-cvw-ugc-bar></i></span>
                  {%- endif -%}
                </div>

                {%- if b.settings.caption != blank -%}
                  <p class="cvw-ugc__tag"><span>{{ b.settings.caption | escape }}</span></p>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ol>

      <span class="cvw-ugc__counter" aria-hidden="true"></span>

      {%- if section.settings.cta_label != blank -%}
        <div class="cvw-ugc__foot">
          <button type="button" class="cvs__cta cvw-ugc__cta" data-cvp-back><span>{{ section.settings.cta_label | escape }}</span></button>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} One clip, large. Filled and controlled by cv-pdp-story.js. {%- endcomment -%}
    <dialog class="cvw-ugc__dialog" data-cvw-ugc-dialog aria-label="{{ section.settings.heading | escape }}">
      <div class="cvw-ugc__box">
        <div class="cvw-ugc__stage" data-cvw-ugc-stage></div>
        <button type="button" class="cvw-ugc__close" data-cvw-ugc-close aria-label="{{ section.settings.close_label | default: 'Close' | escape }}">
          {%- render 'cv-icon', name: 'close', size: 18 -%}
        </button>
      </div>
    </dialog>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product: clips",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three clips from the counter" },
    { "type": "text", "id": "lede", "label": "Intro", "default": "Short clips of this case being handled: the snap, the turn in your hand, the everyday." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Back to the case", "info": "Scrolls back up to Add to bag. Leave empty to hide." },
    { "type": "header", "content": "Button labels" },
    { "type": "text", "id": "open_label", "label": "Open clip", "default": "Open this clip large" },
    { "type": "text", "id": "play_label", "label": "Play clip", "default": "Play this clip" },
    { "type": "text", "id": "pause_label", "label": "Pause clip", "default": "Pause this clip" },
    { "type": "text", "id": "close_label", "label": "Close", "default": "Close" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Clip",
      "settings": [
        { "type": "header", "content": "Footage", "info": "Shop footage of the product. Never label a clip as a customer video, and do not add a name, a star rating or a claim to the caption — this page states only what the shop can stand behind." },
        { "type": "video", "id": "video", "label": "Uploaded video", "info": "Best option: a Shopify-hosted video. Plays muted in the rail." },
        { "type": "text", "id": "mp4_url", "label": "Video file URL", "info": "A direct .mp4 link, e.g. a file uploaded in Settings → Files." },
        { "type": "text", "id": "asset", "label": "Theme asset file name", "info": "An .mp4 in the theme's assets folder, e.g. pdp-ugc-snap-on.mp4. Used when the two above are empty." },
        { "type": "header", "content": "Poster" },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown before the clip plays, and on its own if there is no video yet." },
        { "type": "text", "id": "poster_asset", "label": "Poster file name in assets", "info": "e.g. pdp-ugc-in-hand-poster.webp. Used when no poster is uploaded." },
        { "type": "header", "content": "Caption" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "In the hand", "info": "What the clip shows — a few words, no claim." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product: clips",
      "blocks": [
        { "type": "clip", "settings": { "asset": "pdp-ugc-snap-on.mp4", "poster_asset": "pdp-ugc-snap-on-poster.webp", "caption": "Snapping it on" } },
        { "type": "clip", "settings": { "asset": "pdp-ugc-in-hand.mp4", "poster_asset": "pdp-ugc-in-hand-poster.webp", "caption": "In the hand" } },
        { "type": "clip", "settings": { "asset": "pdp-ugc-on-table.mp4", "poster_asset": "pdp-ugc-on-table-poster.webp", "caption": "On the table" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
