{%- comment -%}
  Casify — Halo closer (final CTA banner).

  Shared across every product template (default, Halo, Convert), so the
  reveal/stagger/parallax here run on the universal cv-motion engine rather
  than halo.js's reveal observer — that observer only activates on pages
  carrying the `.halo-tpl` body class, which the Convert template doesn't
  have, and would otherwise leave this section's text stuck invisible there.
  The CTA looks up whichever buybox id is actually on the page (`haloPdp` on
  the default/Halo templates, `cvPdp` on Convert) instead of assuming one.
{%- endcomment -%}
<section class="halo-closer" id="halo-promise" data-cv-stagger>
  <span class="halo-closer__glow" aria-hidden="true" data-cv-parallax="0.05"></span>
  <h2 data-cv-reveal>{{ section.settings.heading | default: "Buy the case. If it fails, we pay for the screen." }}</h2>
  <p data-cv-reveal>{{ section.settings.subheading | default: "Twelve feet, 1,400 grams, no yellowing, 90 days to send it back. There isn't much left to think about." }}</p>
  <button class="halo-cta halo-closer__cta" type="button"
          onclick="var t=document.getElementById('haloPdp')||document.getElementById('cvPdp');if(t){t.scrollIntoView({behavior:'smooth',block:'start'});}"
          data-cv-reveal="scale">
    <span class="cv-cta__shine" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
    <span>Pick my model</span>
  </button>
  <span class="tick" data-cv-reveal>{{ section.settings.tick_label | default: 'Free shipping over $45 · ships from Austin, TX' }}</span>
</section>

{% schema %}
{
  "name": "Halo — Closer",
  "settings": [
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "Buy the case. If it fails, we pay for the screen." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Twelve feet, 1,400 grams, no yellowing, 90 days to send it back. There isn't much left to think about." },
    { "type": "text",     "id": "tick_label", "label": "Tick line",  "default": "Free shipping over $45 · ships from Austin, TX" }
  ],
  "presets": [{ "name": "Halo — Closer" }]
}
{% endschema %}
