{%- comment -%}
  Bundle upsell — buybox edition.
  Same building blocks, classes and tokens as the PDP buybox
  (.halo-buy / .halo-rating / .halo-price-row / .halo-cta) so every animation,
  font, color, stamp, ticket border and AJAX-add-to-cart behaviour is shared.
  Each block is a full "buy box" — rating, italic sub, price + compare + SAVE,
  qty stepper, primary red CTA and live-stock dot — instead of the simpler
  card used in sections/bundle.liquid.
{%- endcomment -%}
<section class="bundle-buybox" data-cm-reveal>
  <span class="bundle-buybox__flourish bundle-buybox__flourish--sparkle" aria-hidden="true">{{ 'icon-sparkle.svg' | inline_asset_content }}</span>
  <span class="bundle-buybox__flourish bundle-buybox__flourish--ribbon" aria-hidden="true">{{ 'icon-ribbon.svg' | inline_asset_content }}</span>
  <h2 class="cm-section-title"><small>{{ section.settings.eyebrow | default: 'Pair it with' }}</small>{{ section.settings.heading | default: 'Complete the set' }}</h2>

  <img class="bundle-buybox__cart-badge" src="{{ 'badge-add-to-cart.png' | asset_url }}" alt="" width="320" height="107" loading="lazy" aria-hidden="true">

  <div class="bundle-buybox__grid cm-stagger-cm">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tone      = block.settings.tone | default: 'red'
        assign card_pid  = block.settings.product
        assign card_var  = card_pid.selected_or_first_available_variant | default: card_pid.first_available_variant
        assign card_real = false
        if card_pid != blank and card_var != blank
          assign card_real = true
        endif
        assign price_now  = card_var.price            | default: block.settings.price
        assign price_was  = card_var.compare_at_price | default: block.settings.compare
        assign save_pct   = 0
        if price_was != blank and price_was != 0 and price_now != blank
          assign save_pct = price_was | minus: price_now | times: 100 | divided_by: price_was
        endif
      -%}
      <article class="bundle-buybox__card halo-buy{% if save_pct > 0 %} bundle-buybox__card--sale{% endif %}" {{ block.shopify_attributes }} data-shop-card>

        {%- if block.settings.badge != blank -%}
          <span class="cm-stamp bundle-buybox__stamp bundle-buybox__stamp--{{ tone }}">{%- render 'cv-icon', name: 'price-tag', size: 11 -%}{{ block.settings.badge }}</span>
        {%- endif -%}

        {%- if block.settings.rating != blank -%}
          <div class="halo-rating">
            <span class="halo-stars">
              {%- for s in (1..block.settings.rating) -%}&#9733;{%- endfor -%}
              {%- assign empty_stars = 5 | minus: block.settings.rating -%}
              {%- for s in (1..empty_stars) -%}<span style="opacity:.25">&#9733;</span>{%- endfor -%}
            </span>
            {%- if block.settings.review_count != blank -%}
              <a href="#">{{ block.settings.review_count }} reviews</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        <h3 class="halo-title" style="font-size:22px;line-height:1.1">{{ block.settings.title }}</h3>
        {%- if block.settings.body != blank -%}
          <p class="halo-sub" style="max-width:none">{{ block.settings.body }}</p>
        {%- endif -%}

        <div class="halo-price-row">
          {%- if card_real -%}
            <span class="halo-price-now">{{ price_now | money }}</span>
            {%- if price_was and price_was > price_now -%}
              <span class="halo-price-was">{{ price_was | money }}</span>
              <span class="halo-price-off">Save {{ save_pct }}%</span>
            {%- endif -%}
          {%- else -%}
            <span class="halo-price-now">${{ price_now }}</span>
            {%- if price_was != blank -%}
              <span class="halo-price-was">${{ price_was }}</span>
              <span class="halo-price-off">Save {{ save_pct }}%</span>
            {%- endif -%}
          {%- endif -%}
        </div>

        <form method="post" action="{{ routes.cart_add_url }}" data-cart-add-form class="bundle-buybox__form">
          <input type="hidden" name="id" value="{{ card_var.id | default: block.settings.variant_id }}">

          <div class="qty-row">
            <span class="lbl">Qty</span>
            <div class="qty cm-stepper">
              <button type="button" data-qty-decrease aria-label="Decrease quantity">&minus;</button>
              <span class="cm-qty-value" data-qty-value>1</span>
              <input type="hidden" name="quantity" value="1" data-qty-input>
              <button type="button" data-qty-increase aria-label="Increase quantity">+</button>
            </div>
          </div>

          <button type="submit"
                  class="halo-cta {% if tone == 'teal' %}bundle-buybox__cta--teal{% elsif tone == 'ghost' %}bundle-buybox__cta--ghost{% endif %} cm-press">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
              <path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
            </svg>
            Add bundle {% if card_real -%}&middot; {{ price_now | money }}{%- else -%}&middot; ${{ price_now }}{%- endif %}
          </button>

          <p class="halo-cta-sub">
            <span class="halo-dot"></span>
            <b>In stock</b> &middot; ships next business day
          </p>
        </form>

      </article>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Bundle upsell — buy box",
  "tag": "section",
  "class": "section-bundle-buybox",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pair it with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the set" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Bundle buy box",
      "settings": [
        { "type": "text",     "id": "title",        "label": "Title",            "default": "Phone case only" },
        { "type": "textarea", "id": "body",         "label": "Body",             "default": "The Peppermint Cream. MagSafe ready." },
        { "type": "text",     "id": "price",        "label": "Price (fallback)", "default": "34", "info": "Used only when no product is selected." },
        { "type": "text",     "id": "compare",      "label": "Compare price (fallback)" },
        { "type": "text",     "id": "badge",        "label": "Badge (optional)" },
        {
          "type": "select",
          "id": "tone",
          "label": "Stamp + CTA tone",
          "options": [
            { "value": "red",   "label": "Red (default)" },
            { "value": "teal",  "label": "Teal" },
            { "value": "ghost", "label": "Cream ghost" }
          ],
          "default": "red"
        },
        { "type": "range",    "id": "rating",       "label": "Star rating (0-5)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text",     "id": "review_count", "label": "Review count",     "default": "128" },
        { "type": "product",  "id": "product",      "label": "Product (recommended)" },
        { "type": "text",     "id": "variant_id",   "label": "Variant ID (fallback)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bundle upsell — buy box",
      "blocks": [
        { "type": "card", "settings": { "title": "Phone case only",        "body": "The Peppermint Cream. MagSafe ready.", "price": "34", "rating": 5, "review_count": "128", "variant_id": "" } },
        { "type": "card", "settings": { "title": "Case + charging puck",   "body": "Matching cocoa MagSafe charger, 15W.", "price": "58", "compare": "66", "badge": "Most popular", "rating": 5, "review_count": "212", "variant_id": "" } },
        { "type": "card", "settings": { "title": "Case + tin of 12 sweets","body": "Peppermint creams, hand-tied ribbon.", "price": "62", "compare": "70", "tone": "teal", "rating": 5, "review_count": "94",  "variant_id": "" } }
      ]
    }
  ]
}
{% endschema %}