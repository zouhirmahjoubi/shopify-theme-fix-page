{%- comment -%}
  Casify product page: "Complete the set".
  Real products from Shopify's product recommendations: complementary products
  first (chosen in the Search & Discovery app), otherwise related ones. The first
  render is empty; assets/cv-pdp-story.js fetches this section from the
  recommendations endpoint and swaps the filled version in. With nothing to
  suggest the section stays hidden.
  One tap adds a product only when the exact variant is known: a product with a
  single variant, or the variant made for the phone model chosen in the buy box.
  Otherwise the card links to the product so the model is picked there.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-extras.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit
  assign filled = false
  if recommendations.performed? and recommendations.products_count > 0
    assign filled = true
  endif
-%}

<section class="cvp cvp-set{% if filled %} is-filled{% endif %}" data-cvp-set
         data-url-complementary="{{ rec_url }}&intent=complementary"
         data-url-related="{{ rec_url }}&intent=related"
         data-add-label="{{ section.settings.add_label | escape }}"
         data-adding-label="Adding…"
         data-added-label="{{ section.settings.added_label | escape }}"
         data-retry-label="Try again"
         data-fit-label="{{ section.settings.fit_label | escape }}"
         aria-labelledby="cvpSetTitle-{{ section.id }}">
  {%- if filled -%}
    {%- liquid
      assign heading = section.settings.heading
      if recommendations.intent == 'related'
        assign heading = section.settings.heading_related
      endif
    -%}
    <div class="cvp__inner">
      <div class="cvp-set__head">
        <h2 class="cvp__h2" id="cvpSetTitle-{{ section.id }}">{{ heading | escape }}</h2>
        {%- if section.settings.lede != blank -%}<p class="cvp__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      </div>
      <ul class="cvp-set__row" role="list">
        {%- for item in recommendations.products -%}
          {%- if item.id != product.id and item.available -%}
            <li class="cvp-set__item" data-cvp-set-item>
              <a class="cvp-set__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.featured_image -%}
                  {{ item.featured_image | image_url: width: 360 | image_tag: widths: '180, 270, 360', sizes: '180px', loading: 'lazy', alt: '' }}
                {%- endif -%}
              </a>
              <div class="cvp-set__body">
                <a class="cvp-set__title" href="{{ item.url }}">{{ item.title | escape }}</a>
                <span class="cvp-set__price">{% if item.price_varies %}From {% endif %}{{ item.price_min | money }}
                  {%- if item.compare_at_price_min > item.price_min %} <s class="cvp-set__was"><span class="cvp-set__vh">{{ 'products.price_offer.compare_at' | t }}: </span>{{ item.compare_at_price_min | money }}</s>{%- endif -%}
                </span>
                <p class="cvp-set__fit" data-cvp-set-fit hidden></p>
                <script type="application/json" data-cvp-set-variants>[{%- for v in item.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
                <button type="button" class="cvp-set__add" data-cvp-set-add hidden>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  <span data-cvp-set-label>{{ section.settings.add_label | escape }}</span>
                </button>
                <a class="cvp-set__choose" href="{{ item.url }}" data-cvp-set-choose>{{ section.settings.choose_label | escape }}</a>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product: complete the set",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the set", "info": "Shown for complementary products, which you choose in the Search & Discovery app." },
    { "type": "text", "id": "heading_related", "label": "Heading for related products", "default": "Add another case", "info": "Shown when a product has no complementary products and related ones fill in." },
    { "type": "text", "id": "lede", "label": "Intro" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add" },
    { "type": "text", "id": "added_label", "label": "Added state", "default": "In your bag" },
    { "type": "text", "id": "fit_label", "label": "Model note", "default": "For your [model]", "info": "[model] is the phone chosen in the buy box." },
    { "type": "text", "id": "choose_label", "label": "Link when a model must be chosen", "default": "Choose your model" }
  ],
  "presets": [{ "name": "Product: complete the set" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
