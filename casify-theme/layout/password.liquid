<!doctype html>
{%- comment -%}
  Casify: the layout for the password page, used only while the store is locked
  (Online Store > Preferences > Password protection). Brand fonts, theme.css and the
  shop sign's styles, no header, cart or motion scripts. html stays no-js, so the
  reveal start states in theme.css never hide anything here.
{%- endcomment -%}
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'casify-logo-mark.png' | asset_url }}">
    {%- endif -%}
    {%- render 'cv-fonts' -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'cv-header.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
