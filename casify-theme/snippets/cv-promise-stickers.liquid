{%- doc -%}
  Casify: promise stickers beside the collection sign (sections/cv-collection.liquid).

  Three die-cut stickers, one per promise, each with a small character:
    1  a toaster-style printer that pops up a freshly printed case, with a little flag
    2  a parcel that gets bumped and cracked, then swapped for a brand-new one
    3  a delivery van that drives off and comes back round
  Motion (motion.dev): the stickers slap onto the page, lift on hover and squish on tap.
  GSAP: each character acts out its promise, blinks, and with a mouse its eyes follow
  the pointer. Behaviour: assets/cv-promise-stickers.js. Styles: assets/cv-promise-stickers.css.
  Reduced motion or no script: the stickers sit still, each character in its finished pose.

  The characters stay with their position: sticker 1 is the printer, 2 the parcel, 3 the van.

  @param {string} sid - section id, keeps the SVG clip ids unique
  @param {string} [heading] - small heading over the stickers
  @param {string} [p1] - printer sticker text
  @param {string} [p2] - parcel sticker text
  @param {string} [p3] - van sticker text
  @param {boolean} [row] - true when nothing sits beside them: one row on wide screens
{%- enddoc -%}
{{ 'cv-promise-stickers.css' | asset_url | stylesheet_tag }}
<script>
  /* Hide the stickers until cv-promise-stickers.js has set their start state, so they
     don't flash in place first. Never under reduced motion, never for more than 1.5 s. */
  (function (root) {
    if (!window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('cvsk-pending');
    setTimeout(function () { root.classList.remove('cvsk-pending'); }, 1500);
  })(document.documentElement);
</script>
{%- liquid
  assign star = 'M0-5C.7-1.3 1.3-.7 5 0 1.3.7.7 1.3 0 5-.7 1.3-1.3.7-5 0-1.3-.7-.7-1.3 0-5Z'
-%}
<aside class="cvsk{% if row %} cvsk--row{% endif %}" data-cv-stickers data-motion-dev="stickers"
  {%- if heading != blank %} aria-labelledby="cvskTitle-{{ sid }}"{% else %} aria-label="Our promises"{% endif %}>
  {%- if heading != blank -%}
    <h2 class="cvsk__title" id="cvskTitle-{{ sid }}">{{ heading | escape }}</h2>
  {%- endif -%}
  <ul class="cvsk__list" role="list">
    {%- if p1 != blank -%}
    <li class="cvsk__item cvsk__item--print" data-cvsk-item="print">
      <span class="cvsk__badge">
        <svg class="cvsk__art" viewBox="0 0 80 80" width="80" height="80" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="cvskPa-{{ sid }}"><circle cx="40" cy="40" r="37"/></clipPath>
            <clipPath id="cvskPb-{{ sid }}"><rect x="30" y="9" width="20" height="28" rx="5"/></clipPath>
          </defs>
          <g clip-path="url(#cvskPa-{{ sid }})">
            <ellipse class="sk-shade" cx="40" cy="67" rx="24" ry="3"/>
            <g data-sk="case">
              <rect class="sk-red" x="30" y="9" width="20" height="28" rx="5"/>
              <path class="sk-cream" clip-path="url(#cvskPb-{{ sid }})" d="M30 11.5 50-.5V4L30 16Zm0 9 20-12V13L30 25Zm0 9 20-12V22L30 34Zm0 9 20-12V31L30 43Z"/>
              <rect class="sk-none sk-ink" x="30" y="9" width="20" height="28" rx="5"/>
              <rect class="sk-cocoa" x="33" y="12" width="7.6" height="8.6" rx="2.6"/>
              <circle class="sk-cream" cx="36.8" cy="16.3" r="1.5"/>
            </g>
            <g data-sk="lever"><rect class="sk-gold sk-thin" x="9.4" y="41.5" width="7" height="4.6" rx="1.6"/></g>
            <rect class="sk-cocoa" x="21" y="61.5" width="8" height="5" rx="2"/>
            <rect class="sk-cocoa" x="51" y="61.5" width="8" height="5" rx="2"/>
            <g data-sk="body">
              <rect class="sk-teal sk-ink" x="15" y="35" width="50" height="29" rx="10"/>
              <rect class="sk-cocoa" x="27" y="33.3" width="26" height="4.4" rx="2.2"/>
              <path class="sk-gloss" d="M20.6 47v-2.4a5.4 5.4 0 0 1 5.4-5.4h3"/>
              <circle data-sk="light" class="sk-red sk-thin" cx="58.6" cy="58" r="1.7"/>
              <g data-sk-eye><g data-sk-lid><ellipse class="sk-cocoa" cx="32" cy="47.5" rx="2.7" ry="3.3"/><circle class="sk-cream" cx="31.1" cy="46.2" r=".95"/></g></g>
              <g data-sk-eye><g data-sk-lid><ellipse class="sk-cocoa" cx="48" cy="47.5" rx="2.7" ry="3.3"/><circle class="sk-cream" cx="47.1" cy="46.2" r=".95"/></g></g>
              <ellipse class="sk-blush" cx="25.6" cy="53" rx="3.1" ry="1.8"/>
              <ellipse class="sk-blush" cx="54.4" cy="53" rx="3.1" ry="1.8"/>
              <path class="sk-line" d="M37 53.2q3 2.8 6 0"/>
            </g>
            <g data-sk="flag">
              <path class="sk-line" d="M60 36.2V18.4"/>
              <rect class="sk-red" x="60" y="19.4" width="10.6" height="7.8" rx=".9"/>
              <path class="sk-cream" d="M60 22.2h10.6v1.4H60Zm0 2.6h10.6v1.3H60Z"/>
              <rect class="sk-navy" x="60" y="19.4" width="4.8" height="4.3"/>
              <circle class="sk-cream" cx="62.4" cy="21.55" r=".85"/>
              <rect class="sk-none sk-thin" x="60" y="19.4" width="10.6" height="7.8" rx=".9"/>
              <circle class="sk-gold sk-thin" cx="60" cy="17.6" r="1.4"/>
            </g>
            <path data-sk="spark" class="sk-lamp sk-thin sk-off" transform="translate(57 11)" d="{{ star }}"/>
          </g>
        </svg>
      </span>
      <span class="cvsk__text">{{ p1 | escape }}</span>
    </li>
    {%- endif -%}
    {%- if p2 != blank -%}
    <li class="cvsk__item cvsk__item--care" data-cvsk-item="care">
      <span class="cvsk__badge">
        <svg class="cvsk__art" viewBox="0 0 80 80" width="80" height="80" aria-hidden="true" focusable="false">
          <defs><clipPath id="cvskBa-{{ sid }}"><circle cx="40" cy="40" r="37"/></clipPath></defs>
          <g clip-path="url(#cvskBa-{{ sid }})">
            <ellipse class="sk-shade" cx="40" cy="67" rx="23" ry="3"/>
            <g data-sk="swap" class="sk-off">
              <path data-sk="arc" class="sk-arrow" d="M40 13.5A31 31 0 1 1 10.9 33.9"/>
              <path data-sk="head" class="sk-tealdk" d="M12.4 29.4 14.6 35.4 7.2 32.6Z"/>
            </g>
            <g data-sk="box">
              <g data-sk="flip">
                <rect class="sk-kraft sk-ink" x="19" y="33" width="42" height="31" rx="4"/>
                <rect class="sk-gold sk-ink" x="16" y="25.5" width="48" height="10" rx="3"/>
                <rect class="sk-red" x="36" y="26.6" width="8" height="7.8"/>
                <path data-sk="crack" class="sk-line sk-off" d="m17.4 30.6 5.1 3.4-3 3.1 5.2 3.4-2.4 2.8"/>
                <g data-sk-eye><g data-sk-lid><ellipse class="sk-cocoa" cx="32" cy="45.5" rx="2.7" ry="3.3"/><circle class="sk-cream" cx="31.1" cy="44.2" r=".95"/></g></g>
                <g data-sk-eye><g data-sk-lid><ellipse class="sk-cocoa" cx="48" cy="45.5" rx="2.7" ry="3.3"/><circle class="sk-cream" cx="47.1" cy="44.2" r=".95"/></g></g>
                <g data-sk="brows" class="sk-off"><path class="sk-line" d="m28.6 40.6 5.4-1.6m17.4 1.6L46 39"/></g>
                <ellipse class="sk-blush" cx="25.6" cy="51" rx="3.1" ry="1.8"/>
                <ellipse class="sk-blush" cx="54.4" cy="51" rx="3.1" ry="1.8"/>
                <path data-sk="smile" class="sk-line" d="M37 51.4q3 2.8 6 0"/>
                <path data-sk="wobble" class="sk-line sk-off" d="M35.5 52.6q1.5-1.6 3 0t3 0 3 0"/>
              </g>
            </g>
            <path data-sk="spark" class="sk-lamp sk-thin sk-off" transform="translate(64 21)" d="{{ star }}"/>
            <path data-sk="spark" class="sk-lamp sk-thin sk-off" transform="translate(15.5 19) scale(.7)" d="{{ star }}"/>
          </g>
        </svg>
      </span>
      <span class="cvsk__text">{{ p2 | escape }}</span>
    </li>
    {%- endif -%}
    {%- if p3 != blank -%}
    <li class="cvsk__item cvsk__item--ship" data-cvsk-item="ship">
      <span class="cvsk__badge">
        <svg class="cvsk__art" viewBox="0 0 80 80" width="80" height="80" aria-hidden="true" focusable="false">
          <defs><clipPath id="cvskVa-{{ sid }}"><circle cx="40" cy="40" r="37"/></clipPath></defs>
          <g clip-path="url(#cvskVa-{{ sid }})">
            <path class="sk-dash" d="M2 70.4h9v2H2Zm18 0h9v2h-9Zm18 0h9v2h-9Zm18 0h9v2h-9Zm18 0h9v2h-9Z"/>
            <circle data-sk="puff" class="sk-puff" cx="9" cy="53" r="2.4"/>
            <circle data-sk="puff" class="sk-puff" cx="7.5" cy="50.6" r="2"/>
            <circle data-sk="puff" class="sk-puff" cx="10" cy="55.4" r="1.8"/>
            <g data-sk="van">
              <ellipse class="sk-shade" cx="40" cy="64.8" rx="27" ry="2.6"/>
              <g data-sk="speed" class="sk-off"><path class="sk-line" d="M1 32.5h6.5M-1 39h7M2 45.5h5"/></g>
              <g data-sk="vbody">
                <g data-sk="roofbox">
                  <rect class="sk-kraft sk-thin" x="20.5" y="19.4" width="13" height="8.6" rx="1.6"/>
                  <rect class="sk-red" x="25.8" y="20.1" width="2.4" height="7.2"/>
                </g>
                <rect class="sk-red sk-ink" x="11" y="27" width="37" height="28" rx="5.5"/>
                <rect class="sk-cream" x="12.1" y="46.2" width="34.8" height="3.4"/>
                <path class="sk-cream sk-ink" d="M46 55V33.5h8.6q3.1 0 4.5 2.8l4.6 8.7q2.4 1 2.4 3.5V55Z"/>
                <path class="sk-glass sk-thin" d="M49.2 36.6h5.1q1.7 0 2.5 1.5l3.4 6.5h-11Z"/>
                <circle class="sk-lamp sk-thin" cx="64.6" cy="49.6" r="1.7"/>
                <rect class="sk-gold sk-thin" x="63.4" y="52.6" width="5.2" height="3" rx="1"/>
                <g data-sk-lid><ellipse class="sk-cream sk-thin" cx="24.2" cy="37" rx="3.7" ry="4.1"/><g data-sk-eye><circle class="sk-cocoa" cx="24.6" cy="37.5" r="2"/><circle class="sk-cream" cx="24" cy="36.8" r=".6"/></g></g>
                <g data-sk-lid><ellipse class="sk-cream sk-thin" cx="34.2" cy="37" rx="3.7" ry="4.1"/><g data-sk-eye><circle class="sk-cocoa" cx="34.6" cy="37.5" r="2"/><circle class="sk-cream" cx="34" cy="36.8" r=".6"/></g></g>
                <ellipse class="sk-blush sk-blush--on-red" cx="18.6" cy="43" rx="2.6" ry="1.5"/>
                <ellipse class="sk-blush sk-blush--on-red" cx="39.8" cy="43" rx="2.6" ry="1.5"/>
                <path class="sk-line" d="M26.7 43.2q2.5 2.4 5 0"/>
              </g>
              <g data-sk="wheel"><circle class="sk-cocoa" cx="22" cy="56.5" r="6.6"/><rect class="sk-cream" x="21.2" y="51.5" width="1.6" height="10" rx=".8"/><circle class="sk-gold" cx="22" cy="56.5" r="2.6"/></g>
              <g data-sk="wheel"><circle class="sk-cocoa" cx="56.5" cy="56.5" r="6.6"/><rect class="sk-cream" x="55.7" y="51.5" width="1.6" height="10" rx=".8"/><circle class="sk-gold" cx="56.5" cy="56.5" r="2.6"/></g>
            </g>
          </g>
        </svg>
      </span>
      <span class="cvsk__text">{{ p3 | escape }}</span>
    </li>
    {%- endif -%}
  </ul>
</aside>
<script src="{{ 'cv-promise-stickers.js' | asset_url }}" defer></script>
