{%- comment -%}
  Casify: mix-and-match packs, shared by both product templates.

  When a pack of 2 or 3 is chosen, every case in it gets its own colour and
  phone model. Case 1 is the case chosen with the page's own options; each
  extra case follows case 1 until the shopper changes it.

  The store's automatic pack discounts need only a minimum quantity of cases
  in the bag and apply to every item, so a mixed pack gets exactly the price a
  matched pack gets. The percentages are never typed here: the tier blocks and
  cv-product.js read settings.cv_pack_2_pct / settings.cv_pack_3_pct.

  Params:
    product     the product
    model_oi    index of the phone-model option, -1 when there is none
    max_qty     the largest pack on the page
    active_qty  the pack chosen when the page loads
    look        'slip' (The Order Slip) or 'counter' (The Shop Counter)
    sid         section id, for unique ids
    heading     legend, [qty] is filled in
    hint        one line under the legend
    same_label  the link that puts a case back to case 1's choice
    first_note  the note beside case 1

  Behaviour: assets/cv-product.js (slots, cvs:slots-before / cvs:slots).
  Motion: assets/cv-pack-motion.js (Flip re-flow, lid pop, photo drop; per
  root, re-init on shopify:section:load, reverted on unload, nothing under
  reduced motion). No-JS and reduced motion: the boxes print open with the
  photo showing and no lid; the rows are plain selects.
  Styles: assets/cv-pack-slots.css. The box front and lid are KIE plates.
{%- endcomment -%}
{%- liquid
  assign cvar = product.selected_or_first_available_variant
  assign choice_order = ''
  for option in product.options_with_values
    if forloop.index0 != model_oi and option.values.size > 1
      assign choice_order = choice_order | append: forloop.index0 | append: ','
    endif
  endfor
  if model_oi >= 0 and product.options_with_values[model_oi].values.size > 1
    assign choice_order = choice_order | append: model_oi
  endif
  assign choices = choice_order | split: ','
  assign pic = cvar.featured_image | default: product.featured_image
  assign legend = heading | default: 'Your [qty] cases' | replace: '[qty]', active_qty
  comment
    Case 1 summary: the phone model is left out while it waits on the placeholder (more than one
    model value), so no model reads as chosen before the shopper picks one; cv-product.js fills it in.
  endcomment
  assign first_summary = ''
  for c in choices
    assign oi = c | plus: 0
    if oi == model_oi and product.options_with_values[oi].values.size > 1
      continue
    endif
    if first_summary != ''
      assign first_summary = first_summary | append: ' · '
    endif
    assign first_summary = first_summary | append: cvar.options[oi]
  endfor
-%}
{%- if choices.size > 0 and max_qty > 1 -%}
{{ 'cv-pack-slots.css' | asset_url | stylesheet_tag }}
<div class="cvpk cvpk--{{ look }}" data-cv-slots{% if active_qty < 2 %} hidden{% endif %}
     data-fallback-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 240 }}{% endif %}"
     data-template-legend="{{ heading | default: 'Your [qty] cases' | escape }}"
     data-template-bad="Case [n] is sold out in that choice"
     data-sold-suffix=" ({{ 'products.buy.sold_out' | t | downcase | escape }})" data-missing-suffix=" ({{ 'products.buy.unavailable' | t | downcase | escape }})">
  <div class="cvpk__tray" aria-hidden="true">
    <ul class="cvpk__cases" data-cv-slots-tray>
      {%- for i in (1..max_qty) -%}
        <li class="cvpk__case" data-cv-slot-case="{{ forloop.index0 }}"{% if forloop.index > active_qty %} hidden{% endif %}>
          <span class="cvpk__photo" data-cv-slot-photo>
            {%- if pic -%}
              <img src="{{ pic | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy" data-cv-slot-img>
            {%- else -%}
              <img alt="" width="120" height="120" loading="lazy" data-cv-slot-img hidden>
            {%- endif -%}
            <span class="cvpk__num">{{ forloop.index }}</span>
          </span>
          <img class="cvpk__front" src="{{ 'pack-box-wall.webp' | asset_url }}" alt="" width="860" height="313" loading="lazy">
          <img class="cvpk__lid" src="{{ 'pack-box-lid.webp' | asset_url }}" alt="" width="520" height="313" loading="lazy" data-cv-slot-lid>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <fieldset class="cvpk__rows">
    <legend class="cvpk__legend" data-cv-slots-legend>{{ legend | escape }}</legend>
    {%- if hint != blank -%}<p class="cvpk__hint">{{ hint | escape }}</p>{%- endif -%}

    {%- for i in (1..max_qty) -%}
      {%- assign si = forloop.index0 -%}
      {%- assign case_n = forloop.index -%}
      <div class="cvpk__row" data-cv-slot="{{ si }}"{% if forloop.index > active_qty %} hidden{% endif %}>
        <span class="cvpk__name" id="cvpkName{{ si }}-{{ sid }}">Case {{ forloop.index }}</span>
        {%- if si == 0 -%}
          <p class="cvpk__first">
            <span data-cv-slot-summary>{{ first_summary | escape }}</span>
            {%- if first_note != blank -%}<small>{{ first_note | escape }}</small>{%- endif -%}
          </p>
        {%- else -%}
          <div class="cvpk__fields" role="group" aria-labelledby="cvpkName{{ si }}-{{ sid }}">
            {%- for c in choices -%}
              {%- assign oi = c | plus: 0 -%}
              {%- assign option = product.options_with_values[oi] -%}
              <span class="cvpk__select">
                {%- liquid
                  comment
                    A phone model is never pre-selected: with more than one model the select starts on the
                    placeholder; cv-product.js sets the model once the shopper confirms one (it skips value "").
                  endcomment
                  assign model_ph = false
                  if oi == model_oi and option.values.size > 1
                    assign model_ph = true
                  endif
                -%}
                <select data-cv-slot-option="{{ oi }}" aria-label="Case {{ case_n }}: {{ option.name | escape }}">
                  {%- if model_ph -%}<option value="" data-cv-placeholder selected>{{ 'products.buy.model_placeholder' | t }}</option>{%- endif -%}
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% unless model_ph %}{% if cvar.options[oi] == value %} selected{% endif %}{% endunless %}>{{ value | escape }}</option>
                  {%- endfor -%}
                </select>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            {%- endfor -%}
          </div>
          <button type="button" class="cvpk__same" data-cv-slot-same hidden>{{ same_label | default: 'Same as case 1' | escape }}</button>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>
{%- endif -%}
