{%- comment -%}
  One case-feature icon (snippets/cv-case-features.liquid). Ink outlines in currentColor,
  fills from the classes in cv-case-features.css. This is the still picture: with motion
  and WebGL, assets/cv-case-features.js draws a three.js scene over it and hides it.
  Strokes marked data-cvcf-draw are drawn on when there is no 3D.

  Usage: {% render 'cv-case-feature-icon', icon: 'drop' %}
  Icons: drop, layers, magsafe, finish, button, stand, fit
{%- endcomment -%}
<svg class="cvcf-ic cvcf-ic--{{ icon }}" viewBox="0 0 64 52" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  {%- case icon -%}
    {%- when 'layers' -%}
      <rect class="cvcf-ic__teal" x="16" y="6" width="22" height="38" rx="5.5" transform="rotate(-9 27 25)"/>
      <rect class="cvcf-ic__pink" x="25" y="8" width="22" height="38" rx="5.5" transform="rotate(7 36 27)"/>
      <rect x="28.6" y="11.6" width="14.8" height="30.8" rx="3" stroke-width="1.3" stroke-dasharray="2.4 2.6" transform="rotate(7 36 27)"/>
    {%- when 'magsafe' -%}
      <path d="M32 37v10" data-cvcf-draw/>
      <circle class="cvcf-ic__paper" cx="32" cy="22" r="15"/>
      <circle cx="32" cy="22" r="10" class="cvcf-ic__ring" stroke-width="2.6" data-cvcf-draw/>
      <path class="cvcf-ic__red" d="M34.2 13.5 27 23.6h4.6L29.8 30.6l7.2-10.2h-4.7Z"/>
    {%- when 'finish' -%}
      <path class="cvcf-ic__paper" d="M32 22 50 31 32 40 14 31Z"/>
      <path class="cvcf-ic__teal" d="M32 15 50 24 32 33 14 24Z"/>
      <path class="cvcf-ic__pink" d="M32 8 50 17 32 26 14 17Z"/>
      <path d="M24 15.5 33 11" stroke-width="1.4" data-cvcf-draw/>
      <path class="cvcf-ic__gold" stroke-width="1.2" d="M54 4.5c.5 2.2 1.3 3 3.5 3.5-2.2.5-3 1.3-3.5 3.5-.5-2.2-1.3-3-3.5-3.5 2.2-.5 3-1.3 3.5-3.5Z"/>
      <path class="cvcf-ic__gold" stroke-width="1.2" d="M9 31.5c.4 1.7 1 2.3 2.7 2.7-1.7.4-2.3 1-2.7 2.7-.4-1.7-1-2.3-2.7-2.7 1.7-.4 2.3-1 2.7-2.7Z"/>
      <path class="cvcf-ic__gold" stroke-width="1.2" d="M54 36c.4 1.5.9 2 2.4 2.4-1.5.4-2 .9-2.4 2.4-.4-1.5-.9-2-2.4-2.4 1.5-.4 2-.9 2.4-2.4Z"/>
    {%- when 'button' -%}
      <rect class="cvcf-ic__pink" x="24" y="3" width="14" height="46" rx="7"/>
      <rect class="cvcf-ic__paper" x="28" y="15" width="6" height="18" rx="3"/>
      <path d="M43 18.5c1.6 1.5 1.6 9.5 0 11M47 15.5c3 3 3 14 0 17" data-cvcf-draw/>
    {%- when 'stand' -%}
      <path d="M8 47h48" data-cvcf-draw/>
      <path class="cvcf-ic__gold-line" d="M33.5 26 45 46.5" stroke-width="3.2"/>
      <rect class="cvcf-ic__pink" x="15" y="5" width="16" height="40" rx="4.5" transform="rotate(14 23 45)"/>
      <circle cx="24.5" cy="12.5" r="2.2" transform="rotate(14 23 45)"/>
    {%- when 'fit' -%}
      <rect class="cvcf-ic__paper" x="21" y="6" width="22" height="40" rx="5.5"/>
      <path class="cvcf-ic__stripe" d="M22 17h20M22 24h20M22 31h20M22 38h20" stroke-width="3.2" stroke-linecap="butt"/>
      <rect x="21" y="6" width="22" height="40" rx="5.5"/>
      <path d="M13 9V2h7M51 9V2h-7M13 43v7h7M51 43v7h-7" stroke-width="1.4" data-cvcf-draw/>
    {%- else -%}
      <path d="M8 47h48" data-cvcf-draw/>
      <path d="M17 42.5 13 39M21.5 39.5l-1.4-5M46 42.5l4-3.5M42.5 39.5l1.4-5" stroke-width="1.5" data-cvcf-draw/>
      <g transform="rotate(-30 32 26)">
        <rect class="cvcf-ic__pink" x="23" y="9" width="18" height="32" rx="5"/>
        <rect class="cvcf-ic__ink" x="26.5" y="12.5" width="7" height="7" rx="2"/>
      </g>
  {%- endcase -%}
</svg>
