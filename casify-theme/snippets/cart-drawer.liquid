{%- comment -%}
  Casify: cart drawer. Rendered on every page by layout/theme.liquid and again by
  sections/cv-cart-drawer.liquid for the Section Rendering API. assets/cart.js swaps
  only the aside's inner HTML after a change, so every piece of markup that must
  refresh lives INSIDE the aside; the stylesheet link and the scrim stay outside.

  Hooks for assets/cart.js: data-key / data-qty on each line, data-cart-line-qty,
  data-cart-remove, data-cart-total (kept as one live node across refreshes),
  data-open-on-add (theme setting cv_open_drawer_on_add) and the data-i18n-* strings.
  Motion hooks (assets/cv-commerce-motion.js): data-cvm-line, data-cvm-drawer-foot.
  Pack percentages come from the theme settings cv_pack_2_pct / cv_pack_3_pct only.
  Closed, the aside is inert, so its links and steppers are out of the tab order.
{%- endcomment -%}
{{ 'cv-cart-drawer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign pack2 = settings.cv_pack_2_pct | default: 0
  assign pack3 = settings.cv_pack_3_pct | default: 0
  assign nudge = ''
  if cart.item_count == 1
    if pack2 > 0
      assign nudge = 'general.cart.nudge_two' | t: pct: pack2
    elsif pack3 > 0
      assign nudge = 'general.cart.nudge_three_from_one' | t: pct: pack3
    endif
  elsif cart.item_count == 2 and pack3 > 0
    assign nudge = 'general.cart.nudge_three' | t: pct: pack3
  endif
-%}
<div class="cart-drawer__scrim" id="cm-cart-drawer-scrim" data-cart-drawer-close></div>
<aside class="cart-drawer" id="cm-cart-drawer" aria-label="{{ 'general.cart.title' | t | escape }}" role="dialog" aria-modal="true" aria-hidden="true" inert
  {%- if settings.cv_open_drawer_on_add %} data-open-on-add{% endif %}
  data-i18n-adding="{{ 'general.cart.adding' | t | escape }}"
  data-i18n-added="{{ 'general.cart.added' | t | escape }}"
  data-i18n-add-error="{{ 'general.cart.add_error' | t | escape }}"
  data-i18n-change-error="{{ 'general.cart.change_error' | t | escape }}"
  data-i18n-bag-one="{{ 'general.cart.bag_label_one' | t | escape }}"
  data-i18n-bag-other="{{ 'general.cart.bag_label_other' | t | escape }}">
  <div class="cart-drawer__head">
    <div class="cart-drawer__head-inner">
      <h3>{{ 'general.cart.title' | t }}</h3>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.cart.close' | t | escape }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
  <div class="cart-drawer__body" id="cm-cart-drawer-content">
    {%- if cart.item_count == 0 -%}
      <p class="cart-drawer__empty">{{ 'general.cart.empty' | t }}</p>
      <a class="cart-drawer__empty-link" href="{{ routes.all_products_collection_url }}">{{ 'general.cart.empty_link' | t }}</a>
    {%- else -%}
      {%- for item in cart.items -%}
        {%- comment -%}
          Phone model first (STORE-FACTS 4): the first option whose name says model, phone,
          device, compatible or applicable; else the first option whose value names a phone.
          The merchant's raw value is printed, escaped, never rewritten.
        {%- endcomment -%}
        {%- liquid
          assign phone_index = -1
          for o in item.options_with_values
            assign oname = o.name | downcase
            if oname contains 'model' or oname contains 'phone' or oname contains 'device' or oname contains 'compatib' or oname contains 'applicable'
              assign phone_index = forloop.index0
              break
            endif
          endfor
          if phone_index == -1
            for o in item.options_with_values
              assign oval = o.value | downcase
              if oval contains 'iphone' or oval contains 'galaxy' or oval contains 'samsung' or oval contains 'pixel'
                assign phone_index = forloop.index0
                break
              endif
              assign outer_index = forloop.index0
              assign owords = oval | split: ' '
              for w in owords
                assign w_head = w | slice: 0, 2
                assign w_tail = w | slice: 2
                if w.size == 3 and w_head == 's2' and '0123456789' contains w_tail
                  assign phone_index = outer_index
                endif
              endfor
              if phone_index != -1
                break
              endif
            endfor
          endif
        -%}
        <div class="cart-drawer-item" data-key="{{ item.key | escape }}" data-qty="{{ item.quantity }}" data-cvm-line>
          <a href="{{ item.url }}" class="cart-drawer-item__media" tabindex="-1" aria-hidden="true">
            {%- if item.image != blank -%}
              <img src="{{ item.image | image_url: width: 160 }}" alt="" width="60" height="60" loading="lazy">
            {%- endif -%}
          </a>
          <div class="cart-drawer-item__info">
            <a class="cart-drawer-item__title" href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>
            {%- unless item.product.has_only_default_variant -%}
              {%- if phone_index != -1 -%}
                <p class="cart-drawer-item__opt cart-drawer-item__opt--phone"><span class="cart-drawer-item__opt-name">{{ 'general.cart.phone_label' | t }}:</span> {{ item.options_with_values[phone_index].value | escape }}</p>
              {%- endif -%}
              {%- for o in item.options_with_values -%}
                {%- if forloop.index0 != phone_index -%}
                  <p class="cart-drawer-item__opt"><span class="cart-drawer-item__opt-name">{{ o.name | escape }}:</span> {{ o.value | escape }}</p>
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}
            <p class="cart-drawer-item__price">{{ item.final_line_price | money }}</p>
          </div>
          <div class="cart-drawer-item__controls">
            <div class="cm-stepper">
              <button type="button" data-qty-decrease aria-label="{{ 'general.cart.decrease_label' | t: title: item.product.title }}">-</button>
              <input type="number" inputmode="numeric" data-cart-line-qty="{{ item.key | escape }}" value="{{ item.quantity }}" min="0" aria-label="{{ 'general.cart.quantity_label' | t: title: item.product.title }}">
              <button type="button" data-qty-increase aria-label="{{ 'general.cart.increase_label' | t: title: item.product.title }}">+</button>
            </div>
            <button type="button" class="cart-drawer-item__remove" data-cart-remove="{{ item.key | escape }}" aria-label="{{ 'general.cart.remove_label' | t: title: item.product.title }}">{{ 'general.cart.remove' | t }}</button>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if cart.item_count > 0 -%}
  <div class="cart-drawer__footer" data-cvm-drawer-foot>
    {%- if nudge != '' -%}
      <p class="cart-drawer__nudge" data-cart-nudge>{{ nudge }}</p>
    {%- endif -%}
    <dl class="cart-drawer__rows">
      <div class="cart-drawer__row">
        <dt>{{ 'general.cart.subtotal' | t }}</dt>
        <dd>{{ cart.items_subtotal_price | money }}</dd>
      </div>
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="cart-drawer__row cart-drawer__row--discount" data-cart-discount>
          <dt>{{ discount.title | escape }}</dt>
          <dd>-{{ discount.total_allocated_amount | money }}</dd>
        </div>
      {%- endfor -%}
      <div class="cart-drawer__row cart-drawer__row--total">
        <dt>{{ 'general.cart.total' | t }}</dt>
        <dd data-cart-total data-cents="{{ cart.total_price }}" aria-live="polite">{{ cart.total_price | money }}</dd>
      </div>
    </dl>
    {%- comment -%} "Checkout" goes to checkout; the full bag page (order note, pack savings) stays one link away. {%- endcomment -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout">
      <button type="submit" name="checkout" class="btn btn--block">{{ 'general.cart.checkout' | t }}</button>
    </form>
    <a href="{{ routes.cart_url }}" class="cart-drawer__view">{{ 'general.cart.view_bag' | t }}</a>
  </div>
  {%- endif -%}
</aside>
