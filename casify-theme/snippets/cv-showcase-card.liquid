{% doc %}
  One showcase card (sections/cv-showcase.liquid).

  A card bound to a product fills itself from that product: photo, title,
  price, compare-at price, link, how many phones and colors it comes in, a
  saving, "new" or "sold out" badge, and stars only when a review app has
  written a rating. Copy comes from, in order: the card's block (home
  showcase), snippets/cv-card-copy.liquid (copy written per product), then
  the product's own title, SEO description and tags. Prices always come from
  the product. A card without a product is the old hand-written card.

  Used by the home showcase (sections/cv-showcase.liquid, a link button) and
  the collection grid (sections/cv-collection.liquid, where the button opens
  the quick pick or adds the only variant, like the old product card did).

  @param {object} [item] - Product the card shows.
  @param {boolean} [short_title] - Show the product title only up to "Phone Case" (home row of one edge).
  @param {object} [block] - The section block holding the card's typed copy.
  @param {number} index - Position in the row (0-based), for tones and stagger.
  @param {string} sid - Section id, for unique SVG ids.
  @param {string} cta_label - Button label when the block has none.
  @param {string} sale_badge - Saving badge, "[percent]" is replaced.
  @param {string} new_badge - Badge for products added in the last 30 days.
  @param {string} [wrapper] - Outer element, 'li' (default) or 'article'.
  @param {boolean} [pick] - Button picks the variant (quick pick) or adds to bag instead of linking.
  @param {boolean} [reveal] - Add the theme's scroll reveal to the card.
  @param {string} [jm_map] - Verified Judge.me ratings, built once by the section with snippets/cv-jm-verified.liquid (mode 'map'). Without it the card shows no stars.
{% enddoc %}
{%- liquid
  assign has_block = false
  if block != blank
    assign has_block = true
    assign s = block.settings
  endif
  assign has_item = false
  if item != blank
    assign has_item = true
  endif

  assign tone_i = index | modulo: 3
  case tone_i
    when 0
      assign tone = 'cream'
    when 1
      assign tone = 'teal'
    else
      assign tone = 'dark'
  endcase
  assign button_tone = 'red'
  assign odd = index | modulo: 2
  if odd == 1
    assign button_tone = 'teal'
  endif
  if has_block
    assign tone = s.panel_tone | default: tone
    assign button_tone = s.button_tone | default: button_tone
  endif

  assign title = ''
  assign line = ''
  assign card_image = blank
  assign image_fit = 'cover'
  assign url = routes.all_products_collection_url
  assign label = cta_label
  if has_block
    assign title = s.title
    assign line = s.description
    assign card_image = s.image
    assign image_fit = s.image_fit | default: 'cover'
    if s.button_url != blank
      assign url = s.button_url
    endif
    if s.button_label != blank
      assign label = s.button_label
    endif
  endif

  assign map_title = ''
  assign map_line = ''
  assign map_p1_icon = ''
  assign map_p1_text = ''
  assign map_p2_icon = ''
  assign map_p2_text = ''
  if has_item
    capture copy_raw
      render 'cv-card-copy', handle: item.handle
    endcapture
    assign copy = copy_raw | strip | split: '~|~'
    if copy.size == 6
      assign map_title = copy[0]
      assign map_line = copy[1]
      assign map_p1_icon = copy[2]
      assign map_p1_text = copy[3]
      assign map_p2_icon = copy[4]
      assign map_p2_text = copy[5]
    endif
  endif

  comment
    cv-card-copy.liquid is typed per handle. A line or pill that names a phone family or MagSafe stays
    only when the product's own title, tags or variant titles name it too (G13); otherwise the clause
    is cut from the line and the pill is dropped (with both pills gone, the card reads its pills off
    the product's title and tags below).
  endcomment
  if has_item and copy.size == 6
    assign facts = item.variants | map: 'title' | join: ' '
    assign facts = item.tags | join: ' ' | prepend: ' ' | prepend: item.title | append: ' ' | append: facts | downcase | replace: 'samsung', 'samsung galaxy' | replace: 'galaxy', 'galaxy samsung'
    assign line_l = map_line | downcase
    assign p1_l = map_p1_text | downcase
    assign p2_l = map_p2_text | downcase
    assign claim_words = 'iphone,pixel,galaxy,samsung,magsafe' | split: ','
    for w in claim_words
      unless facts contains w
        if line_l contains w
          assign map_line = '~'
        endif
        if p1_l contains w
          assign map_p1_text = ''
        endif
        if p2_l contains w
          assign map_p2_text = ''
        endif
      endunless
    endfor
    if map_line == '~'
      assign map_line = ''
      assign cut_marks = ', cut for ~ cut for ~, for iPhone~ for iPhone' | split: '~'
      for mark in cut_marks
        assign line_parts = copy[1] | split: mark
        if map_line == blank and line_parts.size > 1
          assign map_line = line_parts.first | append: '.'
        endif
      endfor
    endif
  endif

  if has_item
    if title == blank
      assign title = map_title | default: item.title
      if short_title
        assign title = title | split: ' Phone Case' | first | strip
        assign title_tail = title | slice: -10, 10
        if title_tail == ' Christmas'
          assign title_cut = title.size | minus: 10
          assign title = title | slice: 0, title_cut
        endif
      endif
    endif
    if line == blank
      assign line = map_line
    endif
    if line == blank
      assign line = item.metafields.global.description_tag.value
    endif
    if line == blank
      comment
        Drop the short bold title descriptions open with, and keep words apart: stripping
        <br> and </p> alone would run "Pantry Label" and "A cream..." together.
      endcomment
      assign line_src = item.description | replace: '<br/>', '<br>' | replace: '<br />', '<br>'
      if line_src contains '</strong>'
        assign line_lead = line_src | split: '</strong>' | first
        assign line_lead_text = line_lead | strip_html | strip
        if line_lead_text.size < 70
          assign line_src = line_src | remove_first: line_lead | remove_first: '</strong>'
        endif
      endif
      assign line = line_src | split: '<br><br>' | first | replace: '<br>', ' ' | replace: '</p>', ' ' | strip_html | strip | remove_first: 'Overview' | strip
      assign line = line | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&nbsp;', ' ' | truncatewords: 16, '…'
    endif
    if card_image == blank
      assign card_image = item.featured_media.preview_image | default: item.featured_image
    endif
    assign url = item.url
  endif
  assign image_alt = title
  if has_item
    assign image_alt = item.title
  endif
  if card_image != blank and card_image.alt != blank
    assign image_alt = card_image.alt
  endif

  comment
    Badge: typed text wins; otherwise "new" for 30 days, then the real saving.
  endcomment
  assign badge = ''
  assign badge_tone = 'red'
  assign badge_cls = 'is-ribbon'
  if has_block and s.badge_text != blank
    assign badge = s.badge_text
    assign badge_tone = s.badge_tone
    if s.badge_style == 'pill'
      assign badge_cls = 'is-pill'
    endif
  elsif has_item and item.available == false
    assign badge = 'Sold out'
    assign badge_tone = 'dark'
    assign badge_cls = 'is-pill'
  elsif has_item
    assign now_s = 'now' | date: '%s' | plus: 0
    assign made_s = item.created_at | date: '%s' | plus: 0
    assign age = now_s | minus: made_s
    if age < 2592000 and new_badge != blank
      assign badge = new_badge
      assign badge_tone = 'teal'
      assign badge_cls = 'is-pill'
    elsif item.compare_at_price > item.price and sale_badge != blank
      assign save = item.compare_at_price | minus: item.price | times: 100.0 | divided_by: item.compare_at_price | round
      assign badge = sale_badge | replace: '[percent]', save
    endif
  endif

  comment
    Features: typed pills win; otherwise read them off the product's title and tags.
  endcomment
  assign p1_text = ''
  assign p1_icon = 'check'
  assign p2_text = ''
  assign p2_icon = 'check'
  if has_block and s.pill_1_text != blank or has_block and s.pill_2_text != blank
    assign p1_text = s.pill_1_text
    assign p1_icon = s.pill_1_icon
    assign p2_text = s.pill_2_text
    assign p2_icon = s.pill_2_icon
  elsif map_p1_text != blank or map_p2_text != blank
    assign p1_text = map_p1_text
    assign p1_icon = map_p1_icon
    assign p2_text = map_p2_text
    assign p2_icon = map_p2_icon
  elsif has_item
    assign hay = item.tags | join: ' ' | prepend: ' ' | prepend: item.title | downcase
    if hay contains 'magnet' or hay contains 'magsafe'
      assign p1_text = 'Magnetic'
      assign p1_icon = 'magnet-ring'
    endif
    if hay contains 'stand' or hay contains 'bracket'
      assign p2_text = 'Built-in stand'
    elsif hay contains 'tough' or hay contains 'shockproof' or hay contains 'anti-drop' or hay contains 'impact'
      assign p2_text = 'Drop protection'
      assign p2_icon = 'drop-shield'
    endif
  endif

  comment
    Facts: how many phones and colors, counted from the product's own options.
  endcomment
  assign models = 0
  assign variety = 0
  assign variety_label = 'styles'
  if has_item
    for option in item.options_with_values
      assign oname = option.name | downcase
      assign fv = option.values.first | downcase
      if oname contains 'model' or oname contains 'phone' or oname contains 'device' or fv contains 'iphone' or fv contains 'galaxy' or fv contains 'samsung' or fv contains 'pixel'
        assign models = option.values.size
      elsif option.values.size > 1 and variety == 0
        assign variety = option.values.size
        if oname contains 'colo'
          assign variety_label = 'colors'
        elsif oname contains 'surface' or oname contains 'finish'
          assign variety_label = 'finishes'
        endif
      endif
    endfor
    comment
      Stars: this product's Judge.me reviews (verified buyers and imported), read from the
      section's jm_map ("|handle:rating" once per review).
    endcomment
    assign i_count = 0
    assign i_sum = 0
    assign jm_key = '|' | append: item.handle | append: ':'
    if jm_map contains jm_key
      assign jm_bits = jm_map | split: jm_key
      for bit in jm_bits offset: 1
        assign bit_r = bit | slice: 0 | plus: 0
        assign i_count = i_count | plus: 1
        assign i_sum = i_sum | plus: bit_r
      endfor
    endif
    assign i_avg = 0
    if i_count > 0
      assign i_avg = i_sum | times: 1.0 | divided_by: i_count
    endif
  endif

  comment
    Button: a link on the home showcase; on collections it picks the variant
    (quick pick), adds the only variant, or says sold out.
  endcomment
  assign cta_mode = 'link'
  assign label_short = label
  if pick == true and has_item
    if item.available == false
      assign cta_mode = 'out'
      assign label = 'Sold out'
    elsif item.has_only_default_variant
      assign cta_mode = 'add'
      assign label = 'Add to bag'
      assign label_short = 'Add to bag'
    else
      assign cta_mode = 'pick'
      if models > 0
        assign label = 'Choose your phone'
        assign label_short = 'Choose phone'
      else
        assign label = 'Choose options'
        assign label_short = 'Options'
      endif
    endif
  endif
  if cta_mode == 'out'
    assign label_short = label
  endif
  assign wrap = wrapper | default: 'li'
-%}
<{{ wrap }} class="cvsh-card cvsh-card--{{ tone }}{% if card_image != blank %} cvsh-card--has-image{% endif %}{% if has_item %} cvsh-card--product{% endif %}" data-cvsh-card{% if reveal %} data-cv-reveal{% endif %} style="--i:{{ index }}"{% if has_block %} {{ block.shopify_attributes }}{% endif %}>
  <div class="cvsh-card__stage">
    {%- if has_item -%}
      <a class="cvsh-card__hit" href="{{ url }}" tabindex="-1" aria-hidden="true"></a>
    {%- endif -%}
    <span class="cvsh-card__ring" aria-hidden="true"></span>
    {%- if card_image != blank -%}
      <figure class="cvsh-card__media cvsh-card__media--{{ image_fit }}" data-cvsh-media data-cvm-fly-img>
        {{ card_image | image_url: width: 960 | image_tag:
          class: 'cvsh-card__image',
          loading: 'lazy',
          widths: '320, 480, 640, 800, 960',
          sizes: '(min-width: 1100px) 380px, (min-width: 700px) 46vw, 84vw',
          alt: image_alt
        }}
        <span class="cvsh-card__glass" aria-hidden="true"></span>
      </figure>
    {%- endif -%}
    {%- if badge != blank -%}
      <span class="cvsh-card__badge cvsh-card__badge--{{ badge_tone }} {{ badge_cls }}" data-cvsh-badge>{{ badge | escape }}</span>
    {%- endif -%}

    {%- if card_image == blank and has_block -%}
      <span class="cvsh-card__icon" data-cvsh-fallback-icon>
        {%- render 'cv-icon', name: s.icon, size: 68, animate: true -%}
      </span>
    {%- endif -%}

    {%- if p1_text != blank or p2_text != blank -%}
      <div class="cvsh-card__pills">
        {%- if p1_text != blank -%}
          <span class="cvsh-card__pill">
            {%- render 'cv-icon', name: p1_icon, size: 12 -%}
            {{ p1_text | escape }}
          </span>
        {%- endif -%}
        {%- if p2_text != blank -%}
          <span class="cvsh-card__pill">
            {%- render 'cv-icon', name: p2_icon, size: 12 -%}
            {{ p2_text | escape }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="cvsh-card__body">
    {%- if has_item -%}
      {%- if i_count > 0 -%}
        {%- assign i_pct = i_avg | times: 20.0 | round: 1 -%}
        <div class="cvsh-card__rating">
          {%- render 'cv-stars', fill: i_pct, class: 'cvsh-card__stars' -%}
          <span>{{ i_avg | round: 1 }} <span class="cvsh-sr">out of 5 stars,</span>({{ i_count }})</span>
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- comment -%}
      A hand-typed block review count (s.rating_count) no longer draws five full stars: stars come only
      from a review app's rating and count on the product (G14). The block setting stays in the schema.
    {%- endcomment -%}

    <h3 class="cvsh-card__title">
      {%- if has_item -%}<a href="{{ url }}">{{ title | escape }}</a>{%- else -%}{{ title | escape }}{%- endif -%}
    </h3>
    {%- if line != blank -%}
      <p class="cvsh-card__desc">{{ line | escape }}</p>
    {%- endif -%}
    {%- if models > 0 or variety > 0 -%}
      <p class="cvsh-card__facts">
        {%- if models > 0 -%}<span>{{ models }} {% if models == 1 %}model{% else %}models{% endif %}</span>{%- endif -%}
        {%- if variety > 0 -%}<span>{{ variety }} {{ variety_label }}</span>{%- endif -%}
      </p>
    {%- endif -%}

    <div class="cvsh-card__price" data-cvsh-price>
      {%- if has_item -%}
        <span class="cvsh-card__now">{% if item.price_varies %}<small>From</small> {% endif %}{{ item.price_min | money }}</span>
        {%- if item.compare_at_price > item.price -%}
          <s class="cvsh-card__was"><span class="cvsh-sr">Regular price</span>{{ item.compare_at_price | money }}</s>
        {%- endif -%}
      {%- else -%}
        <span class="cvsh-card__now">{{ s.price | escape }}</span>
        {%- if s.compare_price != blank -%}
          <s class="cvsh-card__was">{{ s.compare_price | escape }}</s>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- capture cta_attrs -%}
      class="cvsh-card__cta cvsh-sign-cta cvsh-sign-cta--{{ button_tone }}" data-cvsh-cta{% if has_item %} aria-label="{{ label | escape }}: {{ title | escape }}"{% endif %}
    {%- endcapture -%}
    {%- case cta_mode -%}
      {%- when 'pick' -%}
        <a href="{{ item.url }}" {{ cta_attrs }} data-cvqp-open data-cvqp-buy-now data-handle="{{ item.handle }}" data-url="{{ item.url }}">
      {%- when 'add' -%}
        <form method="post" action="{{ routes.cart_add_url }}" data-cart-add-form class="cvsh-card__form">
          <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" {{ cta_attrs }} data-cvm-btn>
      {%- when 'out' -%}
        <button type="button" {{ cta_attrs }} disabled>
      {%- else -%}
        <a href="{{ url }}" {{ cta_attrs }}>
    {%- endcase -%}
      <svg class="cvsh-sign-cta__art" viewBox="0 0 320 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs>
          <clipPath id="cvsh-plaque-{{ sid }}-{{ index }}">
            <path d="M22 3h276c10 0 18 8 18 18v18c0 10-8 18-18 18H22C12 57 4 49 4 39V21C4 11 12 3 22 3Z"/>
          </clipPath>
          <pattern id="cvsh-stripe-{{ sid }}-{{ index }}" width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(28)">
            <rect width="9" height="18" class="cvsh-sign-cta__stripe-light"/>
            <rect x="9" width="9" height="18" class="cvsh-sign-cta__stripe-dark"/>
          </pattern>
        </defs>
        <path class="cvsh-sign-cta__base" d="M22 3h276c10 0 18 8 18 18v18c0 10-8 18-18 18H22C12 57 4 49 4 39V21C4 11 12 3 22 3Z"/>
        <g clip-path="url(#cvsh-plaque-{{ sid }}-{{ index }})">
          <rect class="cvsh-sign-cta__stripes" x="4" y="3" width="58" height="54" fill="url(#cvsh-stripe-{{ sid }}-{{ index }})"/>
          <path class="cvsh-sign-cta__shade" d="M4 43c67 6 220 3 312-12v26H4Z"/>
          <path class="cvsh-sign-cta__shine" data-cvsh-cta-shine d="M-48 1h30L4 59h-30Z"/>
        </g>
        <path class="cvsh-sign-cta__trim" d="M22 3h276c10 0 18 8 18 18v18c0 10-8 18-18 18H22C12 57 4 49 4 39V21C4 11 12 3 22 3Z"/>
        <g class="cvsh-sign-cta__mint" data-cvsh-cta-mint transform="translate(31 30)">
          <circle r="15" class="cvsh-sign-cta__mint-rim"/>
          <circle r="11" class="cvsh-sign-cta__mint-paper"/>
          <path class="cvsh-sign-cta__mint-swish" d="M0-10c5 0 9 4 10 8-4-2-8-1-10 2-2-4-2-7 0-10Z"/>
          <path class="cvsh-sign-cta__mint-swish" d="M10 0c0 5-4 9-8 10 2-4 1-8-2-10 4-2 7-2 10 0Z"/>
          <path class="cvsh-sign-cta__mint-swish" d="M0 10c-5 0-9-4-10-8 4 2 8 1 10-2 2 4 2 7 0 10Z"/>
          <path class="cvsh-sign-cta__mint-swish" d="M-10 0c0-5 4-9 8-10-2 4-1 8 2 10-4 2-7 2-10 0Z"/>
          <circle r="2.5" class="cvsh-sign-cta__mint-center"/>
        </g>
      </svg>
      <span class="cvsh-sign-cta__label"{% if cta_mode == 'add' %} data-cvm-label{% endif %}>
        {%- if label_short != label -%}
          <span class="cvsh-sign-cta__long">{{ label | escape }}</span><span class="cvsh-sign-cta__short" aria-hidden="true">{{ label_short | escape }}</span>
        {%- else -%}
          {{ label | escape }}
        {%- endif -%}
      </span>
      <svg class="cvsh-sign-cta__arrow" data-cvsh-cta-arrow viewBox="0 0 28 16" aria-hidden="true" focusable="false">
        <path d="M1 8h23M17 1l7 7-7 7"/>
      </svg>
    {%- case cta_mode -%}
      {%- when 'add' -%}
          </button>
        </form>
      {%- when 'out' -%}
        </button>
      {%- else -%}
        </a>
    {%- endcase -%}
  </div>
</{{ wrap }}>
