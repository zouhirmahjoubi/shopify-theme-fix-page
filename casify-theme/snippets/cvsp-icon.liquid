{% doc %}
Renders the bespoke icon set for the Convert Spotlight shop-window section.

@param {string} name - Icon key: peppermint, designs, bundle, shipping, returns, or sparkle.
@param {number} [size] - Icon size in pixels.
@param {string} [class] - Optional additional class name.

@example
{% render 'cvsp-icon', name: 'designs', size: 24 %}
{% enddoc %}

{%- liquid
  assign icon_size = size | default: 24
  assign icon_class = class | default: ''
-%}

<span class="cvsp-icon {{ icon_class }}" style="--cvsp-icon-size: {{ icon_size }}px" aria-hidden="true">
  {%- case name -%}
    {%- when 'peppermint' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9.5" fill="var(--cream-50)"/>
        <path d="M12 12c-1.2-2.2-1.1-5.2.7-8.9M12 12c2.2-1.2 5.2-1.1 8.9.7M12 12c1.2 2.2 1.1 5.2-.7 8.9M12 12c-2.2 1.2-5.2 1.1-8.9-.7"/>
        <circle cx="12" cy="12" r="2.1" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'designs' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="7.5" y="3" width="9" height="16" rx="2.4" transform="rotate(-8 12 11)" opacity=".45"/>
        <rect x="5.3" y="4.4" width="9" height="16" rx="2.4" transform="rotate(7 9.8 12.4)" opacity=".72"/>
        <rect x="8.4" y="2.7" width="10.3" height="18.6" rx="2.6" fill="var(--cream-50)"/>
        <rect x="10.2" y="4.6" width="3.4" height="3.4" rx="1"/>
        <circle cx="11.1" cy="5.5" r=".35" fill="currentColor" stroke="none"/>
        <circle cx="12.7" cy="7.1" r=".35" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'bundle' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.2 8.4h17.6v11.2H3.2z" fill="var(--cream-50)"/>
        <path d="M2.4 6h19.2v4.1H2.4zM12 6v13.6"/>
        <path d="M12 6S10.7 2.5 8.5 2.5C6.4 2.5 6 5.8 8.3 6M12 6s1.3-3.5 3.5-3.5c2.1 0 2.5 3.3.2 3.5"/>
        <path d="M5.8 13.5h3M15.2 13.5h3" opacity=".55"/>
      </svg>

    {%- when 'shipping' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6.5 5.1h8.2v11H6.5z" fill="var(--cream-50)"/>
        <path d="M14.7 8.5h3.7l2.5 3.1v4.5h-6.2zM6.5 9.1h8.2M10.6 5.1v4"/>
        <circle cx="9" cy="18.1" r="1.7" fill="var(--cream-50)"/>
        <circle cx="18.2" cy="18.1" r="1.7" fill="var(--cream-50)"/>
        <path d="M2.3 7h2.1M1.5 10.2h2.9M2.3 13.4h2.1"/>
      </svg>

    {%- when 'returns' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 7.2V4.4h-2.8"/>
        <path d="M5 5.1a8.5 8.5 0 1 1-1.3 9.2"/>
        <path d="M8.2 8.5h7.6v8H8.2z" fill="var(--cream-50)"/>
        <path d="M10.3 8.5V6.7h3.4v1.8M10.2 12.3l1.3 1.3 2.7-2.8"/>
      </svg>

    {%- when 'sparkle' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2.8l1.7 5.5L19.2 10l-5.5 1.7L12 17.2l-1.7-5.5L4.8 10l5.5-1.7z"/>
        <path d="M18.4 15.8l.8 2.3 2.3.8-2.3.8-.8 2.3-.8-2.3-2.3-.8 2.3-.8z" opacity=".72"/>
      </svg>
  {%- endcase -%}
</span>
