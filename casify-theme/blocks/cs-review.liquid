{%- comment -%}
  Typed-in reviews are no longer shown: every review on the site is a Judge.me
  review (verified buyer or imported) (snippets/cv-jm-verified.liquid, listed by
  sections/review-widget.liquid). The block stays so saved templates still load.
{%- endcomment -%}
{%- if request.design_mode -%}
  <div class="csp-placeholder" {{ block.shopify_attributes }}>Typed-in reviews are no longer shown. Reviews come from verified Judge.me buyers. You can delete this block.</div>
{%- endif -%}

{% schema %}
{
  "name": "Old review (hidden)",
  "settings": [
    { "type": "text", "id": "reviewer_name", "label": "Customer name" },
    { "type": "image_picker", "id": "avatar", "label": "Optional customer photo" },
    { "type": "text", "id": "review_country", "label": "Country", "info": "Optional. Shows \"Reviewed in …\"." },
    { "type": "text", "id": "review_date", "label": "Date or detail" },
    {
      "type": "select",
      "id": "rating",
      "label": "Star rating",
      "options": [
        { "value": "0", "label": "No rating" },
        { "value": "1", "label": "1 star" },
        { "value": "2", "label": "2 stars" },
        { "value": "3", "label": "3 stars" },
        { "value": "4", "label": "4 stars" },
        { "value": "5", "label": "5 stars" }
      ],
      "default": "0"
    },
    { "type": "checkbox", "id": "verified", "label": "Show \"Verified buyer\"", "default": false, "info": "Only turn on after matching this review to a real order in your store." },
    { "type": "text", "id": "review_title", "label": "Review title", "info": "Optional. Use the customer's own headline." },
    { "type": "richtext", "id": "review_text", "label": "Customer review" },
    { "type": "header", "content": "Customer photos" },
    { "type": "image_picker", "id": "review_image", "label": "Photo 1" },
    { "type": "image_picker", "id": "review_image_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "review_image_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "review_image_4", "label": "Photo 4" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "info": "Describe the photos for screen readers." },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo shape",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (9:16)" }
      ],
      "default": "natural"
    }
  ]
}
{% endschema %}
