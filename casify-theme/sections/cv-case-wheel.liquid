{%- comment -%}
  Casify — "Case wheel".

  Real products from one collection sit around a dial, each turned to face out,
  with a needle in the middle. Tap (or hover) a case and the needle swings to
  it while the ticket on the left shows its name and price; tap it again to open
  it. "Spin the wheel" spins the needle a few turns and lands it on a random case;
  every case it passes clicks outward like a prize wheel. With "Spin on its own",
  the wheel does that by itself every few seconds, pausing for shoppers (see the
  setting's note) and with a pause button on the dial.

  Script: assets/cv-case-wheel.js, a module printed below. It runs after the GSAP
  bundle in <head> (deferred scripts and modules keep document order) and fetches
  three.js only when this section is near the screen. The three.js needle is a
  glossy enamel pointer with a peppermint hub that lifts off the dial while it
  spins and drops back with a bounce, its shadow following.

  No WebGL: a CSS needle does the same moves. No JS: the dial and the first
  case's ticket and link still show. Reduced motion: the needle jumps, nothing
  spins or deals in.

  Prices are the product's own; the struck-through price shows only when the
  product has a real compare-at price above its price.
{%- endcomment -%}
{{ 'cv-case-wheel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign coll = st.collection | default: collections.all
  assign limit = st.limit | default: 20
  assign count = 0
  for p in coll.products limit: limit
    if p.featured_image != blank
      assign count = count | plus: 1
    endif
  endfor
-%}

{%- if count > 0 -%}
<section
  class="cvwh{% if st.surface == 'white' %} cvwh--white{% endif %}"
  data-cvwh
  data-autoplay="{{ st.autoplay }}"
  data-hold="{{ st.hold }}"
  style="--cvwh-pad-top: {{ st.pad_top }}px; --cvwh-pad-bottom: {{ st.pad_bottom }}px;"
  {% if st.heading != blank %}aria-labelledby="cvwh-title-{{ section.id }}"{% else %}aria-label="{{ st.ring_label | escape }}"{% endif %}
>
  <div class="cvwh__wrap">
    <div class="cvwh__copy">
      {%- if st.eyebrow != blank -%}<p class="cvwh__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="cvwh__title" id="cvwh-title-{{ section.id }}" data-cvwh-title>{{ st.heading | escape }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="cvwh__text">{{ st.text }}</div>{%- endif -%}

      {%- liquid
        for p in coll.products limit: limit
          if p.featured_image != blank
            assign first = p
            break
          endif
        endfor
        assign first_was = false
        if st.show_compare and first.compare_at_price > first.price
          assign first_was = true
        endif
      -%}
      <div class="cvwh__ticket" data-cvwh-ticket>
        <p class="cvwh__pick-label">
          <span>{{ st.pick_label | escape }}</span>
          <span class="cvwh__count" data-cvwh-count aria-hidden="true">01 / {% if count < 10 %}0{% endif %}{{ count }}</span>
        </p>
        <p class="cvwh__pick-title" aria-live="polite"><a href="{{ first.url }}" data-cvwh-name>{{ first.title | escape }}</a></p>
        <p class="cvwh__price">
          <span class="cvwh__now" data-cvwh-price>{{ first.price | money }}</span>
          <s class="cvwh__was" data-cvwh-was{% unless first_was %} hidden{% endunless %}><span class="cvwh__sr">Was </span><span data-cvwh-was-value>{% if first_was %}{{ first.compare_at_price | money }}{% endif %}</span></s>
        </p>
        <div class="cvwh__actions">
          <a class="cvwh-btn" href="{{ first.url }}" data-cvwh-shop>{{ st.shop_label | escape }}</a>
          {%- if st.spin_label != blank -%}
            <button type="button" class="cvwh-btn cvwh-btn--ghost" data-cvwh-spin hidden>
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
              {{ st.spin_label | escape }}
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="cvwh__stage">
      <div class="cvwh__dial" data-cvwh-dial style="--n: {{ count }};">
        <span class="cvwh__tick cvwh__tick--n" aria-hidden="true"></span>
        <span class="cvwh__tick cvwh__tick--e" aria-hidden="true"></span>
        <span class="cvwh__tick cvwh__tick--s" aria-hidden="true"></span>
        <span class="cvwh__tick cvwh__tick--w" aria-hidden="true"></span>
        <div class="cvwh__plate" aria-hidden="true"></div>

        <ul class="cvwh__ring" role="list" aria-label="{{ st.ring_label | escape }}" data-cvwh-ring>
          {%- assign i = 0 -%}
          {%- for p in coll.products limit: limit -%}
            {%- if p.featured_image == blank -%}{%- continue -%}{%- endif -%}
            <li class="cvwh__slot" style="--i: {{ i }};">
              <button
                type="button"
                class="cvwh__case{% if i == 0 %} is-active{% endif %}"
                data-cvwh-case
                aria-pressed="{% if i == 0 %}true{% else %}false{% endif %}"
                aria-label="{{ p.title | escape }}"
                {% if i != 0 %}tabindex="-1"{% endif %}
              >
                <span class="cvwh__card">
                  {{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '96, 160, 240', sizes: '72px', alt: '' }}
                </span>
              </button>
            </li>
            {%- assign i = i | plus: 1 -%}
          {%- endfor -%}
        </ul>

        <div class="cvwh__needle" data-cvwh-needle aria-hidden="true">
          <span class="cvwh__needle-arm"></span>
          <span class="cvwh__needle-hub"></span>
        </div>
        <div class="cvwh__three" data-cvwh-three aria-hidden="true"></div>

        {%- if st.autoplay -%}
          <button type="button" class="cvwh__auto" data-cvwh-auto data-paused="false" data-pause-label="{{ st.pause_label | escape }}" data-play-label="{{ st.play_label | escape }}" aria-label="{{ st.pause_label | escape }}" hidden>
            <svg class="cvwh__auto-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
            <svg class="cvwh__auto-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-cvwh-items>
    [
      {%- assign sep = '' -%}
      {%- for p in coll.products limit: limit -%}
        {%- if p.featured_image == blank -%}{%- continue -%}{%- endif -%}
        {%- assign was = '' -%}
        {%- if st.show_compare and p.compare_at_price > p.price -%}{%- assign was = p.compare_at_price | money -%}{%- endif -%}
        {{ sep }}{"title": {{ p.title | json }}, "url": {{ p.url | json }}, "price": {{ p.price | money | json }}, "was": {{ was | json }}}
        {%- assign sep = ',' -%}
      {%- endfor -%}
    ]
  </script>
</section>
<script type="module" src="{{ 'cv-case-wheel.js' | asset_url }}"></script>
{%- elsif request.design_mode -%}
  <p class="cvwh-empty">Case wheel: pick a collection with product photos.</p>
{%- endif -%}

{% schema %}
{
  "name": "Case wheel",
  "tag": "div",
  "class": "section-cv-case-wheel",
  "settings": [
    { "type": "paragraph", "content": "Cases from one collection around a dial, with a needle that swings to the case a shopper taps, or spins and picks one for them." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The case wheel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Can't choose? Spin for it." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every case in the shop on one dial. Tap a case to point the needle at it, or spin and let the wheel pick for you.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for every product. Products without a photo are skipped." },
    { "type": "range", "id": "limit", "label": "Cases on the wheel", "min": 8, "max": 32, "step": 1, "default": 20, "info": "Fewer cases means bigger photos, especially on phones." },
    { "type": "header", "content": "Ticket" },
    { "type": "text", "id": "pick_label", "label": "Label above the case name", "default": "The needle's on" },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "Shop this case" },
    { "type": "text", "id": "spin_label", "label": "Spin button", "default": "Spin the wheel", "info": "Leave empty to hide it." },
    { "type": "checkbox", "id": "show_compare", "label": "Show compare-at price", "default": true, "info": "Only when the product's compare-at price is higher than its price." },
    { "type": "text", "id": "ring_label", "label": "Name of the wheel for screen readers", "default": "Cases on the wheel" },
    { "type": "header", "content": "Automatic spin" },
    { "type": "checkbox", "id": "autoplay", "label": "Spin on its own", "default": true, "info": "Spins to a random case, holds, then spins again. Pauses while a shopper hovers over the wheel, moves through it with the keyboard or taps a case, and while it's off screen. A pause button sits on the dial. Off for shoppers who ask their device for reduced motion." },
    { "type": "range", "id": "hold", "label": "Hold on each case", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "text", "id": "pause_label", "label": "Pause button name (screen readers)", "default": "Pause the wheel" },
    { "type": "text", "id": "play_label", "label": "Play button name (screen readers)", "default": "Spin the wheel on its own" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "Paper white" }
      ]
    },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "presets": [
    { "name": "Case wheel" }
  ]
}
{% endschema %}
