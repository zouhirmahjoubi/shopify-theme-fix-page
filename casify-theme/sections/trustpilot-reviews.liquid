{{ 'casify-customer-reviews.css' | asset_url | stylesheet_tag }}
{{ 'casify-trustpilot-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'casify-customer-reviews.js' | asset_url }}" defer></script>

{%- comment -%}
  Every review and the rating summary come from Judge.me through
  snippets/cv-jm-verified.liquid: verified buyers and imported reviews, all review types
  (product reviews and store reviews), newest first. Typed-in "review"
  blocks are no longer shown (they stay in the schema so saved templates
  still load); an @app block still shows the review platform's own widget.
{%- endcomment -%}
{%- capture jm_stats -%}{%- render 'cv-jm-verified', mode: 'stats', scope: 'all' -%}{%- endcapture -%}
{%- capture jm_rows -%}{%- render 'cv-jm-verified', mode: 'rows', scope: 'all', limit: 12 -%}{%- endcapture -%}
{%- liquid
  comment
    Stats (cv-jm-verified): buyers' count and sum first, so gifted cases
    never set the score. Rows: rating, title, text, name, date, case name,
    handle, kind, gift.
  endcomment
  assign stat_parts = jm_stats | split: '␟'
  assign total = stat_parts[0] | plus: 0
  assign score = 0
  assign score_fill = 0
  if total > 0
    assign score = stat_parts[1] | plus: 0 | times: 1.0 | divided_by: total | round: 1
    assign score_fill = score | times: 20
  endif
  assign rows = jm_rows | split: '␞'
  assign review_count = 0
  for rec in rows
    assign f = rec | split: '␟'
    if f.size >= 9
      assign review_count = review_count | plus: 1
    endif
  endfor
  assign app_block_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_block_count = app_block_count | plus: 1
    endif
  endfor
  assign is_carousel = false
  if section.settings.layout == 'carousel' and review_count > 1
    assign is_carousel = true
  endif
  assign profile = section.settings.profile_url
  assign fallback_heading = 'sections.trustpilot_reviews.heading' | t
-%}

{%- if review_count > 0 or app_block_count > 0 or request.design_mode -%}
<section
  class="ccr ccr--{{ section.settings.surface }} cvtp"
  id="cv-trustpilot-{{ section.id }}"
  aria-labelledby="cv-trustpilot-title-{{ section.id }}"
  {% if is_carousel %}data-casify-customer-reviews aria-roledescription="carousel"{% endif %}
>
  <div class="ccr__inner">
    {%- if score > 0 -%}
      {%- capture summary -%}
        <strong class="cvtp__score">{{ 'sections.trustpilot_reviews.score' | t: score: score }}</strong>
        <span class="cvtp__stars" role="img" aria-label="{{ 'sections.trustpilot_reviews.rating' | t: rating: score | escape }}">
          {%- render 'cv-stars', fill: score_fill -%}
        </span>
        <span class="cvtp__source">
          {%- if total > 0 -%}
            {{ 'sections.trustpilot_reviews.total' | t: count: total }}
          {%- else -%}
            {{ 'sections.trustpilot_reviews.on_trustpilot' | t }}
          {%- endif -%}
        </span>
      {%- endcapture -%}
      {%- if profile != blank -%}
        <a class="ccr__summary cvtp__summary" href="{{ profile | escape }}" target="_blank" rel="noopener noreferrer">
          {{ summary }}<span class="cvtp__sr">{{ 'sections.trustpilot_reviews.new_window' | t }}</span>
        </a>
      {%- else -%}
        <div class="ccr__summary cvtp__summary">{{ summary }}</div>
      {%- endif -%}
    {%- endif -%}

    <header class="ccr__header">
      <h2 class="ccr__title" id="cv-trustpilot-title-{{ section.id }}">
        {{ section.settings.heading | default: fallback_heading | escape }}
        {%- if section.settings.accent_text != blank -%}
          <span>{{ section.settings.accent_text | escape }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.intro != blank -%}
        <p class="ccr__description">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    {%- if review_count > 0 -%}
      <div
        class="{% if is_carousel %}ccr__rail{% else %}cvtp__grid{% endif %}"
        id="cv-trustpilot-rail-{{ section.id }}"
        role="list"
        {% if is_carousel %}data-ccr-rail tabindex="0" aria-label="{{ 'sections.trustpilot_reviews.carousel_label' | t | escape }}"{% endif %}
      >
        {%- for rec in rows -%}
          {%- liquid
            assign f = rec | split: '␟'
            if f.size < 9
              continue
            endif
            assign rating = f[0] | plus: 0
            assign rating_fill = rating | times: 20
            assign r_date = f[4] | date: '%B %Y'
          -%}
          <article class="ccr__card cvtp__card" role="listitem" data-ccr-card>
            {%- if rating > 0 -%}
              <span class="cvtp__stars cvtp__stars--card" role="img" aria-label="{{ 'sections.trustpilot_reviews.rating' | t: rating: rating | escape }}">
                {%- render 'cv-stars', fill: rating_fill -%}
              </span>
            {%- endif -%}
            {%- if f[1] != blank -%}
              <h3 class="cvtp__title">{{ f[1] | escape }}</h3>
            {%- endif -%}
            <div class="cvtp__text rte"><p>{{ f[2] | escape | newline_to_br }}</p></div>
            <div class="cvtp__author">
              <span class="cvtp__avatar" aria-hidden="true">{{ f[3] | slice: 0, 1 | upcase | escape }}</span>
              <span class="cvtp__who">
                <cite>{{ f[3] | escape }}</cite>
                {%- if r_date != blank -%}<span>{{ r_date }}</span>{%- endif -%}
                <span>{% if f[8] == 'gift' %}Gifted case{% elsif f[9] == 'import' %}Imported review{% else %}Verified buyer{% endif %}{% if f[7] == 'product' and f[5] != blank %} · {{ f[5] | escape }} case{% endif %}</span>
              </span>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if is_carousel -%}
        <div class="ccr__controls" data-ccr-controls hidden>
          <button type="button" class="ccr__nav" data-ccr-prev aria-label="{{ 'sections.trustpilot_reviews.previous_review' | t | escape }}" aria-controls="cv-trustpilot-rail-{{ section.id }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <span class="ccr__position" data-ccr-position data-template="{{ 'sections.trustpilot_reviews.position' | t: current: '%current%', total: '%total%' | escape }}" aria-live="polite" aria-atomic="true">{{ 'sections.trustpilot_reviews.position' | t: current: 1, total: review_count }}</span>
          <button type="button" class="ccr__nav ccr__nav--next" data-ccr-next aria-label="{{ 'sections.trustpilot_reviews.next_review' | t | escape }}" aria-controls="cv-trustpilot-rail-{{ section.id }}">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    {%- elsif app_block_count == 0 -%}
      <div class="ccr__empty">
        <span class="ccr__empty-symbol" aria-hidden="true">“ ”</span>
        <p>{{ 'sections.trustpilot_reviews.editor_hint' | t }}</p>
      </div>
    {%- endif -%}

    {%- if app_block_count > 0 -%}
      <div class="ccr__apps">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if profile != blank and section.settings.link_label != blank -%}
      <p class="cvtp__more">
        <a href="{{ profile | escape }}" target="_blank" rel="noopener noreferrer">
          {{ section.settings.link_label | escape }}
          {%- render 'cv-icon', name: 'arrow-right', size: 16 -%}
          <span class="cvtp__sr">{{ 'sections.trustpilot_reviews.new_window' | t }}</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Judge.me reviews",
  "tag": "div",
  "class": "section-casify-trustpilot-reviews",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Reviews and the rating summary come live from Judge.me (verified buyers and imported reviews, product and store reviews). To show a review platform's own widget instead, add its app block to this section." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rated by verified buyers" },
    { "type": "text", "id": "accent_text", "label": "Accent heading", "default": "Straight from our shoppers" },
    { "type": "text", "id": "intro", "label": "Intro text" },
    { "type": "header", "content": "Reviews page link" },
    { "type": "url", "id": "profile_url", "label": "Public reviews page URL", "info": "Optional. Links the rating and the button to your public reviews page in a new tab." },
    { "type": "range", "id": "trustscore", "label": "TrustScore (no longer used)", "min": 0, "max": 5, "step": 0.1, "default": 0, "info": "The score now comes live from Judge.me verified reviews." },
    { "type": "number", "id": "total_reviews", "label": "Total reviews (no longer used)", "info": "The count now comes live from Judge.me verified reviews." },
    { "type": "text", "id": "link_label", "label": "Reviews page button label", "default": "Read all reviews" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "teal", "label": "Soft teal" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Old review (not shown)",
      "settings": [
        {
          "type": "select",
          "id": "rating",
          "label": "Star rating",
          "options": [
            { "value": "0", "label": "No rating" },
            { "value": "1", "label": "1 star" },
            { "value": "2", "label": "2 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "5", "label": "5 stars" }
          ],
          "default": "0"
        },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "richtext", "id": "text", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Reviewer name" },
        { "type": "text", "id": "date", "label": "Date (not shown)", "info": "Reviews now come from Judge.me, which sets the date." },
        { "type": "image_picker", "id": "avatar", "label": "Reviewer photo" }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Judge.me reviews"
    }
  ]
}
{% endschema %}
