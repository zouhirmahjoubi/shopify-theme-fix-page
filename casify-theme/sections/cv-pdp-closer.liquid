{%- comment -%}
  Casify product page: the closing card.
  A paper slip that repeats what the visitor has chosen (kept live from the
  order slip by assets/cv-pdp-story.js) and takes them back to the button.
  The sweets are the shared hero cut-outs (assets/hero-sweet-*.webp).
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{%- assign cvar = product.selected_or_first_available_variant -%}

<section class="cvp cvp-closer" data-cvp-closer aria-labelledby="cvpCloserTitle-{{ section.id }}"
         style="--cvs-paper: url('{{ 'pdp-slip-paper.png' | asset_url }}');">
  <div class="cvp__inner">
    <div class="cvp-pad cvp-closer__card">
      <img class="cvp-closer__sweet cvp-closer__sweet--lolly" src="{{ 'hero-sweet-lollipop.webp' | asset_url }}" width="313" height="440" alt="" loading="lazy" decoding="async">
      <img class="cvp-closer__sweet cvp-closer__sweet--wrapped" src="{{ 'hero-sweet-wrapped-red.webp' | asset_url }}" width="440" height="212" alt="" loading="lazy" decoding="async">
      <h2 class="cvp__h2" id="cvpCloserTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p class="cvp-closer__summary" data-cvp-summary>{{ product.title | escape }} · {{ cvar.title | escape }}</p>
      <button type="button" class="cvs__cta cvp-closer__cta" data-cvp-back><span>{{ section.settings.cta_label | escape }}</span></button>
      {%- if section.settings.service_line != blank -%}
        <p class="cvs__service">{{ section.settings.service_line | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product: closing slip",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your slip is ready" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Back to your slip" },
    { "type": "text", "id": "service_line", "label": "Service line", "default": "Free shipping · 30-day returns · Ships in 1-3 business days" }
  ],
  "presets": [{ "name": "Product: closing slip" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
