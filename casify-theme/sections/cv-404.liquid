{%- comment -%}
  Casify — 404 in the Chrismass design system.

  A dead end is still a page someone landed on, so it does the two useful
  things: search, and a short list of places worth going. The numerals drift
  apart on a slow float so the page does not feel frozen.

  A link to a /pages/ handle this store doesn't have is skipped, so the 404
  page never sends someone to another 404.
{%- endcomment -%}

<div class="cv-page-root cv-404">
  <div class="cv-404__inner" data-cv-reveal>
    <span class="cv-404__code" aria-hidden="true">
      <i>4</i><em>{%- render 'cv-icon', name: 'drop-shield', size: 68, animate: true -%}</em><i>4</i>
    </span>

    <h1 data-cv-split>{{ section.settings.heading | default: 'This one took the drop' | escape }}</h1>
    <p class="cv-404__body">{{ section.settings.body | default: "The page you were after is gone. The cases, thankfully, are more durable." | escape }}</p>

    <form class="cv-search__form cv-404__search" action="{{ routes.search_url }}" method="get" role="search">
      <span class="cv-search__ico" aria-hidden="true">{%- render 'cv-icon', name: 'precision-fit', size: 18 -%}</span>
      {%- assign search_placeholder = section.settings.placeholder | default: 'Search for your phone model' -%}
      <input type="search" name="q" placeholder="{{ search_placeholder | escape }}" aria-label="{{ search_placeholder | escape }}" autocomplete="off">
      <button type="submit" class="cv-search__go" aria-label="Search">
        <span>Search</span>{%- render 'cv-icon', name: 'arrow-right', size: 16 -%}
      </button>
    </form>

    {%- capture links_markup -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'link' -%}
          {%- liquid
            assign link_url = b.settings.url | default: routes.root_url
            assign link_live = true
            if link_url contains '/pages/'
              assign link_handle = link_url | split: '/pages/' | last | split: '?' | first | split: '#' | first
              if pages[link_handle].id == blank
                assign link_live = false
              endif
            endif
          -%}
          {%- if link_live or request.design_mode -%}
            <a class="cv-404__link" href="{{ link_url }}" {{ b.shopify_attributes }}>
              {%- render 'cv-icon', name: b.settings.icon, size: 17 -%}
              <span>{{ b.settings.label | escape }}</span>
              {%- render 'cv-icon', name: 'arrow-right', size: 14, class: 'cv-404__link-go' -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if links_markup != blank -%}
      <div class="cv-404__links" data-cv-stagger>{{ links_markup }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This one took the drop" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The page you were after is gone. The cases, thankfully, are more durable." },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Search for your phone model" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "bag", "label": "Shop" },
          { "value": "drop-shield", "label": "Protection" },
          { "value": "truck-fast", "label": "Shipping" },
          { "value": "returns", "label": "Returns" },
          { "value": "warranty-seal", "label": "Warranty" },
          { "value": "quote", "label": "Blog" }
        ], "default": "bag" },
        { "type": "text", "id": "label", "label": "Label", "default": "Shop all cases" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "404",
      "blocks": [
        { "type": "link", "settings": { "icon": "bag", "label": "Shop all cases" } },
        { "type": "link", "settings": { "icon": "drop-shield", "label": "How the drop test works" } },
        { "type": "link", "settings": { "icon": "returns", "label": "Returns and refunds" } },
        { "type": "link", "settings": { "icon": "truck-fast", "label": "Shipping times" } }
      ]
    }
  ]
}
{% endschema %}
