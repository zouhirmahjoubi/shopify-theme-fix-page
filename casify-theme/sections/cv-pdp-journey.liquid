{%- liquid
  comment
    Case-only: on the product page of something that isn't a phone case (a candle, a cloth,
    a charm), this section shows nothing, since it talks about phones, fit or case packs
    (snippets/cv-is-case.liquid). Elsewhere it always shows.
  endcomment
  assign cv_case_page = true
  if template.name == 'product'
    capture cv_is_case
      render 'cv-is-case', product: product
    endcapture
    unless cv_is_case contains 'true'
      assign cv_case_page = false
    endunless
  endif
-%}
{%- if cv_case_page -%}
{%- comment -%}
  Casify product page: the order's journey (the home "drop, frame by frame"
  story, rebuilt).
  The home story ran a 12 ft lab drop with measured forces; none is confirmed.
  This story runs what really happens to an order, told with the confirmed
  facts: pick the exact phone, choose a pack, it leaves the shop within 1 to 3
  business days, shipping is free, 30 days to return. On wide screens
  assets/cv-pdp-home-motion.js pins the section and rides the delivery bicycle
  (KIE set piece assets/pdp-home-bicycle.webp) along the road as you scroll,
  lighting each stop; the parcel (assets/pdp-home-parcel.webp) lands at the
  door. Without motion the stops read as a plain numbered list.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign models = 0
  for option in product.options_with_values
    assign oname = option.name | downcase
    assign fv = option.values.first | downcase
    if oname contains 'model' or oname contains 'phone' or oname contains 'device' or fv contains 'iphone' or fv contains 'galaxy' or fv contains 'samsung'
      assign models = option.values.size
    endif
  endfor
  assign stops = section.blocks | where: 'type', 'stop'
-%}

{%- if stops.size > 0 -%}
  <section class="cvw cvw-journey" data-cvw-journey aria-labelledby="cvwJourneyTitle-{{ section.id }}">
    <div class="cvw-journey__pin" data-cvw-journey-pin>
      <div class="cvp__inner cvw-head">
        <h2 class="cvp__h2" id="cvwJourneyTitle-{{ section.id }}" data-cvw-split>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lede != blank -%}<p class="cvp__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      </div>

      <div class="cvw-journey__stage">
        <div class="cvw-journey__scene" aria-hidden="true">
          <svg class="cvw-journey__road" viewBox="0 0 1200 220" preserveAspectRatio="none" focusable="false">
            <path class="cvw-journey__road-bed" d="M-20 150 C 180 96, 330 196, 560 150 S 930 92, 1220 138"/>
            <path class="cvw-journey__road-line" data-cvw-road d="M-20 150 C 180 96, 330 196, 560 150 S 930 92, 1220 138"/>
          </svg>
          <img class="cvw-journey__bike" data-cvw-bike src="{{ 'pdp-home-bicycle.webp' | asset_url }}" width="900" height="547" alt="" loading="lazy" decoding="async">
          <img class="cvw-journey__parcel" data-cvw-parcel src="{{ 'pdp-home-parcel.webp' | asset_url }}" width="420" height="348" alt="" loading="lazy" decoding="async">
        </div>

        <ol class="cvw-journey__stops" role="list" style="--stops: {{ stops.size }};">
          {%- for b in stops -%}
            {%- liquid
              assign metric = b.settings.metric | replace: '[models]', models
              assign body = b.settings.body | replace: '[models]', models
            -%}
            <li class="cvw-stop" data-cvw-stop {{ b.shopify_attributes }}>
              <span class="cvw-stop__pin" aria-hidden="true">{{ forloop.index }}</span>
              <span class="cvw-stop__metric"><b>{{ metric | escape }}</b> {{ b.settings.unit | escape }}</span>
              <h3 class="cvw-stop__title">{{ b.settings.title | escape }}</h3>
              <p class="cvw-stop__body">{{ body | escape }}</p>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </section>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product: order journey",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our counter to your door" },
    { "type": "text", "id": "lede", "label": "Intro", "default": "What happens after you choose, one stop at a time. Scroll to ride along." }
  ],
  "blocks": [
    {
      "type": "stop",
      "name": "Stop",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "metric", "label": "Figure", "default": "[models]", "info": "[models] becomes this product's number of phone models. Only true figures." },
        { "type": "text", "id": "unit", "label": "Figure label", "default": "phone models" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your exact phone" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Every phone this case is made for is on the list. Choose yours." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product: order journey",
      "blocks": [
        { "type": "stop", "settings": { "metric": "[models]", "unit": "phone models", "title": "Pick your exact phone", "body": "Every phone this case is made for is on the list. Choose yours and it's the case cut for that phone." } },
        { "type": "stop", "settings": { "metric": "31%", "unit": "off each in a 3-pack", "title": "Choose your pack", "body": "One case, or two or three at 18% or 31% off each. The saving comes off automatically at checkout." } },
        { "type": "stop", "settings": { "metric": "1-3", "unit": "business days", "title": "Packed at the counter", "body": "Your order leaves the shop within 1 to 3 business days of ordering." } },
        { "type": "stop", "settings": { "metric": "Free", "unit": "shipping", "title": "On its way to you", "body": "Shipping is free on every order, with no minimum." } },
        { "type": "stop", "settings": { "metric": "30", "unit": "days to decide", "title": "At your door", "body": "Not the one? You have 30 days to send it back." } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
