{{ 'cv-campaign-guide.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign guide_product = section.settings.featured_product
  assign destination = section.settings.cta_url
  if destination == blank and guide_product != blank
    assign destination = guide_product.url
  endif
  assign destination = destination | default: routes.all_products_collection_url
  assign heading_default = 'sections.campaign_guide.heading' | t
  assign intro_default = 'sections.campaign_guide.intro' | t
  assign cta_default = 'sections.campaign_guide.choose_model' | t
  assign heading = section.settings.heading | default: heading_default
  assign intro = section.settings.intro | default: intro_default
  assign cta_label = section.settings.cta_label | default: cta_default
  assign reasons_default = 'sections.campaign_guide.reasons_heading' | t
  assign reasons_heading = section.settings.reasons_heading | default: reasons_default
  assign hero_image = section.settings.image | default: guide_product.featured_image
  assign hero_alt = hero_image.alt | default: guide_product.title | default: heading
  assign hero_loading = 'lazy'
  if section.index == 1
    assign hero_loading = 'eager'
  endif
  assign reason_count = 0
  assign proof_count = 0
  assign faq_count = 0
  for block in section.blocks
    if block.type == 'reason' and block.settings.heading != blank
      assign reason_count = reason_count | plus: 1
    elsif block.type == 'testimonial' and block.settings.quote != blank and block.settings.author != blank
      assign proof_count = proof_count | plus: 1
    elsif block.type == '@app'
      assign proof_count = proof_count | plus: 1
    elsif block.type == 'question' and block.settings.question != blank and block.settings.answer != blank
      assign faq_count = faq_count | plus: 1
    endif
  endfor
  comment
    The rating is the featured product's Judge.me rating from verified buyers
    only (snippets/cv-jm-verified.liquid). No reviews, no stars.
  endcomment
  assign rating_count = 0
  assign rating_max = 5
  assign has_rating = false
  assign rating_value = 0
  if guide_product != blank and guide_product.handle != blank
    capture jm_stats
      render 'cv-jm-verified', mode: 'stats', scope: 'product', handle: guide_product.handle
    endcapture
    assign jm_parts = jm_stats | split: '␟'
    assign rating_count = jm_parts[0] | plus: 0
    if rating_count > 0
      assign has_rating = true
      assign rating_value = jm_parts[1] | plus: 0 | times: 1.0 | divided_by: rating_count | round: 1
      assign star_fill = rating_value | times: 100.0 | divided_by: rating_max | round: 1
    endif
  endif
-%}

<section id="CampaignGuide-{{ section.id }}" class="campaign-guide campaign-guide--{{ section.settings.layout }}" aria-labelledby="CampaignHeading-{{ section.id }}">
  <div class="campaign-guide__wrap">
    <div class="campaign-guide__intro{% if hero_image == blank %} campaign-guide__intro--text{% endif %}">
      <div class="campaign-guide__copy">
        {%- if section.settings.heading_level == 'h1' -%}
          <h1 id="CampaignHeading-{{ section.id }}">{{ heading | escape }}</h1>
        {%- else -%}
          <h2 id="CampaignHeading-{{ section.id }}">{{ heading | escape }}</h2>
        {%- endif -%}
        <p class="campaign-guide__lede">{{ intro | escape }}</p>
        {%- if has_rating -%}
          <div class="campaign-guide__rating">
            {% render 'cv-stars', fill: star_fill %}
            <span>{{ 'sections.campaign_guide.rating' | t: rating: rating_value, maximum: rating_max, count: rating_count }}</span>
          </div>
        {%- endif -%}
        <div class="campaign-guide__actions">
          <a class="campaign-guide__button" href="{{ destination | escape }}">{{ cta_label | escape }}<span aria-hidden="true">&rarr;</span></a>
          {%- if reason_count > 0 -%}
            <a class="campaign-guide__text-link" href="#CampaignReasons-{{ section.id }}">{{ 'sections.campaign_guide.read_guide' | t }}</a>
          {%- endif -%}
        </div>
        <p class="campaign-guide__assurance">{{ 'sections.campaign_guide.assurance' | t }}</p>
      </div>
      {%- if hero_image != blank -%}
        <figure class="campaign-guide__photo">
          {{ hero_image | image_url: width: 1400 | image_tag: class: 'campaign-guide__hero-image', widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 900px) 48vw, 100vw', loading: hero_loading, alt: hero_alt }}
          <figcaption>
            {%- if section.settings.image_caption != blank -%}
              <span>{{ section.settings.image_caption | escape }}</span>
            {%- elsif guide_product != blank -%}
              <span>{{ guide_product.title | escape }}</span>
            {%- endif -%}
            {%- if guide_product != blank -%}
              <strong>{% if guide_product.price_varies %}{{ 'sections.campaign_guide.from' | t }} {% endif %}{{ guide_product.price_min | money }}</strong>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- elsif request.design_mode and guide_product == blank -%}
        <p class="campaign-guide__editor-note">{{ 'sections.campaign_guide.pick_product' | t }}</p>
      {%- endif -%}
    </div>

    {%- if reason_count > 0 -%}
      <div id="CampaignReasons-{{ section.id }}" class="campaign-guide__reasons" tabindex="-1">
        <h2>{{ reasons_heading | escape }}</h2>
        <ol class="campaign-guide__list" role="list">
          {%- assign reason_number = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'reason' and block.settings.heading != blank -%}
              {%- liquid
                assign reason_number = reason_number | plus: 1
                assign reason_image = block.settings.image
                if reason_image == blank and block.settings.product_image > 0 and guide_product != blank
                  assign image_index = block.settings.product_image | minus: 1
                  assign reason_image = guide_product.images[image_index]
                endif
                assign reason_alt = reason_image.alt | default: guide_product.title | default: block.settings.heading
              -%}
              <li class="campaign-guide__reason{% if reason_image != blank %} campaign-guide__reason--illustrated{% endif %}" {{ block.shopify_attributes }}>
                <span class="campaign-guide__number" aria-hidden="true">{{ reason_number }}</span>
                <div class="campaign-guide__reason-copy">
                  <h3>{{ block.settings.heading | escape }}</h3>
                  <div class="campaign-guide__prose">{{ block.settings.body }}</div>
                </div>
                {%- if reason_image != blank -%}
                  <figure class="campaign-guide__detail">
                    {{ reason_image | image_url: width: 800 | image_tag: widths: '320, 480, 640, 800', sizes: '(min-width: 900px) 320px, 100vw', loading: 'lazy', alt: reason_alt }}
                    {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
                  </figure>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- if proof_count > 0 -%}
      <div class="campaign-guide__proof" role="region" aria-label="{{ 'sections.campaign_guide.customer_proof' | t }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' and block.settings.quote != blank and block.settings.author != blank -%}
            <figure class="campaign-guide__quote" {{ block.shopify_attributes }}>
              <blockquote>{{ block.settings.quote | escape }}</blockquote>
              <figcaption>{{ block.settings.author | escape }}{% if block.settings.source_url != blank %} <a href="{{ block.settings.source_url | escape }}">{{ 'sections.campaign_guide.read_review' | t }}</a>{% endif %}</figcaption>
            </figure>
          {%- elsif block.type == '@app' -%}
            <div class="campaign-guide__app" {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_offer -%}
      <div class="campaign-guide__offer" role="region" aria-labelledby="CampaignOffer-{{ section.id }}">
        <div>
          <h2 id="CampaignOffer-{{ section.id }}">{{ 'sections.campaign_guide.offer_heading' | t }}</h2>
          <p>{{ 'sections.campaign_guide.offer_body' | t }}</p>
          <ul class="campaign-guide__tiers" role="list">
            <li><b>{{ 'sections.campaign_guide.one_case' | t }}</b><span>{{ 'sections.campaign_guide.single_price' | t }}</span></li>
            <li><b>{{ 'sections.campaign_guide.two_cases' | t }}</b><span>{{ 'sections.campaign_guide.save' | t: percent: section.settings.pack_2_percent }}</span></li>
            <li><b>{{ 'sections.campaign_guide.three_cases' | t }}</b><span>{{ 'sections.campaign_guide.save' | t: percent: section.settings.pack_3_percent }}</span></li>
          </ul>
        </div>
        <div class="campaign-guide__offer-action">
          <a class="campaign-guide__button" href="{{ destination | escape }}">{{ cta_label | escape }}<span aria-hidden="true">&rarr;</span></a>
          <p>{{ 'sections.campaign_guide.offer_note' | t }}</p>
          <p class="campaign-guide__assurance">{{ 'sections.campaign_guide.assurance' | t }}</p>
        </div>
      </div>
    {%- endif -%}

    {%- if faq_count > 0 -%}
      <div class="campaign-guide__faq">
        <h2>{{ 'sections.campaign_guide.questions_heading' | t }}</h2>
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary>
              <div class="campaign-guide__prose">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        <a class="campaign-guide__text-link" href="{{ destination | escape }}">{{ cta_label | escape }} &rarr;</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Campaign: case guide",
  "tag": "div",
  "class": "section-campaign-guide",
  "max_blocks": 16,
  "settings": [
    { "type": "product", "id": "featured_product", "label": "Featured product" },
    { "type": "text", "id": "heading", "label": "Headline", "info": "Match the specific promise in the ad that links to this page." },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    { "type": "select", "id": "heading_level", "label": "Heading level", "options": [{ "value": "h1", "label": "Page title" }, { "value": "h2", "label": "Section title" }], "default": "h2", "info": "Use Page title on a campaign page, Section title when adding to the homepage." },
    { "type": "select", "id": "layout", "label": "Reading style", "options": [{ "value": "list", "label": "Numbered reasons" }, { "value": "story", "label": "Story" }], "default": "list" },
    { "type": "image_picker", "id": "image", "label": "Hero photo", "info": "Defaults to the featured product's real photo. Use photography of this exact product." },
    { "type": "text", "id": "image_caption", "label": "Photo caption" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Button destination", "info": "Defaults to the featured product page, where customers choose their phone model and pack." },
    { "type": "text", "id": "reasons_heading", "label": "Reasons heading" },
    { "type": "checkbox", "id": "show_offer", "label": "Show the existing pack offer", "default": true },
    { "type": "range", "id": "pack_2_percent", "label": "Two-case saving", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 18, "info": "Must match the active Shopify automatic discount. This page does not create discounts." },
    { "type": "range", "id": "pack_3_percent", "label": "Three-case saving", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 31 }
  ],
  "blocks": [
    {
      "type": "reason", "name": "Reason or story beat", "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Explanation", "info": "Explain a real feature and what it does for the customer. Avoid unverified performance claims." },
        { "type": "image_picker", "id": "image", "label": "Supporting photo" },
        { "type": "range", "id": "product_image", "label": "Product photo number", "min": 0, "max": 10, "step": 1, "default": 0, "info": "Used when no supporting photo is selected. Zero means no photo; missing product photos stay hidden." },
        { "type": "text", "id": "caption", "label": "Photo caption", "info": "Describe the visible detail and why it matters." }
      ]
    },
    {
      "type": "testimonial", "name": "Real customer quote", "limit": 3,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Customer's exact words", "info": "Use a real customer review you have permission to display. Blank quotes stay hidden." },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "url", "id": "source_url", "label": "Original review link" }
      ]
    },
    { "type": "@app" },
    {
      "type": "question", "name": "Question", "limit": 6,
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Campaign: case guide", "blocks": [
    { "type": "reason", "settings": { "heading": "Start with your exact phone model", "body": "<p>A case is only right for you if it fits your phone. Check your model in your phone settings, then choose that model on the product page.</p>", "product_image": 2, "caption": "Check the camera opening and the fit for your model." } },
    { "type": "reason", "settings": { "heading": "Look closer before you choose", "body": "<p>Use the product photos to compare the finish, camera opening and design. Pick the case and colour you want to carry every day.</p>", "product_image": 3, "caption": "A closer look at the finish and details." } },
    { "type": "reason", "settings": { "heading": "Give yourself time to decide", "body": "<p>Free shipping comes with every order. Orders dispatch in 1–3 business days, and you have 30 days to return your case.</p>" } }
  ] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
