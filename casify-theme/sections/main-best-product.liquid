{{ 'best-product.css' | asset_url | stylesheet_tag }}

{%- capture jm_stats -%}{%- render 'cv-jm-verified', mode: 'stats', scope: 'product', handle: product.handle -%}{%- endcapture -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  comment
    The rating: this product's Judge.me reviews (verified buyers and imported; snippets/cv-jm-verified.liquid).
  endcomment
  assign jm_parts = jm_stats | split: '␟'
  assign rating_count = jm_parts[0] | plus: 0
  assign rating_avg = 0
  if rating_count > 0
    assign rating_avg = jm_parts[1] | plus: 0 | times: 1.0 | divided_by: rating_count
  endif
  assign model_oi = -1
  assign style_oi = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'model' or option_name contains 'phone' or option_name contains 'device'
      assign model_oi = forloop.index0
    elsif option_name contains 'style' or option_name contains 'color' or option_name contains 'colour'
      assign style_oi = forloop.index0
    endif
  endfor
  if model_oi == -1
    for option in product.options_with_values
      assign first_value = option.values.first | downcase
      if first_value contains 'iphone' or first_value contains 'galaxy' or first_value contains 'pixel' or first_value contains 'samsung'
        assign model_oi = forloop.index0
        break
      endif
    endfor
  endif
  if style_oi == -1
    for option in product.options_with_values
      assign candidate_index = forloop.index0
      if candidate_index != model_oi
        assign style_oi = candidate_index
        break
      endif
    endfor
  endif

  comment
    Model first (STORE-FACTS 4): a phone model is never chosen for the shopper. With more than one
    model value and no ?variant= in the URL, no model radio is checked, the hidden id stays empty and
    assets/best-product.js nudges to the picker on Add to bag or Buy now.
  endcomment
  assign model_pending = false
  if model_oi >= 0
    assign model_values = product.options_with_values[model_oi].values
    if model_values.size > 1 and product.selected_variant == blank
      assign model_pending = true
    endif
  endif

  comment
    Images: the product's own media first (PRODUCT.md "product photography stays real"). The bundled
    AI scenes (best-case-*.png) render only when the merchant turns on show_illustrations; images the
    merchant picks in the editor are always used.
  endcomment
  assign main_media = current_variant.featured_media | default: product.featured_media
  assign photo_src = ''
  if main_media != blank
    assign photo_src = main_media | image_url: width: 1200
  endif
  assign photo_alt = main_media.alt | default: product.title
  assign show_art = section.settings.show_illustrations
  assign hero_src = photo_src
  if section.settings.hero_image != blank
    assign hero_src = section.settings.hero_image | image_url: width: 1200
  elsif show_art or hero_src == blank
    assign hero_src = 'best-case-in-hand.png' | asset_url
  endif
  assign detail_src = photo_src
  assign detail_media = product.media[1]
  if detail_media.media_type == 'image'
    assign detail_src = detail_media.preview_image | image_url: width: 1200
  endif
  if section.settings.detail_image != blank
    assign detail_src = section.settings.detail_image | image_url: width: 1200
  elsif show_art or detail_src == blank
    assign detail_src = 'best-case-detail.png' | asset_url
  endif
  assign magnetic_src = photo_src
  if section.settings.magnetic_image != blank
    assign magnetic_src = section.settings.magnetic_image | image_url: width: 1200
  elsif show_art or magnetic_src == blank
    assign magnetic_src = 'best-case-magnetic.png' | asset_url
  endif

  comment
    G20 (PLAN.md 4; PRODUCT.md:102-105): the seal and every feature line render only when the product
    carries the tag the merchant names. Blank tag = hidden. None of these are in the store's evidence on hand.
  endcomment
  assign tag_seal = false
  if section.settings.best_seller_tag != blank and product.tags contains section.settings.best_seller_tag
    assign tag_seal = true
  endif
  assign tag_magnetic = false
  if section.settings.magnetic_tag != blank and product.tags contains section.settings.magnetic_tag
    assign tag_magnetic = true
  endif
  assign tag_fabric = false
  if section.settings.fabric_tag != blank and product.tags contains section.settings.fabric_tag
    assign tag_fabric = true
  endif
  assign tag_fit = false
  if section.settings.fit_tag != blank and product.tags contains section.settings.fit_tag
    assign tag_fit = true
  endif
  assign tag_protect = false
  if section.settings.protection_tag != blank and product.tags contains section.settings.protection_tag
    assign tag_protect = true
  endif

  comment
    Packs: the same percentages as the automatic discounts (theme settings cv_pack_2_pct / cv_pack_3_pct),
    so the page total equals checkout. 0 hides that pack.
  endcomment
  assign pct2 = settings.cv_pack_2_pct | default: 0
  assign pct3 = settings.cv_pack_3_pct | default: 0
  assign show_packs = false
  if pct2 > 0 or pct3 > 0
    assign show_packs = true
  endif

  assign model_label = 'products.buy.model_placeholder' | t
  if model_oi >= 0 and model_pending == false
    assign model_label = current_variant.options[model_oi]
  endif
  assign your_phone = 'products.best.your_phone' | t
  assign made_for_phone = your_phone
  if model_oi >= 0 and model_pending == false
    assign made_for_phone = current_variant.options[model_oi]
  endif
  assign add_label = 'products.buy.add_to_bag' | t
  if current_variant.available == false
    assign add_label = 'products.buy.sold_out' | t
  endif
  assign start_price = current_variant.price
-%}

<section class="best-pdp" id="best-product-{{ section.id }}" data-best-product data-section-id="{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-checkout-path="checkout"
  data-i18n-add-to-bag="{{ 'products.buy.add_to_bag' | t | escape }}"
  data-i18n-adding="{{ 'products.buy.adding' | t | escape }}"
  data-i18n-added="{{ 'products.buy.added' | t | escape }}"
  data-i18n-sold-out="{{ 'products.buy.sold_out' | t | escape }}"
  data-i18n-unavailable="{{ 'products.buy.unavailable' | t | escape }}"
  data-i18n-choose-model="{{ 'products.buy.choose_model' | t | escape }}"
  data-i18n-model-placeholder="{{ 'products.buy.model_placeholder' | t | escape }}"
  data-i18n-to-checkout="{{ 'products.buy.to_checkout' | t | escape }}"
  data-i18n-error="{{ 'products.buy.error' | t | escape }}"
  data-i18n-your-phone="{{ your_phone | escape }}"
  data-i18n-show-all="{{ 'products.best.show_all_models' | t | escape }}"
  data-i18n-show-fewer="{{ 'products.best.show_fewer_models' | t | escape }}">
  <script type="application/json" data-best-variants>{{ product.variants | json }}</script>
  <div class="best-pdp__awning" aria-hidden="true"></div>
  <div class="best-pdp__layout">
    <div class="best-pdp__buy-column">
      <div class="best-gallery" data-best-gallery>
        <div class="best-gallery__stage">
          <img src="{{ hero_src }}" alt="{{ photo_alt | escape }}" width="900" height="1125" fetchpriority="high" data-best-main-image data-cvm-fly-img>
          {%- render 'best-claims', part: 'gallery', seal: tag_seal, magnetic: tag_magnetic, fabric: tag_fabric, fit: tag_fit -%}
        </div>
        <div class="best-gallery__rail-wrap">
          <button class="best-gallery__arrow" type="button" aria-label="{{ 'products.gallery.previous_photo' | t | escape }}" data-best-gallery-prev>{% render 'icon', name: 'chevron-down', size: 18 %}</button>
          <div class="best-gallery__rail" data-best-rail>
            {%- assign thumb_n = 0 -%}
            {%- for media in product.media limit: 8 -%}
              {%- if media.media_type == 'image' -%}
                {%- assign thumb_n = thumb_n | plus: 1 -%}
                {%- assign thumb_src = media.preview_image | image_url: width: 1200 -%}
                <button class="best-gallery__thumb{% if thumb_src == hero_src %} is-active{% endif %}" type="button" aria-label="{{ 'products.gallery.photo_count' | t: index: forloop.index, count: product.media.size | escape }}" aria-pressed="{% if thumb_src == hero_src %}true{% else %}false{% endif %}" data-best-image="{{ thumb_src }}" data-best-alt="{{ media.alt | default: product.title | escape }}"><img src="{{ media.preview_image | image_url: width: 180 }}" alt="" width="92" height="92" loading="lazy"></button>
              {%- endif -%}
            {%- endfor -%}
            {%- if section.settings.hero_image != blank or show_art or thumb_n == 0 -%}
              <button class="best-gallery__thumb{% if thumb_n == 0 or section.settings.hero_image != blank or show_art %} is-active{% endif %}" type="button" aria-label="{{ product.title | escape }}" aria-pressed="false" data-best-image="{{ hero_src }}" data-best-alt="{{ photo_alt | escape }}"><img src="{{ hero_src }}" alt="" width="92" height="92" loading="lazy"></button>
            {%- endif -%}
            {%- if section.settings.detail_image != blank or show_art -%}
              <button class="best-gallery__thumb" type="button" aria-label="{{ product.title | escape }}" aria-pressed="false" data-best-image="{{ detail_src }}" data-best-alt="{{ product.title | escape }}"><img src="{{ detail_src }}" alt="" width="92" height="92" loading="lazy"></button>
            {%- endif -%}
            {%- if section.settings.magnetic_image != blank or show_art -%}
              <button class="best-gallery__thumb" type="button" aria-label="{{ product.title | escape }}" aria-pressed="false" data-best-image="{{ magnetic_src }}" data-best-alt="{{ product.title | escape }}"><img src="{{ magnetic_src }}" alt="" width="92" height="92" loading="lazy"></button>
            {%- endif -%}
          </div>
          <button class="best-gallery__arrow best-gallery__arrow--next" type="button" aria-label="{{ 'products.gallery.next_photo' | t | escape }}" data-best-gallery-next>{% render 'icon', name: 'chevron-down', size: 18 %}</button>
        </div>
      </div>

      <div class="best-buy" id="best-buy-{{ section.id }}">
        <div class="best-buy__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        <h1>{{ section.settings.heading | default: product.title | escape }}</h1>
        {%- comment -%} Real product rating only (verified Judge.me reviews). The star bar is clipped to the value, never five full stars. {%- endcomment -%}
        {%- if rating_count > 0 -%}
          {%- liquid
            assign star_pct = rating_avg | times: 20.0 | round: 1
            assign rating_value = rating_avg | round: 1
            if rating_count == 1
              assign reviews_label = 'products.rating.reviews_one' | t: count: rating_count
            else
              assign reviews_label = 'products.rating.reviews_other' | t: count: rating_count
            endif
          -%}
          <a class="best-buy__rating" href="#best-faq-{{ section.id }}"><span class="best-stars" style="--best-star-pct: {{ star_pct }}%" role="img" aria-label="{{ 'products.rating.out_of' | t: rating: rating_value | escape }}"><span class="best-stars__fill" aria-hidden="true">★★★★★</span></span><strong>{{ rating_value }}</strong><span>({{ reviews_label }})</span></a>
        {%- endif -%}
        <div class="best-buy__price" aria-live="polite">
          <strong data-best-price>{{ current_variant.price | money }}</strong>
          <s data-best-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          <span class="best-buy__save" data-best-save {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ 'products.product_summary.save' | t }} <span data-best-save-amount>{{ current_variant.compare_at_price | minus: current_variant.price | money }}</span></span>
        </div>
        {%- if section.settings.intro != blank -%}<p class="best-buy__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}

        <form class="best-form" id="best-form-{{ section.id }}" method="post" action="{{ routes.cart_add_url }}" data-cart-add-form>
          <input type="hidden" name="form_type" value="product">
          {%- comment -%} The id and quantity inputs get their name from best-product.js, so the no-JS selects below are the only ones that post without JavaScript. {%- endcomment -%}
          <input type="hidden" value="{% unless model_pending %}{{ current_variant.id }}{% endunless %}" data-best-variant-id>
          <input type="hidden" value="1" data-best-qty>
          {% render 'best-nojs-picker', product: product, current_variant: current_variant, model_oi: model_oi, model_pending: model_pending, show_packs: show_packs, pct2: pct2, pct3: pct3, section_id: section.id %}
          {%- if model_oi >= 0 -%}
            {%- assign model_option = product.options_with_values[model_oi] -%}
            <fieldset class="best-options best-options--models best-js-only" data-best-option="{{ model_oi }}" data-best-models>
              <legend><span class="best-options__step">1</span> {{ model_option.name | escape }}</legend>
              <div class="best-options__model-grid">
                {%- for value in model_option.values -%}
                  {%- liquid
                    assign model_in_stock = false
                    for variant in product.variants
                      if variant.options[model_oi] == value and variant.available
                        assign model_in_stock = true
                        break
                      endif
                    endfor
                  -%}
                  <label class="best-model{% if forloop.index > 6 %} best-model--extra{% endif %}{% unless model_in_stock %} is-soldout{% endunless %}">
                    <input type="radio" name="best-option-{{ section.id }}-{{ model_oi }}" value="{{ value | escape }}" {% if model_pending == false and value == current_variant.options[model_oi] %}checked{% endif %}>
                    <span>{{ value | escape }}{% unless model_in_stock %}<small class="best-model__out">{{ 'products.buy.sold_out' | t }}</small>{% endunless %}</span>
                  </label>
                {%- endfor -%}
              </div>
              {%- if model_option.values.size > 6 -%}<button class="best-options__more" type="button" data-best-more-models aria-expanded="false">{{ 'products.best.show_all_models' | t }}</button>{%- endif -%}
              <p class="best-options__selection{% if model_pending %} is-pending{% endif %}">{% render 'icon', name: 'phone', size: 18 %} <strong data-best-model-label>{{ model_label | escape }}</strong>{% render 'icon', name: 'check', size: 17 %}</p>
            </fieldset>
          {%- endif -%}

          {%- if style_oi >= 0 -%}
            {%- assign style_option = product.options_with_values[style_oi] -%}
            <fieldset class="best-options best-options--styles best-js-only" data-best-option="{{ style_oi }}">
              <legend><span class="best-options__step">{% if model_oi >= 0 %}2{% else %}1{% endif %}</span> {{ style_option.name | escape }} <strong data-best-style-label>{{ current_variant.options[style_oi] | escape }}</strong></legend>
              <div class="best-options__style-grid">
                {%- for value in style_option.values -%}
                  {%- assign swatch_image = product.featured_image -%}
                  {%- for variant in product.variants -%}
                    {%- assign swatch_value = variant.options[style_oi] -%}
                    {%- if swatch_value == value and variant.featured_image != blank -%}{%- assign swatch_image = variant.featured_image -%}{%- break -%}{%- endif -%}
                  {%- endfor -%}
                  <label class="best-style">
                    <input type="radio" name="best-option-{{ section.id }}-{{ style_oi }}" value="{{ value | escape }}" {% if value == current_variant.options[style_oi] %}checked{% endif %}>
                    <span class="best-style__photo">{% if swatch_image != blank %}<img src="{{ swatch_image | image_url: width: 180 }}" alt="" width="76" height="76" loading="lazy">{% else %}<img src="{{ hero_src }}" alt="" width="76" height="76" loading="lazy">{% endif %}</span>
                    <span class="best-style__name">{{ value | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}

          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            {%- if option_index != model_oi and option_index != style_oi and product.has_only_default_variant == false -%}
              <label class="best-options__select-label best-js-only" for="best-extra-{{ section.id }}-{{ option_index }}">{{ option.name | escape }}</label>
              <select class="best-js-only" id="best-extra-{{ section.id }}-{{ option_index }}" data-best-option="{{ option_index }}">
                {%- for value in option.values -%}<option value="{{ value | escape }}" {% if value == current_variant.options[option_index] %}selected{% endif %}>{{ value | escape }}</option>{%- endfor -%}
              </select>
            {%- endif -%}
          {%- endfor -%}

          {%- if show_packs -%}
            {%- liquid
              assign line2 = start_price | times: 2
              assign each2 = line2 | times: pct2 | divided_by: 100.0 | floor | minus: line2 | times: -1 | divided_by: 2
              assign line3 = start_price | times: 3
              assign each3 = line3 | times: pct3 | divided_by: 100.0 | floor | minus: line3 | times: -1 | divided_by: 3
            -%}
            <div class="best-packs best-js-only" role="radiogroup" aria-label="{{ 'products.best.packs_label' | t | escape }}" data-best-packs data-cvm-packs>
              <span class="best-packs__highlight" data-cvm-pack-highlight aria-hidden="true"></span>
              <button type="button" class="best-pack" role="radio" aria-checked="true" tabindex="0" data-best-pack="1" data-pct="0">
                <span class="best-pack__name">{{ 'products.best.pack_one' | t }}</span>
                <span class="best-pack__each" data-best-pack-each>{{ start_price | money }}</span>
              </button>
              {%- if pct2 > 0 -%}
                <button type="button" class="best-pack" role="radio" aria-checked="false" tabindex="-1" data-best-pack="2" data-pct="{{ pct2 }}">
                  <span class="best-pack__flag">{{ 'products.product_summary.save' | t }} {{ pct2 }}%</span>
                  <span class="best-pack__name">{{ 'products.best.pack_many' | t | replace: '[qty]', '2' }}</span>
                  <span class="best-pack__each" data-best-pack-each>{{ each2 | money }}<small>{{ 'products.buy.each' | t }}</small></span>
                </button>
              {%- endif -%}
              {%- if pct3 > 0 -%}
                <button type="button" class="best-pack" role="radio" aria-checked="false" tabindex="-1" data-best-pack="3" data-pct="{{ pct3 }}">
                  <span class="best-pack__flag">{{ 'products.product_summary.save' | t }} {{ pct3 }}%</span>
                  <span class="best-pack__name">{{ 'products.best.pack_many' | t | replace: '[qty]', '3' }}</span>
                  <span class="best-pack__each" data-best-pack-each>{{ each3 | money }}<small>{{ 'products.buy.each' | t }}</small></span>
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="best-form__actions">
            <button class="best-button best-button--cart" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-best-add data-cvm-btn>{% render 'icon', name: 'bag', size: 21 %}<span data-cvm-label>{{ add_label }}</span></button>
          </div>
          <button class="best-button best-button--buy best-js-only" type="button" {% unless current_variant.available %}disabled{% endunless %} data-best-buy data-cvm-btn><span data-cvm-label>{{ 'products.best.buy_now' | t }}</span> <span class="best-button__price" data-best-total data-cvm-price data-cents="{{ start_price }}">{{ start_price | money }}</span></button>
          <p class="best-form__error" role="alert" data-best-error hidden></p>
        </form>
        <div class="best-service">
          <div>{% render 'icon', name: 'truck', size: 23 %}<span>{{ 'products.best.free_shipping' | t }}</span></div>
          <div>{% render 'icon', name: 'return', size: 23 %}<span>{{ 'products.best.returns' | t }}</span></div>
          <div>{% render 'icon', name: 'bag', size: 23 %}<span>{{ 'products.best.ships' | t }}</span></div>
          <div>{% render 'icon', name: 'shield', size: 23 %}<span>{{ 'products.best.secure_checkout' | t }}</span></div>
        </div>
        {%- comment -%} The five decorative stars here implied a rating (G20). Only the real rating above shows stars. {%- endcomment -%}
        <div class="best-proof"><span>{{ 'products.best.everyday' | t }}</span><span class="best-proof__pill">Casify</span></div>
        {% if product.media.size > 0 %}
          <div class="best-real">
            <h2>{{ 'products.best.real_details' | t }} <span aria-hidden="true">♥</span></h2>
            <div class="best-real__rail">
              {%- for media in product.media limit: 4 -%}
                {%- if media.media_type == 'image' -%}<img src="{{ media.preview_image | image_url: width: 460 }}" alt="{{ media.alt | default: product.title | escape }}" width="190" height="190" loading="lazy">{%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="best-pdp__story-column">
      {%- render 'best-claims', part: 'love', product: product, section: section, magnetic: tag_magnetic, fabric: tag_fabric, protect: tag_protect, hero_src: hero_src, detail_src: detail_src, magnetic_src: magnetic_src -%}

      <section class="best-story best-story--fit" aria-labelledby="best-fit-{{ section.id }}" data-best-card>
        <h2 id="best-fit-{{ section.id }}">{{ 'products.best.made_for_phone' | t: phone: '' }}<span data-best-made-for>{{ made_for_phone | escape }}</span></h2><p>{{ 'products.best.fit_copy' | t }}</p>
        <div class="best-feature-photo"><img src="{{ detail_src }}" alt="{{ product.title | escape }}" width="900" height="510" loading="lazy">{%- render 'best-claims', part: 'callouts', fit: tag_fit, fabric: tag_fabric -%}</div>
      </section>

      {%- render 'best-claims', part: 'magnetic', product: product, section: section, magnetic: tag_magnetic, magnetic_src: magnetic_src -%}

      {%- render 'best-claims', part: 'minis', product: product, protect: tag_protect, fabric: tag_fabric, hero_src: hero_src, detail_src: detail_src -%}

      <section class="best-story best-story--colors" aria-labelledby="best-colors-{{ section.id }}" data-best-card>
        <h2 id="best-colors-{{ section.id }}">{{ 'products.best.colors_heading' | t }}</h2><p>{{ 'products.best.colors_copy' | t }}</p>
        <div class="best-color-rail">
          {%- if style_oi >= 0 -%}
            {%- assign style_option = product.options_with_values[style_oi] -%}
            {%- for value in style_option.values -%}
              {%- assign lineup_image = product.featured_image -%}
              {%- for variant in product.variants -%}{%- assign lineup_value = variant.options[style_oi] -%}{%- if lineup_value == value and variant.featured_image != blank -%}{%- assign lineup_image = variant.featured_image -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- assign lineup_src = hero_src -%}
              {%- if lineup_image != blank -%}{%- assign lineup_src = lineup_image | image_url: width: 260 -%}{%- endif -%}
              <div><img src="{{ lineup_src }}" alt="{{ value | escape }}" width="130" height="170" loading="lazy"><span>{{ value | escape }}</span></div>
            {%- endfor -%}
          {%- else -%}
            {%- for media in product.media limit: 8 -%}{%- if media.media_type == 'image' -%}<div><img src="{{ media.preview_image | image_url: width: 260 }}" alt="{{ media.alt | default: product.title | escape }}" width="130" height="170" loading="lazy"></div>{%- endif -%}{%- endfor -%}
          {%- endif -%}
        </div>
      </section>

      <section class="best-story best-story--compare" aria-labelledby="best-compare-{{ section.id }}" data-best-card>
        <h2 id="best-compare-{{ section.id }}">{{ 'products.best.compare_heading' | t }}</h2>
        <div class="best-compare"><div class="best-compare__product"><img src="{{ hero_src }}" alt="{{ product.title | escape }}" width="170" height="220" loading="lazy"><div><h3>Casify</h3><ul>{%- render 'best-claims', part: 'compare', product: product, fabric: tag_fabric, magnetic: tag_magnetic, fit: tag_fit, style_oi: style_oi -%}<li>{{ 'products.best.listed_by_model' | t }}</li><li>{{ 'products.best.returns' | t }}</li></ul></div></div><div class="best-compare__other"><h3>{{ 'products.best.check_heading' | t }}</h3><ul><li>{{ 'products.best.check_1' | t }}</li><li>{{ 'products.best.check_2' | t }}</li><li>{{ 'products.best.check_3' | t }}</li><li>{{ 'products.best.check_4' | t }}</li><li>{{ 'products.best.check_5' | t }}</li></ul></div></div>
      </section>

      <div class="best-bottom-grid" data-best-card>
        <section class="best-faq" id="best-faq-{{ section.id }}" aria-labelledby="best-faq-heading-{{ section.id }}"><h2 id="best-faq-heading-{{ section.id }}">{{ 'products.best.faq_heading' | t }}</h2><details><summary>{{ 'products.best.faq_q1' | t }}</summary><p>{{ 'products.best.faq_a1' | t }}</p></details><details><summary>{{ 'products.best.faq_q2' | t }}</summary><p>{{ 'products.best.faq_a2' | t }}</p></details><details><summary>{{ 'products.best.faq_q3' | t }}</summary><p>{{ 'products.best.faq_a3' | t }}</p></details><details><summary>{{ 'products.best.faq_q4' | t }}</summary><p>{{ 'products.best.faq_a4' | t }}</p></details><details><summary>{{ 'products.best.faq_q5' | t }}</summary><p>{{ 'products.best.faq_a5' | t }}</p></details></section>
        <aside class="best-endcap"><h2>{{ 'products.best.endcap_heading_html' | t }}</h2><div><img src="{{ hero_src }}" alt="" width="110" height="150" loading="lazy"><strong data-best-end-price>{{ current_variant.price | money }}</strong></div><a href="#best-buy-{{ section.id }}">{{ 'products.best.choose_yours' | t }} {% render 'icon', name: 'arrow-right', size: 17 %}</a><p>{{ 'products.best.endcap_assurance' | t }}</p></aside>
      </div>
    </div>
  </div>

  {%- comment -%} Sticky Add bar: shown by best-product.js once the buy buttons scroll away. Hidden without JavaScript (the form above already works). {%- endcomment -%}
  <div class="best-sticky" data-best-sticky hidden>
    <img class="best-sticky__img" src="{{ hero_src }}" alt="" width="44" height="44" loading="lazy" data-cvm-fly-img>
    <span class="best-sticky__copy"><strong>{{ product.title | escape }}</strong><span data-best-sticky-model>{{ model_label | escape }}</span></span>
    <span class="best-sticky__price" data-best-sticky-total data-cvm-price data-cents="{{ start_price }}">{{ start_price | money }}</span>
    <button class="best-button best-button--cart best-sticky__btn" type="submit" form="best-form-{{ section.id }}" {% unless current_variant.available %}disabled{% endunless %} data-best-sticky-add data-cvm-btn>{% render 'icon', name: 'bag', size: 19 %}<span data-cvm-label>{{ add_label }}</span></button>
  </div>
</section>
<script src="{{ 'best-product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Best product page",
  "tag": "section",
  "class": "best-product-section",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (optional)", "info": "Leave blank to show the product's own photos." },
    { "type": "image_picker", "id": "detail_image", "label": "Detail image (optional)" },
    { "type": "image_picker", "id": "magnetic_image", "label": "Accessory image (optional)" },
    { "type": "checkbox", "id": "show_illustrations", "label": "Show the bundled illustrations", "default": false, "info": "The bundled case scenes are AI illustrations, not your product. Off shows the product's own photos." },
    { "type": "paragraph", "content": "Feature lines show only on products that carry the tag you name below. Leave a tag blank to hide those lines. Shown only when you can back it. Not in the store's evidence on hand." },
    { "type": "text", "id": "best_seller_tag", "label": "Best seller seal: product tag", "info": "Shown only when you can back it. Not in the store's evidence on hand." },
    { "type": "text", "id": "magnetic_tag", "label": "Magnetic and MagSafe lines: product tag", "info": "Shown only when you can back it. Not in the store's evidence on hand." },
    { "type": "text", "id": "fabric_tag", "label": "Woven fabric and soft touch lines: product tag", "info": "Shown only when you can back it. Not in the store's evidence on hand." },
    { "type": "text", "id": "fit_tag", "label": "Raised camera edge and buttons lines: product tag", "info": "Shown only when you can back it. Not in the store's evidence on hand." },
    { "type": "text", "id": "protection_tag", "label": "Drop protection lines: product tag", "info": "Shown only when you can back it. Not in the store's evidence on hand." },
    { "type": "text", "id": "eyebrow", "label": "Small product label", "default": "CASIFY CASES" },
    { "type": "text", "id": "heading", "label": "Heading override (leave blank for product title)" },
    { "type": "textarea", "id": "intro", "label": "Short description", "default": "Choose your phone model, then your style." },
    { "type": "text", "id": "benefit_one", "label": "Magnetic benefit", "info": "Needs the magnetic tag above." },
    { "type": "textarea", "id": "benefit_one_copy", "label": "Magnetic benefit copy" },
    { "type": "text", "id": "benefit_two", "label": "Fabric benefit", "info": "Needs the fabric tag above." },
    { "type": "textarea", "id": "benefit_two_copy", "label": "Fabric benefit copy" },
    { "type": "text", "id": "benefit_three", "label": "Protection benefit", "info": "Needs the protection tag above." },
    { "type": "textarea", "id": "benefit_three_copy", "label": "Protection benefit copy" }
  ],
  "presets": [{ "name": "Best product page" }]
}
{% endschema %}
