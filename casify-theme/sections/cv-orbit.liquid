{%- comment -%}
  Casify — "The collection, in 3D" (home page).

  Real products from one collection stand on a candy-shop turntable in a
  three.js scene. GSAP turns the turntable one case at a time (hold, then an
  eased step) with a countdown bar on each dot; the front case's shop ticket
  swaps in beside it with that product's own benefits. Drag to spin (it snaps
  to the nearest case), click a side case to bring it round, click the front
  case to open it.

  Scripts: assets/cv-orbit.js is a module loaded from layout/theme.liquid
  after the GSAP bundle, so it can drive the rotation with gsap directly. It
  fetches three.js only when this section is on the page.

  Honest data only. Per product: phone-model and style counts from the
  product's options, the sale saving from compare-at price, and features named
  in the product's own title. Store-wide perks are the confirmed service facts
  and the live pack discounts (keep pack percentages equal to the automatic
  discounts in Shopify admin).

  KIE AI (GPT Image 2.5): assets/cv-orbit-turntable.webp (the turntable,
  cobalt-keyed) and assets/cv-orbit-backdrop.webp (shop bokeh). The floating
  sweets reuse the KIE hero cut-outs (assets/hero-sweet-*.webp).

  No WebGL, no JS or reduced motion: the plain card grid and the perks row are
  the whole experience.

  Only products with a photo stand on the turntable (a catalogue still
  syncing has some without). With none the section renders only in the
  theme editor (with a "pick a collection" hint), so shoppers never see an
  empty turntable or the editor instruction, and three.js isn't loaded.
{%- endcomment -%}
{%- liquid
  assign coll = section.settings.collection | default: collections.frontpage
  # Speed: the collection is read one product at a time and only as far as needed
  # (the old `where: 'featured_image'` loaded all 50 products to show six).
  assign has_products = false
  if coll != blank
    for product in coll.products
      if product.featured_image != blank
        assign has_products = true
        break
      endif
    endfor
  endif
-%}
{%- if has_products or request.design_mode -%}
{{ 'cv-orbit.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign limit = section.settings.limit | default: 6
  assign kw_list = 'magsafe:MagSafe,magnetic:Magnetic,shockproof:Shockproof,stand:Stand,wallet:Wallet,glitter:Glitter,transparent:Transparent,leather:Leather,rugged:Rugged,slim:Slim' | split: ','
  assign sweets = 'hero-sweet-wrapped-red.webp,hero-sweet-lollipop.webp,hero-sweet-wrapped-teal.webp,hero-sweet-cane.webp,hero-sweet-coin.webp' | split: ','
  assign sweet_urls = ''
  for s in sweets
    assign sweet_url = s | asset_url
    assign sweet_urls = sweet_urls | append: sweet_url
    unless forloop.last
      assign sweet_urls = sweet_urls | append: ','
    endunless
  endfor
-%}

<section class="cv-sec cvorbit" id="cvorbit-{{ section.id }}" data-cvorbit
  data-hold="{{ section.settings.hold }}"
  data-turntable="{{ 'cv-orbit-turntable.webp' | asset_url }}"
  data-sweets="{{ sweet_urls }}">
  <div class="cv-row__hd cvorbit__hd" data-cv-reveal>
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="cv-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 data-cv-split>{{ section.settings.heading | default: 'The collection, in 3D' | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <div class="cv-sec__lede">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
    {%- if coll != blank -%}
      <a class="cv-row__all" href="{{ coll.url }}">
        <span>{{ section.settings.link_label | default: 'View all' | escape }}</span>
        {%- render 'cv-icon', name: 'arrow-right', size: 15 -%}
      </a>
    {%- endif -%}
  </div>

  {%- if has_products -%}
    <div class="cvorbit__wrap" data-cvorbit-wrap>
      <span class="cvorbit__backdrop" aria-hidden="true"></span>

      <div class="cvorbit__stage" data-cvorbit-stage>
        <div class="cvorbit__fallback" data-cvorbit-fallback>
          <div class="cv-grid cv-grid--row">
            {%- assign shown = 0 -%}
            {%- for product in coll.products -%}
              {%- if shown >= limit -%}{%- break -%}{%- endif -%}
              {%- if product.featured_image == blank -%}{%- continue -%}{%- endif -%}
              {%- render 'cv-card', product: product, index: shown, quick_pick: true -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          </div>
        </div>
        <p class="cvorbit__hint" aria-hidden="true">
          {%- render 'cv-icon', name: 'arrow-right', size: 12 -%}
          <span>Drag to spin</span>
        </p>
      </div>

      <aside class="cvorbit__ticket" data-cvorbit-ticket hidden>
        <div class="cvorbit__ticket-top">
          <span class="cvorbit__count" data-cvorbit-count>01 / 01</span>
          <span class="cvorbit__ticket-actions">
            <span class="cvorbit__flag" data-cvorbit-save hidden></span>
            <button class="cvorbit__pause" type="button" data-cvorbit-pause aria-pressed="false" aria-label="Pause automatic rotation">
              <span class="cvorbit__pause-icon is-pause" aria-hidden="true">{%- render 'cv-icon', name: 'pause', size: 13 -%}</span>
              <span class="cvorbit__pause-icon is-play" aria-hidden="true">{%- render 'cv-icon', name: 'play', size: 13 -%}</span>
              <span data-cvorbit-pause-label>Pause</span>
            </button>
          </span>
        </div>
        <p class="cvorbit__title" data-cvorbit-in data-cvorbit-title></p>
        <p class="cvorbit__price" data-cvorbit-in>
          <b data-cvorbit-price></b>
          <s data-cvorbit-was></s>
        </p>
        <ul class="cvorbit__chips" data-cvorbit-chips></ul>
        <a class="cv-cta cvorbit__cta" data-cvorbit-in data-cvorbit-link href="{{ coll.url }}">
          <span class="cv-cta__shine" aria-hidden="true"></span>
          {%- render 'cv-icon', name: 'bag', size: 16 -%}
          <span class="cv-cta__label">View this case</span>
        </a>
        <div class="cvorbit__dots" data-cvorbit-dots role="tablist" aria-label="Cases on the turntable"></div>
      </aside>
    </div>

    <script type="application/json" data-cvorbit-data>
      [
        {%- assign shown = 0 -%}
        {%- for product in coll.products -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- if product.featured_image == blank -%}{%- continue -%}{%- endif -%}
          {%- if shown > 0 -%},{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- liquid
            assign models = 0
            assign styles = 0
            for option in product.options_with_values
              assign oname = option.name | downcase
              if oname contains 'model' or oname contains 'phone' or oname contains 'device' or oname contains 'compatib'
                assign models = option.values.size
              elsif oname contains 'color' or oname contains 'colour' or oname contains 'style' or oname contains 'design' or oname contains 'pattern'
                assign styles = option.values.size
              endif
            endfor
            if models == 0
              for option in product.options_with_values
                assign fv = option.values.first | downcase
                if fv contains 'iphone' or fv contains 'galaxy' or fv contains 'pixel' or fv contains 'samsung'
                  assign models = option.values.size
                  break
                endif
              endfor
            endif

            assign save = 0
            if product.compare_at_price > product.price
              assign save = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
            endif

            assign t = product.title | downcase
            assign feats = ''
            for kw in kw_list
              assign pair = kw | split: ':'
              if t contains pair[0]
                assign feats = feats | append: pair[1] | append: '|'
              endif
            endfor
          -%}
          {
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "image": {{ product.featured_image | image_url: width: 640 | json }},
            "price": {{ product.price | money | json }},
            "from": {{ product.price_varies | json }},
            "was": {% if save > 0 %}{{ product.compare_at_price | money | json }}{% else %}""{% endif %},
            "save": {{ save }},
            "models": {{ models }},
            "styles": {{ styles }},
            "available": {{ product.available | json }},
            "features": {{ feats | split: '|' | json }}
          }
        {%- endfor -%}
      ]
    </script>
  {%- else -%}
    <div class="cv-empty" data-cv-reveal>
      <span class="cv-empty__ico">{%- render 'cv-icon', name: 'precision-fit', size: 36, animate: true -%}</span>
      <h2>Pick a collection</h2>
      <p>Choose a collection with products in it and its cases spin up here. Shoppers don't see this section until then.</p>
    </div>
  {%- endif -%}

  <ul class="cvorbit__perks" data-cvorbit-perks>
    {%- if section.settings.perk_shipping != blank -%}
      <li class="cvorbit__perk">
        <span class="cvorbit__perk-ico">{%- render 'cv-icon', name: 'truck-fast', size: 22 -%}</span>
        <span><b>{{ section.settings.perk_shipping | escape }}</b><i>{{ section.settings.perk_shipping_note | escape }}</i></span>
      </li>
    {%- endif -%}
    {%- if section.settings.perk_returns != blank -%}
      <li class="cvorbit__perk">
        <span class="cvorbit__perk-ico">{%- render 'cv-icon', name: 'returns', size: 22 -%}</span>
        <span><b>{{ section.settings.perk_returns | escape }}</b><i>{{ section.settings.perk_returns_note | escape }}</i></span>
      </li>
    {%- endif -%}
    {%- if section.settings.perk_dispatch != blank -%}
      <li class="cvorbit__perk">
        <span class="cvorbit__perk-ico">{%- render 'cv-icon', name: 'clock', size: 22 -%}</span>
        <span><b>{{ section.settings.perk_dispatch | escape }}</b><i>{{ section.settings.perk_dispatch_note | escape }}</i></span>
      </li>
    {%- endif -%}
    {%- if section.settings.show_packs -%}
      <li class="cvorbit__perk cvorbit__perk--deal">
        <span class="cvorbit__perk-ico">{%- render 'cv-icon', name: 'gift', size: 22 -%}</span>
        <span><b>Save {{ section.settings.pack_2_pct }}% on 2 &middot; {{ section.settings.pack_3_pct }}% on 3</b><i>Mix colours and phone models</i></span>
      </li>
    {%- endif -%}
    {%- if section.settings.perk_checkout != blank -%}
      <li class="cvorbit__perk">
        <span class="cvorbit__perk-ico">{%- render 'cv-icon', name: 'lock-secure', size: 22 -%}</span>
        <span><b>{{ section.settings.perk_checkout | escape }}</b><i>{{ section.settings.perk_checkout_note | escape }}</i></span>
      </li>
    {%- endif -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "3D collection turntable",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to the Frontpage collection when empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Section 3D: the turntable" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The collection, in 3D" },
    { "type": "richtext", "id": "subheading", "label": "Sub-heading", "default": "<p>Watch it turn, or drag to spin. Every case comes with the same shop promises.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "limit", "label": "Cases on the turntable", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "hold", "label": "Seconds per case", "min": 2, "max": 8, "step": 0.5, "unit": "s", "default": 3.5 },
    { "type": "header", "content": "Shop promises" },
    { "type": "paragraph", "content": "Only confirmed facts. Leave a title blank to hide it." },
    { "type": "text", "id": "perk_shipping", "label": "Shipping", "default": "Free shipping" },
    { "type": "text", "id": "perk_shipping_note", "label": "Shipping note", "default": "On every order" },
    { "type": "text", "id": "perk_returns", "label": "Returns", "default": "Damage covered" },
    { "type": "text", "id": "perk_returns_note", "label": "Returns note", "default": "Free replacement or refund" },
    { "type": "text", "id": "perk_dispatch", "label": "Dispatch", "default": "Printed to order" },
    { "type": "text", "id": "perk_dispatch_note", "label": "Dispatch note", "default": "In the USA, shipped with tracking" },
    { "type": "text", "id": "perk_checkout", "label": "Checkout", "default": "Secure checkout" },
    { "type": "text", "id": "perk_checkout_note", "label": "Checkout note", "default": "Encrypted by Shopify" },
    { "type": "checkbox", "id": "show_packs", "label": "Show pack savings", "default": true },
    { "type": "range", "id": "pack_2_pct", "label": "Pack of 2 discount", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 18, "info": "Must match the automatic discount in Shopify admin." },
    { "type": "range", "id": "pack_3_pct", "label": "Pack of 3 discount", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 31, "info": "Must match the automatic discount in Shopify admin." }
  ],
  "presets": [{ "name": "3D collection turntable" }]
}
{% endschema %}
