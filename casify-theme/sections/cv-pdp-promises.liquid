{%- comment -%}
  Casify product page: service tickets and questions.
  Paper tickets for the store-wide facts the merchant has confirmed, then a
  short FAQ on the order pad, with FAQPage structured data. Every default here
  is a confirmed fact (free shipping, 30-day returns, dispatch in 1 to 3
  business days, pack savings applied by automatic discounts); keep edits true.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ticket_count = section.blocks | where: 'type', 'ticket' | size
  assign faq_count = section.blocks | where: 'type', 'faq' | size
-%}

<section class="cvp cvp-promises" aria-labelledby="cvpPromisesTitle-{{ section.id }}">
  <div class="cvp__inner">
    <h2 class="cvp__h2" id="cvpPromisesTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>

    {%- if ticket_count > 0 -%}
      <ul class="cvp-promises__tickets" role="list">
        {%- for b in section.blocks -%}
          {%- if b.type == 'ticket' -%}
            <li class="cvp-ticket" {{ b.shopify_attributes }}>
              <span class="cvp-ticket__ico">{%- render 'cv-icon', name: b.settings.icon, size: 26, animate: true -%}</span>
              <span class="cvp-ticket__title">{{ b.settings.title | escape }}</span>
              {%- if b.settings.body != blank -%}<span class="cvp-ticket__body">{{ b.settings.body | escape }}</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if faq_count > 0 -%}
      <div class="cvp-faq" id="cvp-faq">
        <h3 class="cvp-faq__title">{{ section.settings.faq_heading | escape }}</h3>
        <div class="cvp-faq__list">
          {%- for b in section.blocks -%}
            {%- if b.type == 'faq' -%}
              <details class="cvp-faq__item" {{ b.shopify_attributes }}>
                <summary class="cvp-faq__q">
                  <span>{{ b.settings.question | escape }}</span>
                  <span class="cvp-faq__mark" aria-hidden="true"></span>
                </summary>
                <div class="cvp-faq__a">{{ b.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- assign first_faq = true -%}
            {%- for b in section.blocks -%}
              {%- if b.type == 'faq' -%}
                {%- unless first_faq %},{% endunless -%}
                {"@type": "Question", "name": {{ b.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ b.settings.answer | strip_html | json }}}}
                {%- assign first_faq = false -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product: promises & FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What every order comes with" },
    { "type": "text", "id": "faq_heading", "label": "Questions heading", "default": "Questions at the counter" }
  ],
  "blocks": [
    {
      "type": "ticket",
      "name": "Promise ticket",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck-fast", "label": "Shipping" },
          { "value": "returns", "label": "Returns" },
          { "value": "clock", "label": "Dispatch" },
          { "value": "price-tag", "label": "Price tag" },
          { "value": "lock-secure", "label": "Secure checkout" },
          { "value": "gift", "label": "Gift" }
        ], "default": "truck-fast" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "body", "label": "Body", "default": "On every order" }
      ]
    },
    {
      "type": "faq",
      "name": "Question",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders leave us within 1 to 3 business days, and shipping is free.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product: promises & FAQ",
      "blocks": [
        { "type": "ticket", "settings": { "icon": "truck-fast", "title": "Free shipping", "body": "On every order" } },
        { "type": "ticket", "settings": { "icon": "returns", "title": "30-day returns", "body": "Change your mind within 30 days" } },
        { "type": "ticket", "settings": { "icon": "clock", "title": "Ships in 1-3 business days", "body": "From the day you order" } },
        { "type": "ticket", "settings": { "icon": "price-tag", "title": "Pack savings", "body": "Applied automatically at checkout" } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders leave us within 1 to 3 business days, and shipping is free.</p>" } },
        { "type": "faq", "settings": { "question": "Can I send it back?", "answer": "<p>Yes. You have 30 days to return it.</p>" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
