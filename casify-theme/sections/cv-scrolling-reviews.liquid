{%- comment -%}
  Casify — scrolling reviews (Chrismass design system).

  A rebuild of the "Scrolling Reviews" snippet: rows of short customer quotes
  running across the page in opposite directions, like ribbon candy on a
  conveyor. Each quote is a die-cut paper ticket with a monogram (or photo)
  in a brass ring, star rating and name (snippets/cv-scrolling-review-card.liquid).

  The tickets are Judge.me reviews (verified buyers and imported)
  (snippets/cv-jm-verified.liquid): imported, typed-in and unverified reviews
  never show. A review of another case names that case on its ticket. Old
  "Review" blocks stay in the schema so saved templates still load, but they
  are not shown. With no review the section renders nothing on the
  live store and a hint in the theme editor.

  "Random order" (on by default) shuffles the tickets on every page view
  (cv-scrolling-reviews.js); the theme editor keeps Judge.me's newest-first order.

  Without JavaScript (or with reduced motion) each row is a plain,
  horizontally scrollable list. With JS, cv-scrolling-reviews.js clones the
  row for a seamless loop, couples its speed and direction to page scroll,
  eases it down on hover/focus and gives visitors a pause button.
  Styles: assets/cv-scrolling-reviews.css.
{%- endcomment -%}
{{ 'cv-scrolling-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign st = section.settings
  assign rows = st.rows | plus: 0
  assign here = product.handle | default: ''
-%}
{%- capture cvsr_jm -%}{%- render 'cv-jm-verified', mode: 'rows', scope: 'all', limit: 25 -%}{%- endcapture -%}

{%- comment -%}
  Every ticket is rendered once, then dealt across the rows. "TONE" is filled
  in per row below so each row runs through the three avatar colours.
  Review fields (cv-jm-verified): rating, title, text, name, date, case name, handle, kind, gift, import.
  A gifted case carries "Gifted case"; an imported review carries "Imported review".
{%- endcomment -%}
{%- capture cvsr_cards -%}
  {%- assign cvsr_reviews = cvsr_jm | split: '␞' -%}
  {%- for rec in cvsr_reviews -%}
    {%- liquid
      assign f = rec | split: '␟'
      if f.size < 9
        continue
      endif
      assign q = f[2] | default: f[1] | truncatewords: 40, '…'
      assign case_name = ''
      if f[7] == 'product' and f[6] != here
        assign case_name = f[5]
      endif
      assign is_gift = false
      if f[8] == 'gift'
        assign is_gift = true
      endif
      assign is_import = false
      if f[9] == 'import'
        assign is_import = true
      endif
    -%}
    {%- render 'cv-scrolling-review-card', quote: q, name: f[3], rating: f[0], case_name: case_name, tone: 'TONE', gifted: is_gift, imported: is_import -%}
    <!--cvsr-cut-->
  {%- endfor -%}
  {%- if request.design_mode and cvsr_reviews.size == 0 -%}
    {%- render 'cv-scrolling-review-card', hint: 'Judge.me reviews (verified buyers and imported) appear here. None yet.' -%}
    <!--cvsr-cut-->
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign cvsr_items = cvsr_cards | split: '<!--cvsr-cut-->'
  assign total = 0
  for item in cvsr_items
    assign item_s = item | strip
    if item_s != blank
      assign total = total | plus: 1
    endif
  endfor
  assign row_count = rows | at_most: total | at_least: 1
-%}

{%- if total > 0 or request.design_mode -%}
<section
  class="cvsr cvsr--tone-{{ st.tone }}"
  data-cvsr
  data-cvsr-speed="{{ st.speed }}"
  {%- if st.shuffle and request.design_mode == false %} data-cvsr-shuffle{% endif %}
  style="--cvsr-pt: {{ st.padding_top }}px; --cvsr-pb: {{ st.padding_bottom }}px;"
  aria-labelledby="cvsr-title-{{ section.id }}"
>
  <div class="cvsr__hd">
    {%- if st.heading != blank -%}
      <h2 class="cvsr__title" id="cvsr-title-{{ section.id }}" data-cvsr-heading>{{ st.heading }}</h2>
    {%- else -%}
      <h2 class="cvsr__sr" id="cvsr-title-{{ section.id }}">Customer reviews</h2>
    {%- endif -%}
    {%- if st.subheading != blank -%}
      <div class="cvsr__lede" data-cvsr-fade>{{ st.subheading }}</div>
    {%- endif -%}
    <button type="button" class="cvsr__toggle" data-cvsr-toggle aria-pressed="false" hidden>
      <svg class="cvsr__toggle-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z"/></svg>
      <svg class="cvsr__toggle-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5 3l8 5-8 5z"/></svg>
      <span data-cvsr-toggle-label>Pause reviews</span>
    </button>
  </div>

  <div class="cvsr__rows">
    {%- for row in (1..row_count) -%}
      {%- assign row_index = forloop.index0 -%}
      <div class="cvsr__row" data-cvsr-row data-cvsr-dir="{% if row_index == 1 %}1{% else %}-1{% endif %}">
        <ul class="cvsr__track" role="list" data-cvsr-track>
          {%- assign dealt = 0 -%}
          {%- assign place = 0 -%}
          {%- for item in cvsr_items -%}
            {%- liquid
              assign item_s = item | strip
              if item_s == blank
                continue
              endif
              assign slot = dealt | modulo: row_count
              assign dealt = dealt | plus: 1
              if slot != row_index
                continue
              endif
              assign tone_n = place | plus: row_index | modulo: 3
              assign tone_class = 'cvsr-card__avatar--' | append: tone_n
              assign place = place | plus: 1
            -%}
            {{ item_s | replace: 'cvsr-card__avatar--TONE', tone_class }}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling reviews",
  "tag": "div",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic words are set in the script face — use it for one short flourish.",
      "default": "Our customers <em>love</em> their cases"
    },
    { "type": "richtext", "id": "subheading", "label": "Sub-heading" },
    {
      "type": "select", "id": "rows", "label": "Rows", "default": "2",
      "info": "Reviews are dealt across the rows. Rows run in opposite directions.",
      "options": [ { "value": "1", "label": "One" }, { "value": "2", "label": "Two" }, { "value": "3", "label": "Three" } ]
    },
    {
      "type": "range", "id": "speed", "label": "Scroll speed", "min": 20, "max": 120, "step": 10, "unit": "px",
      "info": "Pixels per second. Scrolling the page speeds the rows up briefly.", "default": 50
    },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "page",
      "options": [
        { "value": "page", "label": "Page cream" },
        { "value": "inset", "label": "Inset cream" },
        { "value": "cocoa", "label": "Cocoa" }
      ]
    },
    { "type": "header", "content": "Reviews" },
    {
      "type": "paragraph",
      "content": "Shows Judge.me reviews (verified buyers and imported), newest 25. Unverified reviews never show here."
    },
    {
      "type": "checkbox", "id": "shuffle", "label": "Random order", "default": true,
      "info": "Shuffles the reviews on every visit. The theme editor keeps Judge.me's order."
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Old review (not shown)",
      "settings": [
        { "type": "paragraph", "content": "Typed-in reviews are no longer shown. This section reads Judge.me reviews (verified buyers and imported). You can delete this block." },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "range", "id": "rating", "label": "Star rating", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "photo", "label": "Customer photo" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling reviews"
    }
  ]
}
{% endschema %}
