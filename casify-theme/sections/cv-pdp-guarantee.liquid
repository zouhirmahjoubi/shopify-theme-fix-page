{%- liquid
  comment
    Case-only: on the product page of something that isn't a phone case (a candle, a cloth,
    a charm), this section shows nothing, since it talks about phones, fit or case packs
    (snippets/cv-is-case.liquid). Elsewhere it always shows.
  endcomment
  assign cv_case_page = true
  if template.name == 'product'
    capture cv_is_case
      render 'cv-is-case', product: product
    endcapture
    unless cv_is_case contains 'true'
      assign cv_case_page = false
    endunless
  endif
-%}
{%- if cv_case_page -%}
{%- comment -%}
  Casify product page: questions and the close (the home "zero risk" section,
  rebuilt, merged with the product page's promise tickets, FAQ and closing card).
  The home version promised 90-day returns, a $200 screen repair, a 2-year
  warranty and 24-hour dispatch from Austin; none is confirmed. Every default
  here is: free shipping, 30-day returns, dispatch in 1 to 3 business days,
  pack savings from real automatic discounts. Keep edits true.
  The promises are stated once, rubber-stamped on the closing card, which also
  repeats the visitor's choice (kept live by assets/cv-pdp-story.js) and
  returns to the buy box.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cvar = product.selected_or_first_available_variant
  comment
    A phone model is never chosen for the shopper (DECISIONS.md). Same model option test and
    pending rule as the buy box (cv-product-counter model_pending): with more than one model and
    no ?variant=, the summary reads "[product] · Choose your phone" until cv-pdp-story.js updates it.
  endcomment
  assign model_oi = -1
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname contains 'model' or oname contains 'phone' or oname contains 'device' or oname contains 'compatib'
      assign model_oi = forloop.index0
      break
    endif
  endfor
  if model_oi == -1
    for option in product.options_with_values
      assign fv = option.values.first | downcase
      if fv contains 'iphone' or fv contains 'galaxy' or fv contains 'pixel' or fv contains 'samsung'
        assign model_oi = forloop.index0
        break
      endif
    endfor
  endif
  assign model_pending = false
  if model_oi >= 0 and product.selected_variant == blank
    if product.options_with_values[model_oi].values.size > 1
      assign model_pending = true
    endif
  endif
  assign faq_count = section.blocks | where: 'type', 'faq' | size
  assign promise_count = section.blocks | where: 'type', 'promise' | size
  if faq_count > 0
    assign title_id = 'cvwFaqTitle-' | append: section.id
    assign close_tag = 'h3'
  else
    assign title_id = 'cvwCloseTitle-' | append: section.id
    assign close_tag = 'h2'
  endif
-%}

<section class="cvw cvw-guarantee" data-cvw-guarantee aria-labelledby="{{ title_id }}"
         style="--cvs-paper: url('{{ 'pdp-slip-paper.png' | asset_url }}');">
  <div class="cvp__inner">
    {%- if faq_count > 0 -%}
      <div class="cvp-faq cvw-guarantee__faq" id="cvp-faq">
        <h2 class="cvp-faq__title" id="cvwFaqTitle-{{ section.id }}">{{ section.settings.faq_heading | escape }}</h2>
        <div class="cvp-faq__list">
          {%- for b in section.blocks -%}
            {%- if b.type == 'faq' -%}
              <details class="cvp-faq__item" {% if b.settings.default_open %}open{% endif %} {{ b.shopify_attributes }}>
                <summary class="cvp-faq__q">
                  <span>{{ b.settings.question | escape }}</span>
                  <span class="cvp-faq__mark" aria-hidden="true"></span>
                </summary>
                <div class="cvp-faq__a">{{ b.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- assign first_faq = true -%}
            {%- for b in section.blocks -%}
              {%- if b.type == 'faq' -%}
                {%- unless first_faq %},{% endunless -%}
                {"@type": "Question", "name": {{ b.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ b.settings.answer | strip_html | json }}}}
                {%- assign first_faq = false -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}

    <div class="cvp-pad cvw-close" data-cvp-closer data-cvw-close>
      <img class="cvw-close__sweet cvw-close__sweet--lolly" src="{{ 'hero-sweet-lollipop.webp' | asset_url }}" width="313" height="440" alt="" loading="lazy" decoding="async">
      <img class="cvw-close__sweet cvw-close__sweet--wrapped" src="{{ 'hero-sweet-wrapped-red.webp' | asset_url }}" width="440" height="212" alt="" loading="lazy" decoding="async">
      <{{ close_tag }} class="cvw-close__title" id="cvwCloseTitle-{{ section.id }}">{{ section.settings.close_heading | escape }}</{{ close_tag }}>
      <p class="cvp-closer__summary cvw-close__summary" data-cvp-summary>{{ product.title | escape }} · {% if model_pending %}{{ 'general.quick_pick.choose_phone' | t | escape }}{% else %}{{ cvar.title | escape }}{% endif %}</p>

      {%- if promise_count > 0 -%}
        <ul class="cvw-close__vows" role="list">
          {%- for b in section.blocks -%}
            {%- if b.type == 'promise' -%}
              <li class="cvw-vow" data-cvw-vow {{ b.shopify_attributes }}>
                <span class="cvw-vow__stamp" aria-hidden="true">{%- render 'cv-icon', name: b.settings.icon, size: 22 -%}</span>
                <span class="cvw-vow__text"><b>{{ b.settings.title | escape }}</b>{% if b.settings.body != blank %} <span>{{ b.settings.body | escape }}</span>{% endif %}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <button type="button" class="cvs__cta cvw-close__cta" data-cvp-back data-cvw-magnet><span>{{ section.settings.close_cta | escape }}</span></button>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product: FAQ & close",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "faq_heading", "label": "Questions heading", "default": "Questions at the counter" },
    { "type": "header", "content": "Close" },
    { "type": "text", "id": "close_heading", "label": "Heading", "default": "Ready at the counter" },
    { "type": "text", "id": "close_cta", "label": "Button", "default": "Back to my case" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Stamp", "default": "truck-fast", "options": [
          { "value": "truck-fast", "label": "Shipping" },
          { "value": "returns", "label": "Returns" },
          { "value": "clock", "label": "Dispatch" },
          { "value": "price-tag", "label": "Price tag" },
          { "value": "lock-secure", "label": "Secure checkout" },
          { "value": "gift", "label": "Gift" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping", "info": "Only promises that are true for every order." },
        { "type": "text", "id": "body", "label": "Detail", "default": "on every order, with no minimum" }
      ]
    },
    {
      "type": "faq",
      "name": "Question",
      "limit": 10,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders leave us within 1 to 3 business days, and shipping is free.</p>" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product: FAQ & close",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders leave us within 1 to 3 business days, and shipping is free.</p>", "default_open": true } },
        { "type": "faq", "settings": { "question": "Can I send it back?", "answer": "<p>Yes. You have 30 days to return it.</p>" } },
        { "type": "promise", "settings": { "icon": "truck-fast", "title": "Free shipping", "body": "on every order, with no minimum" } },
        { "type": "promise", "settings": { "icon": "returns", "title": "30-day returns", "body": "change your mind within 30 days" } },
        { "type": "promise", "settings": { "icon": "clock", "title": "Ships in 1-3 business days", "body": "counted from the day you order" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
