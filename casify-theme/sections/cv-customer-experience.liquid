{{ 'cv-customer-experience.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    Both tickets read Judge.me through snippets/cv-jm-verified.liquid:
    the product ticket averages this product's verified buyer reviews,
    the store ticket all verified reviews (product and store, every type).
    Stats: buyers' count and sum first, then gifted cases' — the score never
    counts a gifted case.
  endcomment
  capture jm_product
    render 'cv-jm-verified', mode: 'stats', scope: 'product', handle: product.handle
  endcapture
  assign jm_p = jm_product | split: '␟'
  assign rating_count = jm_p[0] | plus: 0
  assign has_rating = false
  assign rating_value = 0
  assign rating_max = 5
  if rating_count > 0
    assign has_rating = true
    assign rating_value = jm_p[1] | plus: 0 | times: 1.0 | divided_by: rating_count | round: 1
  endif

  capture jm_all
    render 'cv-jm-verified', mode: 'stats', scope: 'all'
  endcapture
  assign jm_a = jm_all | split: '␟'
  assign external_count = jm_a[0] | plus: 0
  assign external_rating = 0
  if external_count > 0
    assign external_rating = jm_a[1] | plus: 0 | times: 1.0 | divided_by: external_count | round: 1
  endif
  assign has_store_rating = external_count > 0
  assign external_percent = external_rating | times: 20 | round
  assign external_rating_text = external_rating | append: ''
  assign external_count_text = external_count | append: ''

  assign ticket_blocks = 0
  assign experience_blocks = 0
  assign app_blocks = 0
  for block in section.blocks
    if block.type == 'ticket'
      assign ticket_blocks = ticket_blocks | plus: 1
    elsif block.type == 'experience'
      assign experience_blocks = experience_blocks | plus: 1
    elsif block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor
-%}

<section
  class="cvx"
  id="{{ section.settings.anchor | default: 'cvc-reviews' | escape }}"
  data-cvx
  aria-labelledby="cvx-title-{{ section.id }}"
>
  <div class="cvx__inner">
    <div class="cvx__layout">
      <div class="cvx__art" data-cvx-art aria-label="{{ section.settings.collage_label | escape }}">
        <img
          class="cvx__plaque"
          data-cvx-plaque
          src="{{ 'cv-customer-experience-plaque.webp' | asset_url }}"
          width="1448"
          height="1086"
          loading="lazy"
          decoding="async"
          alt=""
        >
        <span class="cvx__pin cvx__pin--one" data-cvx-pin aria-hidden="true"></span>
        <span class="cvx__pin cvx__pin--two" data-cvx-pin aria-hidden="true"></span>

        <div class="cvx__tickets">
          {%- if has_store_rating or request.design_mode -%}
          <article class="cvx-ticket cvx-ticket--rating" data-cvx-ticket>
            <span class="cvx-ticket__avatar cvx-ticket__avatar--gold" aria-hidden="true">
              {%- render 'cv-icon', name: 'star', size: 16 -%}
            </span>
            <div>
              <p class="cvx-ticket__kicker">{{ section.settings.external_source | escape }}</p>
              {%- if has_store_rating -%}
              <h3>{{ external_rating_text }}/5 {{ section.settings.rating_label | escape }}</h3>
              <p>{{ external_count_text }} {{ section.settings.rating_count_label | escape }}</p>
              {%- else -%}
              <h3>—/5 {{ section.settings.rating_label | escape }}</h3>
              <p>Shows once Judge.me has a verified review</p>
              {%- endif -%}
            </div>
          </article>
          {%- endif -%}

          <article class="cvx-ticket cvx-ticket--product" data-cvx-ticket>
            <span class="cvx-ticket__avatar cvx-ticket__avatar--product" aria-hidden="true">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 96, height: 96, crop: 'center' | image_tag: loading: 'lazy', widths: '48, 72, 96', sizes: '32px', alt: '' }}
              {%- else -%}
                {%- render 'cv-icon', name: 'device', size: 17 -%}
              {%- endif -%}
            </span>
            <div>
              <p class="cvx-ticket__kicker">{{ product.title | escape }}</p>
              {%- if has_rating -%}
                <h3>{{ rating_value | round: 1 }}/{{ rating_max | round }} {{ section.settings.product_rating_label | escape }}</h3>
                <p>{{ rating_count }} {% if rating_count == 1 %}{{ section.settings.product_review_singular | escape }}{% else %}{{ section.settings.product_review_plural | escape }}{% endif %}</p>
              {%- else -%}
                <h3>{{ section.settings.empty_heading | escape }}</h3>
                <p>{{ section.settings.empty_text | escape }}</p>
              {%- endif -%}
            </div>
          </article>

          {%- for block in section.blocks -%}
            {%- if block.type == 'ticket' -%}
              <article class="cvx-ticket" data-cvx-ticket {{ block.shopify_attributes }}>
                <span class="cvx-ticket__avatar" aria-hidden="true">
                  {%- render 'cv-icon', name: block.settings.icon, size: 17 -%}
                </span>
                <div>
                  {%- if block.settings.kicker != blank -%}<p class="cvx-ticket__kicker">{{ block.settings.kicker | escape }}</p>{%- endif -%}
                  <h3>{{ block.settings.title | escape }}</h3>
                  <p>{{ block.settings.body | escape }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="cvx__content" data-cvx-content>
        <header class="cvx__header">
          <h2 id="cvx-title-{{ section.id }}" data-cvx-heading>{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.intro != blank -%}<p data-cvx-intro>{{ section.settings.intro | escape }}</p>{%- endif -%}
          <span class="cvx__rule" data-cvx-rule aria-hidden="true"></span>
        </header>

        <div class="cvx__experiences">
          {%- for block in section.blocks -%}
            {%- if block.type == 'experience' -%}
              <article class="cvx-experience" data-cvx-experience {{ block.shopify_attributes }}>
                <div class="cvx-experience__seal" data-cvx-seal>
                  {%- if block.settings.display == 'rating' -%}
                    <svg class="cvx-experience__ring" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
                      <circle class="cvx-experience__ring-track" cx="28" cy="28" r="22" pathLength="100"></circle>
                      <circle class="cvx-experience__ring-value" data-cvx-ring data-percent="{{ external_percent }}" cx="28" cy="28" r="22" pathLength="100"></circle>
                    </svg>
                    <span data-cvx-percent>{{ external_percent }}%</span>
                  {%- else -%}
                    <span class="cvx-experience__icon" data-cvx-icon aria-hidden="true">
                      {%- render 'cv-icon', name: block.settings.icon, size: 27 -%}
                    </span>
                  {%- endif -%}
                </div>
                <div class="cvx-experience__copy">
                  <h3>{{ block.settings.title | escape }}</h3>
                  {%- if block.settings.display == 'rating' -%}
                    {%- assign rating_body = section.settings.rating_body | replace: '[rating]', external_rating_text | replace: '[count]', external_count_text | replace: '[source]', section.settings.external_source -%}
                    <p><em>{{ rating_body | escape }}</em></p>
                  {%- else -%}
                    <p><em>{{ block.settings.body | escape }}</em></p>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.closing_note != blank -%}
          <div class="cvx__closing" data-cvx-closing>
            <span aria-hidden="true">{%- render 'cv-icon', name: 'sparkle-clear', size: 16 -%}</span>
            <div>{{ section.settings.closing_note }}</div>
          </div>
        {%- endif -%}

        {%- if app_blocks == 0 and section.settings.write_url != blank -%}
          <a class="cvx__write" href="{{ section.settings.write_url }}">{{ section.settings.write_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if app_blocks > 0 -%}
      <div class="cvx__app" data-cvx-app>
        <h3>{{ section.settings.app_heading | escape }}</h3>
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product: experience",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our customer experience" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Real store feedback, backed by the service promises that shape every order." },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "cvc-reviews", "info": "The buy box rating link points here." },
    { "type": "text", "id": "collage_label", "label": "Collage label", "default": "Store rating and customer service highlights" },
    { "type": "header", "content": "Store rating (from Judge.me)" },
    { "type": "text", "id": "external_rating", "label": "Rating out of 5 (no longer used)", "info": "The store rating now comes live from Judge.me verified reviews (all review types)." },
    { "type": "text", "id": "external_count", "label": "Rating count (no longer used)", "info": "The count now comes live from Judge.me verified reviews." },
    { "type": "text", "id": "external_source", "label": "Source", "default": "Judge.me" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "store rating" },
    { "type": "text", "id": "rating_count_label", "label": "Count label", "default": "published ratings" },
    { "type": "textarea", "id": "rating_body", "label": "Rating row text", "default": "Rated [rating] out of 5 across [count] reviews on [source].", "info": "Use [rating], [count], and [source] to insert the live section values." },
    { "type": "header", "content": "Product review state" },
    { "type": "text", "id": "product_rating_label", "label": "Product rating label", "default": "for this case" },
    { "type": "text", "id": "product_review_singular", "label": "Single review label", "default": "published product review" },
    { "type": "text", "id": "product_review_plural", "label": "Multiple reviews label", "default": "published product reviews" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Review record open" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "No product-specific reviews yet." },
    { "type": "url", "id": "write_url", "label": "Review link", "info": "Optional. Use only when this opens a real review form." },
    { "type": "text", "id": "write_label", "label": "Review link label", "default": "Write the first review" },
    { "type": "header", "content": "Closing note" },
    { "type": "richtext", "id": "closing_note", "label": "Text", "default": "<p>Choose your exact model, then let us handle the rest — real feedback and real shop promises, all in one place.</p>" },
    { "type": "text", "id": "app_heading", "label": "Review app heading", "default": "Published product reviews" }
  ],
  "blocks": [
    {
      "type": "ticket",
      "name": "Collage ticket",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "precision-fit", "label": "Exact fit" },
            { "value": "truck-fast", "label": "Shipping" },
            { "value": "clock", "label": "Dispatch" },
            { "value": "returns", "label": "Returns" },
            { "value": "gift", "label": "Pack" },
            { "value": "lock-secure", "label": "Secure" },
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Star" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "kicker", "label": "Small label", "default": "At the counter" },
        { "type": "text", "id": "title", "label": "Title", "default": "A real shop promise" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Add a confirmed customer-service fact here." }
      ]
    },
    {
      "type": "experience",
      "name": "Experience row",
      "settings": [
        {
          "type": "select",
          "id": "display",
          "label": "Seal",
          "options": [
            { "value": "rating", "label": "Store rating percentage" },
            { "value": "icon", "label": "Icon" }
          ],
          "default": "icon"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck-fast", "label": "Shipping" },
            { "value": "clock", "label": "Dispatch" },
            { "value": "returns", "label": "Returns" },
            { "value": "precision-fit", "label": "Exact fit" },
            { "value": "lock-secure", "label": "Secure" },
            { "value": "star", "label": "Star" }
          ],
          "default": "truck-fast"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "A smoother order from start to finish" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "Use a confirmed customer-experience fact." }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 18,
  "presets": [
    {
      "name": "Product: experience",
      "blocks": [
        { "type": "ticket", "settings": { "icon": "precision-fit", "kicker": "Choose with confidence", "title": "Exact-model fit", "body": "Pick only from the phones this case is made for." } },
        { "type": "ticket", "settings": { "icon": "truck-fast", "kicker": "On every order", "title": "Free shipping", "body": "No minimum and no code needed." } },
        { "type": "ticket", "settings": { "icon": "clock", "kicker": "Packed at the counter", "title": "1–3 business days", "body": "Your order leaves the shop quickly." } },
        { "type": "ticket", "settings": { "icon": "returns", "kicker": "Time to decide", "title": "30-day returns", "body": "Send it back if it is not the one." } },
        { "type": "ticket", "settings": { "icon": "gift", "kicker": "Two-case treat", "title": "Save 18%", "body": "The pack saving applies automatically." } },
        { "type": "ticket", "settings": { "icon": "gift", "kicker": "Three-case treat", "title": "Save 31%", "body": "Mix models and styles in one pack." } },
        { "type": "experience", "settings": { "display": "rating", "icon": "star", "title": "Loved across the shop", "body": "" } },
        { "type": "experience", "settings": { "display": "icon", "icon": "truck-fast", "title": "Free shipping, packed quickly", "body": "Every order ships free and leaves the shop within 1–3 business days." } },
        { "type": "experience", "settings": { "display": "icon", "icon": "returns", "title": "Thirty days to decide", "body": "If the fit or finish is not right, you have 30 days to send it back." } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
