{%- comment -%}
  Casify: the password page, shown while the store is locked. It says the shop is
  closed for now (the message is the one set in Online Store > Preferences), takes an
  email for when it opens, and lets the owner in with the store password. Built on the
  404 page's styles (.cv-404 in theme.css) and the search form's pill field.
{%- endcomment -%}

<div class="cv-page-root cv-404 cv-pass">
  <div class="cv-404__inner">
    {%- render 'casify-logo', size: 40 -%}

    <h1>{{ section.settings.heading | default: 'Back soon' | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="cv-404__body">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'cv-pass__form', id: 'cvPassNotify' -%}
      <input type="hidden" name="contact[tags]" value="password-page">
      <div class="cv-search__form">
        <span class="cv-search__ico" aria-hidden="true">{%- render 'cv-icon', name: 'bag', size: 18 -%}</span>
        <label class="cv-pass__vh" for="cvPassEmail">{{ section.settings.email_label | default: 'Email' | escape }}</label>
        <input type="email" id="cvPassEmail" name="contact[email]" autocomplete="email" required
               placeholder="{{ section.settings.email_placeholder | default: 'Your email' | escape }}">
        <button type="submit" class="cv-search__go">{{ section.settings.email_button | default: 'Tell me' | escape }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="cv-pass__note" role="status">{{ section.settings.email_done | default: "Thanks. We'll email you when the shop opens." | escape }}</p>
      {%- elsif form.errors -%}
        <div class="cv-pass__note cv-pass__note--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
    {%- endform -%}

    {%- form 'storefront_password', class: 'cv-pass__form' -%}
      <details class="cv-pass__owner"{% if form.errors %} open{% endif %}>
        <summary>{{ section.settings.owner_label | default: 'Store owner? Enter the password' | escape }}</summary>
        <div class="cv-search__form">
          <span class="cv-search__ico" aria-hidden="true">{%- render 'cv-icon', name: 'arrow-right', size: 18 -%}</span>
          <label class="cv-pass__vh" for="cvPassWord">{{ section.settings.password_label | default: 'Password' | escape }}</label>
          <input type="password" id="cvPassWord" name="password" autocomplete="current-password" required
                 placeholder="{{ section.settings.password_label | default: 'Password' | escape }}">
          <button type="submit" class="cv-search__go">{{ section.settings.password_button | default: 'Enter' | escape }}</button>
        </div>
        {%- if form.errors -%}
          <div class="cv-pass__note cv-pass__note--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      </details>
    {%- endform -%}
  </div>
</div>

{%- style -%}
  .cv-pass .casify-logo { margin-bottom: 6px; }
  .cv-pass__form { width: 100%; margin-top: 4px; display: grid; justify-items: center; gap: 10px; }
  .cv-pass__form .cv-search__form { width: 100%; }
  .cv-pass__form input[type="email"],
  .cv-pass__form input[type="password"] {
    flex: 1; min-width: 0; height: 42px; border: 0; background: none; outline: none;
    font-family: var(--font-body); font-size: 16px; color: var(--cocoa-700);
  }
  .cv-pass__vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cv-pass__note { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-body); }
  .cv-pass__note--error { color: var(--red-600); }
  .cv-pass__note--error ul { margin: 0; padding: 0; list-style: none; }
  .cv-pass__owner { width: 100%; margin-top: 18px; display: grid; justify-items: center; gap: 12px; }
  .cv-pass__owner summary {
    cursor: pointer; padding: 10px 4px; font-family: var(--font-label); font-size: 10.5px;
    letter-spacing: .07em; text-transform: uppercase; color: var(--cocoa-600);
  }
  .cv-pass__owner summary:focus-visible { outline: 2px solid var(--red-500); outline-offset: 3px; border-radius: 6px; }
{%- endstyle -%}

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "paragraph", "content": "The message under the heading is the one in Online Store > Preferences > Password protection." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Back soon" },
    { "type": "header", "content": "Email sign-up" },
    { "type": "text", "id": "email_label", "label": "Field label (screen readers)", "default": "Email" },
    { "type": "text", "id": "email_placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "email_button", "label": "Button", "default": "Tell me" },
    { "type": "text", "id": "email_done", "label": "Thank-you line", "default": "Thanks. We'll email you when the shop opens." },
    { "type": "header", "content": "Owner login" },
    { "type": "text", "id": "owner_label", "label": "Link", "default": "Store owner? Enter the password" },
    { "type": "text", "id": "password_label", "label": "Field label", "default": "Password" },
    { "type": "text", "id": "password_button", "label": "Button", "default": "Enter" }
  ]
}
{% endschema %}
