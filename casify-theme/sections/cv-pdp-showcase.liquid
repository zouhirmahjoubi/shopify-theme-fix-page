{%- liquid
  comment
    Case-only: on the product page of something that isn't a phone case (a candle, a cloth,
    a charm), this section shows nothing, since it talks about phones, fit or case packs
    (snippets/cv-is-case.liquid). Elsewhere it always shows.
  endcomment
  assign cv_case_page = true
  if template.name == 'product'
    capture cv_is_case
      render 'cv-is-case', product: product
    endcapture
    unless cv_is_case contains 'true'
      assign cv_case_page = false
    endunless
  endif
-%}
{%- if cv_case_page -%}
{%- comment -%}
  Casify product page: the showcase (the home "fan favorites" cards, rebuilt).
  Three real products from a chosen collection, dealt onto the counter as
  tall candy-box cards. Every figure on a card comes from the product itself:
  its photo, price (and compare-at price when one is set), how many phones and
  styles it is made in, and a star rating only when a review app has written
  one. The page's own product is skipped.
{%- endcomment -%}
{{ 'cv-pdp-story.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-extras.css' | asset_url | stylesheet_tag }}
{{ 'cv-pdp-home.css' | asset_url | stylesheet_tag }}

{%- assign coll = section.settings.collection -%}
{%- if coll != blank and coll.products_count > 0 -%}
  <section class="cvw cvw-showcase" data-cvw-showcase aria-labelledby="cvwShowTitle-{{ section.id }}">
    <div class="cvp__inner">
      <div class="cvw-head">
        <h2 class="cvp__h2" id="cvwShowTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.lede != blank -%}<p class="cvp__lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
      </div>

      <ul class="cvw-showcase__cards" role="list">
        {%- assign dealt = 0 -%}
        {%- comment -%}
          Three cards, plus up to three hidden spares: assets/cv-pdp-story.js hides a product
          already shown higher on the page and brings a spare in so the counter still holds three.
        {%- endcomment -%}
        {%- for item in coll.products -%}
          {%- if dealt < 6 and item.id != product.id -%}
            {%- liquid
              assign dealt = dealt | plus: 1
              case dealt
                when 1
                  assign tone = 'cream'
                when 2
                  assign tone = 'teal'
                else
                  assign tone = 'cocoa'
              endcase

              assign models = 0
              assign styles = 0
              for option in item.options_with_values
                assign oname = option.name | downcase
                assign fv = option.values.first | downcase
                if oname contains 'model' or oname contains 'phone' or oname contains 'device' or fv contains 'iphone' or fv contains 'galaxy' or fv contains 'samsung'
                  assign models = option.values.size
                elsif option.values.size > 1
                  assign styles = option.values.size
                endif
              endfor

              assign i_rating = item.metafields.reviews.rating.value
              assign i_count = item.metafields.reviews.rating_count.value | default: 0
            -%}
            <li class="cvw-card cvw-card--{{ tone }}" data-cvw-card{% if dealt > 3 %} data-cvw-spare hidden{% endif %}>
              <a class="cvw-card__link" href="{{ item.url }}">
                <span class="cvw-card__lid" aria-hidden="true"></span>
                {%- if item.compare_at_price > item.price -%}
                  <span class="cvw-card__badge">{{ section.settings.sale_label | escape }}</span>
                {%- endif -%}
                <span class="cvw-card__media">
                  {%- if item.featured_image -%}
                    {{ item.featured_image | image_url: width: 720 | image_tag: widths: '360, 540, 720', sizes: '(min-width: 990px) 340px, 86vw', loading: 'lazy', alt: item.featured_image.alt | default: item.title, class: 'cvw-card__img' }}
                  {%- endif -%}
                </span>
                <span class="cvw-card__body">
                  {%- if i_rating != blank and i_count > 0 -%}
                    {%- assign i_pct = i_rating.rating | times: 100.0 | divided_by: i_rating.scale_max | round: 1 -%}
                    <span class="cvw-card__rating">
                      {%- render 'cv-stars', fill: i_pct, class: 'cvw-card__stars' -%}
                      <span>{{ i_rating.rating | round: 1 }} <span class="cvw-sr">out of {{ i_rating.scale_max }} stars,</span>({{ i_count }})</span>
                    </span>
                  {%- endif -%}
                  <span class="cvw-card__title">{{ item.title | escape }}</span>
                  {%- if models > 0 or styles > 0 -%}
                    <span class="cvw-card__facts">
                      {%- if models > 0 -%}<span>{{ models }} {% if models == 1 %}phone{% else %}phones{% endif %}</span>{%- endif -%}
                      {%- if styles > 0 -%}<span>{{ styles }} styles</span>{%- endif -%}
                    </span>
                  {%- endif -%}
                  <span class="cvw-card__foot">
                    <span class="cvw-card__price">
                      {%- if item.price_varies -%}<small>From</small> {% endif -%}{{ item.price_min | money }}
                      {%- if item.compare_at_price > item.price -%} <s>{{ item.compare_at_price | money }}</s>{%- endif -%}
                    </span>
                    <span class="cvw-card__cta">{{ section.settings.cta_label | escape }}
                      {%- render 'cv-icon', name: 'arrow-right', size: 18 -%}
                    </span>
                  </span>
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.link_label != blank -%}
        <p class="cvw-showcase__more"><a class="cvw-link" href="{{ coll.url }}">{{ section.settings.link_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product: showcase",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three more from the counter" },
    { "type": "text", "id": "lede", "label": "Intro", "default": "Real cases from the shop, each cut for its own list of phones." },
    { "type": "text", "id": "cta_label", "label": "Card button", "default": "See the case" },
    { "type": "text", "id": "sale_label", "label": "Badge when a compare-at price is set", "default": "On sale" },
    { "type": "text", "id": "link_label", "label": "Link to the collection", "default": "See every case" }
  ],
  "presets": [{ "name": "Product: showcase" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
