{{ 'cv-social-proof.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Casify — "The proof", built from Judge.me reviews by verified buyers only
  (snippets/cv-jm-verified.liquid): the score, the count and the customer
  ledger. Imported, typed-in and unverified reviews never count, whatever
  Judge.me publishes in its own widgets, and the section takes no app blocks.
  There is no typed store rating. With no verified review, the open-record
  empty state shows instead of seeded testimonials, press names,
  distributions or implied verification. A review of a case the shop sent as
  a gift sits in the ledger as "Gifted case" and is never part of the score.
{%- endcomment -%}

{%- capture proof_stats -%}{%- render 'cv-jm-verified', mode: 'stats', scope: 'all' -%}{%- endcapture -%}
{%- capture proof_jm -%}{%- render 'cv-jm-verified', mode: 'rows', scope: 'all', limit: 4 -%}{%- endcapture -%}
{%- liquid
  assign stat_parts = proof_stats | split: '␟'
  assign total_count = stat_parts[0] | plus: 0
  assign rating_scale = 5
  assign has_rating = false
  assign average_rating = 0
  assign star_fill = 0
  if total_count > 0
    assign has_rating = true
    assign average_rating = stat_parts[1] | plus: 0 | times: 1.0 | divided_by: total_count | round: 1
    assign star_fill = average_rating | times: 20.0 | round: 1
  endif
  assign proof_state = 'open'
  if has_rating
    assign proof_state = 'rated'
  endif
  comment
    Review fields (cv-jm-verified): rating, title, text, name, date, case name, handle, kind, gift.
    The score is the buyers' alone. Reviews of gifted cases sit in the ledger with
    their label and never set or move the score.
  endcomment
  assign gift_count = stat_parts[2] | plus: 0
  assign notes = proof_jm | split: '␞'
  assign note_count = 0
  for rec in notes
    assign f = rec | split: '␟'
    if f.size >= 9
      assign note_count = note_count | plus: 1
    endif
  endfor
-%}

<section
  class="cvp-proof"
  id="cv-reviews"
  data-cv-proof
  data-proof-state="{{ proof_state }}"
  data-three-enabled="{{ section.settings.enable_3d }}"
>
  <div class="cvp-proof__three" data-cv-proof-three aria-hidden="true"></div>

  <div class="cvp-proof__shell">
    <header class="cvp-proof__header">
      <h2 class="cvp-proof__heading" data-cv-proof-heading>{{ section.settings.heading | default: 'The proof, as it arrives' | escape }}</h2>
      <p class="cvp-proof__intro">{{ section.settings.intro_text | default: 'Reviews from verified buyers, as they arrive. Nothing here is typed in or scored by us.' | escape }}</p>
    </header>

    <div class="cvp-proof__board" data-cv-proof-board>
      <div class="cvp-proof__summary" data-cv-proof-summary>
        <div class="cvp-proof__status">
          <span class="cvp-proof__status-dot" aria-hidden="true"></span>
          <span>{% if has_rating %}Live customer record{% else %}Record open{% endif %}</span>
        </div>

        {%- if has_rating -%}
          <div class="cvp-proof__rating" aria-label="{{ average_rating }} out of {{ rating_scale }} stars from {{ total_count }} reviews">
            <span class="cvp-proof__score" data-cv-proof-score data-score="{{ average_rating }}">{{ average_rating }}</span>
            <span class="cvp-proof__scale">/ {{ rating_scale }}</span>
          </div>
          <div class="cvp-proof__stars" aria-hidden="true">
            {%- render 'cv-stars', fill: star_fill, class: 'cvp-proof__stars-row' -%}
          </div>
          <p class="cvp-proof__count">
            {{ total_count }} verified {% if total_count == 1 %}review{% else %}reviews{% endif %}{% if gift_count > 0 %} (gifted cases not counted){% endif %}
          </p>
        {%- else -%}
          <div class="cvp-proof__empty-mark" aria-hidden="true">
            <svg viewBox="0 0 120 120" role="presentation">
              <path data-cv-proof-svg d="M30 18h48l16 16v68H30z" />
              <path data-cv-proof-svg d="M78 18v17h16M45 55h34M45 69h34M45 83h21" />
              <path class="cvp-proof__svg-check" data-cv-proof-svg d="m70 95 8 8 18-22" />
            </svg>
          </div>
          {%- comment -%} Only gifted cases reviewed so far: still no score, and the text says why. {%- endcomment -%}
          {%- if gift_count > 0 %}
          <h3 class="cvp-proof__empty-title">No buyer reviews yet</h3>
          <p class="cvp-proof__empty-copy">The first buyer sets the score. Reviews of gifted cases are labelled and left out of it.</p>
          {%- else %}
          <h3 class="cvp-proof__empty-title">{{ section.settings.empty_heading | default: 'No published reviews yet' | escape }}</h3>
          <p class="cvp-proof__empty-copy">{{ section.settings.empty_text | default: 'The first customer review will set the score, not us.' | escape }}</p>
          {%- endif -%}
          {%- if section.settings.write_url != blank -%}
            <a class="cvp-proof__action" href="{{ section.settings.write_url }}">{{ section.settings.write_label | default: 'Write the first review' | escape }}</a>
          {%- endif -%}
        {%- endif -%}

        <dl class="cvp-proof__source" data-cv-proof-lines>
          <div>
            <dt>Score source</dt>
            <dd>Verified buyers</dd>
          </div>
          <div>
            <dt>Updates</dt>
            <dd>With every new review</dd>
          </div>
          <div>
            <dt>Editorial edits</dt>
            <dd>None</dd>
          </div>
        </dl>
      </div>

      <div class="cvp-proof__ledger" data-cv-proof-ledger>
        <div class="cvp-proof__ledger-head">
          <div class="cvp-proof__ledger-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation">
              <path d="M7 3h10a2 2 0 0 1 2 2v16l-3-2-4 2-4-2-3 2V5a2 2 0 0 1 2-2Z" />
              <path d="M8.5 8h7M8.5 12h7M8.5 16H13" />
            </svg>
          </div>
          <div>
            <h3>Customer ledger</h3>
            <p>Written in customers' own words.</p>
          </div>
        </div>

        <div class="cvp-proof__app" data-cv-proof-app>
          {%- if note_count > 0 -%}
            <ul class="cvp-proof__notes" role="list">
              {%- for rec in notes -%}
                {%- liquid
                  assign f = rec | split: '␟'
                  if f.size < 9
                    continue
                  endif
                  assign n_rating = f[0] | plus: 0
                  assign n_fill = n_rating | times: 20
                  assign n_text = f[2] | default: f[1] | truncatewords: 30, '…'
                -%}
                <li>
                  {%- if n_rating > 0 -%}
                    <span class="cvp-proof__note-stars" role="img" aria-label="{{ n_rating }} out of 5 stars">{%- render 'cv-stars', fill: n_fill -%}</span>
                  {%- endif -%}
                  <blockquote><p>{{ n_text | escape }}</p></blockquote>
                  <p class="cvp-proof__note-by">{{ f[3] | escape }} · {% if f[8] == 'gift' %}Gifted case{% else %}Verified buyer{% endif %}{% if f[7] == 'product' and f[5] != blank %} · {{ f[5] | escape }} case{% endif %}</p>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="cvp-proof__waiting">
              <span class="cvp-proof__waiting-line"></span>
              <span class="cvp-proof__waiting-line"></span>
              <span class="cvp-proof__waiting-line"></span>
              <p>{{ section.settings.ledger_empty_text | default: 'Customer notes will appear here automatically as they are published.' | escape }}</p>
            </div>
          {%- endif -%}
        </div>

        <p class="cvp-proof__note">
          <svg viewBox="0 0 20 20" aria-hidden="true" role="presentation"><path d="m4 10 4 4 8-9" /></svg>
          <span>{{ section.settings.source_note | default: 'No sample quotes. No imported press logos. Just the live record.' | escape }}</span>
        </p>
      </div>
    </div>

    <div class="cvp-proof__thanks" data-cv-proof-thanks>
      <div class="cvp-proof__thanks-copy">
        <h3>{{ section.settings.thank_you_heading | default: 'Thank you.' | escape }}</h3>
        <p>{{ section.settings.thank_you_text | default: 'For helping us build the record one honest review at a time.' | escape }}</p>
      </div>
      {%- comment -%} The stamp names the source: Judge.me reviews from verified buyers. {%- endcomment -%}
        <div class="cvp-proof__verified" data-cv-proof-stamp>
          <img src="{{ 'proof-stamp.webp' | asset_url }}" width="640" height="640" alt="" loading="lazy" decoding="async">
          <p><strong>{{ section.settings.badge_heading | default: 'Source checked' | escape }}</strong><span>{{ section.settings.badge_source | default: 'Verified Judge.me reviews' | escape }}</span></p>
        </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Convert — Social proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The proof, as it arrives" },
    { "type": "paragraph", "content": "The score, count and customer ledger come from Judge.me reviews by verified buyers only. Imported and unverified reviews never count." },
    { "type": "textarea", "id": "intro_text", "label": "Introduction", "default": "Reviews from verified buyers, as they arrive. Nothing here is typed in or scored by us." },
    { "type": "checkbox", "id": "enable_3d", "label": "Enable subtle 3D ledger motion", "default": true },
    { "type": "header", "content": "Before the first review", "info": "Shown until the first verified review." },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "No published reviews yet" },
    { "type": "textarea", "id": "empty_text", "label": "Text", "default": "The first customer review will set the score, not us." },
    { "type": "url", "id": "write_url", "label": "Review link", "info": "Optional. Use only when this URL opens a real review form." },
    { "type": "text", "id": "write_label", "label": "Review link label", "default": "Write the first review" },
    { "type": "header", "content": "Customer ledger" },
    { "type": "textarea", "id": "ledger_empty_text", "label": "Empty text", "default": "Customer notes will appear here automatically as they are published." },
    { "type": "text", "id": "source_note", "label": "Source note", "default": "No sample quotes. No imported press logos. Just the live record." },
    { "type": "header", "content": "Thank-you close" },
    { "type": "text", "id": "thank_you_heading", "label": "Heading", "default": "Thank you." },
    { "type": "textarea", "id": "thank_you_text", "label": "Text", "default": "For helping us build the record one honest review at a time." },
    { "type": "text", "id": "badge_heading", "label": "Badge heading", "default": "Source checked" },
    { "type": "text", "id": "badge_source", "label": "Badge text", "default": "Verified Judge.me reviews" }
  ],
  "presets": [
    {
      "name": "Convert — Social proof"
    }
  ]
}
{% endschema %}
