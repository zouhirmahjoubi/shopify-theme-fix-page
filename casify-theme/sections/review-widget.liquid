{%- comment -%}
  Review widget: Judge.me reviews from verified buyers, a rating summary, and a
  "Write a review" form that sends each review to Judge.me.

  Every review shown comes through snippets/cv-jm-verified.liquid: Judge.me
  reviews whose reviewer's email matched an order. Imported, typed-in and
  unverified reviews never show here, whatever Judge.me publishes in its own
  widgets. On a product page that product's reviews come first, then (if chosen)
  reviews of other cases and of the store, each labelled with what it's about.
  Anywhere else every verified review shows. A review of a case the shop sent
  as a gift carries "Gifted case" in place of the verified badge and is left
  out of the score; with no buyer review yet, the score is labelled as theirs.

  The form (assets/review-widget.js) sends a review to Judge.me the same way
  Judge.me's own review form does: a review of the product on a product page, a
  store review anywhere else. Judge.me emails the reviewer a link to confirm it.
  Once the reviewer's email matches an order, Judge.me marks the review verified
  and it shows here. Every review sent lands in the Judge.me app.

  The old "Review" and "Photo review" blocks stay in the schema so saved
  templates still load, but they are not shown.

  Styles: assets/review-widget.css. Script: assets/review-widget.js (form, "Load more").
  Motion (GSAP + three.js sweets behind the heading and summary): assets/review-motion.js.
{%- endcomment -%}
{{ 'review-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'review-widget.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'review-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sid = section.id
  assign st = section.settings

  comment
    On a product page, "here" is that product. Anywhere else every review shows.
  endcomment
  assign here = ''
  if product.handle != blank
    assign here = product.handle
  endif
  assign include_others = true
  if here != blank and st.scope == 'product'
    assign include_others = false
  endif
  assign rw_own = ''
  assign rw_more = ''
-%}
{%- if here != blank -%}
  {%- capture rw_own -%}{%- render 'cv-jm-verified', mode: 'rows', scope: 'product', handle: here -%}{%- endcapture -%}
  {%- if include_others -%}
    {%- capture rw_more -%}{%- render 'cv-jm-verified', mode: 'rows', scope: 'others', handle: here -%}{%- endcapture -%}
  {%- endif -%}
{%- else -%}
  {%- capture rw_more -%}{%- render 'cv-jm-verified', mode: 'rows', scope: 'all' -%}{%- endcapture -%}
{%- endif -%}
{%- liquid
  comment
    Review fields (cv-jm-verified): rating, title, text, name, date, case name, handle, kind, gift.
    The score counts buyers. Reviews of gifted cases are shown with their label and
    left out of it. While no buyer has reviewed yet, the score is theirs and says so.
  endcomment
  assign own_rows = rw_own | split: '␞'
  assign more_rows = rw_more | split: '␞'

  assign n_shown = 0
  assign n_gift_shown = 0
  assign n_other_rated = 0
  assign n_rated = 0
  assign rating_sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  assign g_other_rated = 0
  assign g_rated = 0
  assign g_sum = 0
  assign g5 = 0
  assign g4 = 0
  assign g3 = 0
  assign g2 = 0
  assign g1 = 0
  for pass in (1..2)
    if pass == 1
      assign pass_rows = own_rows
    else
      assign pass_rows = more_rows
    endif
    for rec in pass_rows
      assign f = rec | split: '␟'
      if f.size < 9
        continue
      endif
      assign n_shown = n_shown | plus: 1
      assign r = f[0] | plus: 0
      if f[8] == 'gift'
        assign n_gift_shown = n_gift_shown | plus: 1
        if r >= 1 and r <= 5
          assign g_rated = g_rated | plus: 1
          assign g_sum = g_sum | plus: r
          if pass == 2 and here != blank
            assign g_other_rated = g_other_rated | plus: 1
          endif
          case r
            when 5
              assign g5 = g5 | plus: 1
            when 4
              assign g4 = g4 | plus: 1
            when 3
              assign g3 = g3 | plus: 1
            when 2
              assign g2 = g2 | plus: 1
            else
              assign g1 = g1 | plus: 1
          endcase
        endif
        continue
      endif
      if r >= 1 and r <= 5
        assign n_rated = n_rated | plus: 1
        assign rating_sum = rating_sum | plus: r
        if pass == 2 and here != blank
          assign n_other_rated = n_other_rated | plus: 1
        endif
        case r
          when 5
            assign c5 = c5 | plus: 1
          when 4
            assign c4 = c4 | plus: 1
          when 3
            assign c3 = c3 | plus: 1
          when 2
            assign c2 = c2 | plus: 1
          else
            assign c1 = c1 | plus: 1
        endcase
      endif
    endfor
  endfor

  assign score_is_gift = false
  if n_rated == 0 and g_rated > 0
    assign score_is_gift = true
    assign n_rated = g_rated
    assign rating_sum = g_sum
    assign n_other_rated = g_other_rated
    assign c5 = g5
    assign c4 = g4
    assign c3 = g3
    assign c2 = g2
    assign c1 = g1
  endif

  assign avg = 0
  if n_rated > 0
    assign avg = rating_sum | times: 1.0 | divided_by: n_rated | round: 1
  endif
  assign avg_fill = avg | times: 20
  assign product_base = routes.root_url | remove_last: '/' | append: '/products/'

  comment
    The form: a review of this product on a product page, a store review anywhere else.
  endcomment
  assign show_form = st.show_form
  assign jm_product = ''
  if here != blank
    assign jm_product = product.id
  endif
  assign words = st.rating_words | default: 'Poor|Fair|Good|Great|Excellent'
  assign compose_id = 'rw-compose-' | append: sid
-%}

{%- if st.style == 'custom' -%}
  <style>
    #rw-{{ sid }} {
      --rw-bg: {{ st.bg }};
      --rw-card: {{ st.card_bg }};
      --rw-text: {{ st.text }};
      --rw-muted: {{ st.text | color_modify: 'alpha', 0.7 }};
      --rw-line: {{ st.text | color_modify: 'alpha', 0.16 }};
      --rw-accent: {{ st.accent }};
      --rw-accent-hover: {{ st.accent | color_darken: 8 }};
      --rw-accent-text: {{ st.accent_text }};
    }
  </style>
{%- endif -%}

<section
  id="rw-{{ sid }}"
  class="rw rw--{{ st.style | default: 'shop' }}"
  style="--rw-pad-top: {{ st.pad_top }}px; --rw-pad-bottom: {{ st.pad_bottom }}px; --rw-cols: {{ st.columns }};"
  data-rw
  data-rw-anchor="{{ st.anchor | remove: '#' | strip | escape }}"
  data-per-page="{{ st.per_page }}"
  {% if st.heading != blank %}aria-labelledby="rw-title-{{ sid }}"{% else %}aria-label="Reviews"{% endif %}
>
  <div class="rw__wrap">
    {%- if st.anchor != blank -%}<span class="rw__anchor" id="{{ st.anchor | remove: '#' | strip | escape }}"></span>{%- endif -%}
    <div class="rw__stage" data-rw-stage>
    <div class="rw__three" data-rw-three aria-hidden="true"></div>
    {%- if st.heading != blank or st.subheading != blank -%}
      <header class="rw__head">
        {%- if st.heading != blank -%}<h2 class="rw__title" id="rw-title-{{ sid }}">{{ st.heading | escape }}</h2>{%- endif -%}
        {%- if st.subheading != blank -%}<p class="rw__lede">{{ st.subheading | escape }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    {%- capture write_button -%}
      {%- if show_form -%}
        <button type="button" class="rw-btn" data-rw-open aria-expanded="false" aria-controls="{{ compose_id }}">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          {{ st.cta_label | default: 'Write a review' | escape }}
        </button>
      {%- endif -%}
    {%- endcapture -%}

    {%- if n_shown == 0 -%}
      <div class="rw-empty">
        <span class="rw-empty__stars" aria-hidden="true">{%- render 'cv-stars', fill: 0 -%}</span>
        <p class="rw-empty__title">{{ st.empty_heading | default: 'No reviews yet' | escape }}</p>
        {%- if write_button != blank -%}
          {%- if st.empty_text != blank -%}<p class="rw-empty__text">{{ st.empty_text | escape }}</p>{%- endif -%}
          <div class="rw-empty__cta">{{ write_button }}</div>
        {%- elsif st.empty_note != blank -%}
          <p class="rw-empty__text">{{ st.empty_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- elsif st.show_summary -%}
      <div class="rw-summary">
        <div class="rw-summary__score">
          <b class="rw-summary__avg">{{ avg }}</b>
          <span class="rw-summary__stars" role="img" aria-label="{{ avg }} out of 5 stars">{%- render 'cv-stars', fill: avg_fill -%}</span>
          <small class="rw-summary__count">
            {%- if score_is_gift -%}
              {%- comment -%} Fixed wording: this score comes from people who got their case free. {%- endcomment -%}
              {%- if n_rated == 1 -%}Based on 1 review of a gifted case{%- else -%}Based on {{ n_rated }} reviews of gifted cases{%- endif -%}
            {%- elsif n_other_rated > 0 -%}
              {{ st.count_others_text | default: 'Based on [count] reviews of our cases' | replace: '[count]', n_rated | escape }}
            {%- else -%}
              {{ st.count_text | default: 'Based on [count] reviews' | replace: '[count]', n_rated | escape }}
            {%- endif -%}
          </small>
          {%- if n_gift_shown > 0 and score_is_gift == false %}
          <small class="rw-summary__count">Gifted cases not counted</small>
          {%- endif %}
        </div>

        {%- if n_rated > 0 -%}
          <ul class="rw-bars" role="list">
            {%- assign counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
            {%- for n in counts -%}
              {%- assign stars = 6 | minus: forloop.index -%}
              {%- assign n_int = n | plus: 0 -%}
              {%- assign pct = n_int | times: 100.0 | divided_by: n_rated | round -%}
              <li class="rw-bar">
                <span class="rw-bar__label" aria-hidden="true">{{ stars }}<svg viewBox="0 0 24 24" width="12" height="12" focusable="false"><path d="m12 3.6 2.5 5.3 5.8.7-4.3 4 1.1 5.8L12 16.6l-5.1 2.8 1.1-5.8-4.3-4 5.8-.7z"/></svg></span>
                <span class="rw-bar__track" aria-hidden="true"><span style="width: {{ pct }}%"></span></span>
                <span class="rw-bar__n"><span class="rw-sr">{{ stars }} stars: </span>{{ n_int }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if st.trust_note != blank or write_button != blank -%}
          <div class="rw-summary__cta">
            {%- if st.trust_note != blank -%}
              <p class="rw-empty__text">{%- if n_gift_shown > 0 -%}Verified reviews only. Gifted cases are labelled.{%- else -%}{{ st.trust_note | escape }}{%- endif -%}</p>
            {%- endif -%}
            {{ write_button }}
          </div>
        {%- endif -%}
      </div>
    {%- elsif write_button != blank -%}
      <div class="rw-summary rw-summary--cta-only"><div class="rw-summary__cta">{{ write_button }}</div></div>
    {%- endif -%}
    </div>

    {%- if show_form -%}
      <div class="rw-compose" id="{{ compose_id }}" data-rw-compose hidden>
        <form
          class="rw-form"
          method="post"
          data-rw-form
          data-rw-shop="{{ shop.permanent_domain | escape }}"
          data-rw-product="{{ jm_product }}"
          data-rw-api="https://api.judge.me"
        >
          <div class="rw-form__fields" data-rw-fields>
            <div class="rw-form__head">
              <p class="rw-form__title">{{ st.form_heading | default: 'Write a review' | escape }}</p>
              {%- if st.form_intro != blank -%}<p class="rw-form__intro">{{ st.form_intro | escape }}</p>{%- endif -%}
            </div>

            <fieldset class="rw-rate" data-rw-rate data-words="{{ words | escape }}">
              <legend class="rw-label">{{ st.rating_label | default: 'Your rating' | escape }}</legend>
              <div class="rw-rate__row">
                <div class="rw-rate__stars">
                  {%- for i in (1..5) -%}
                    <label class="rw-rate__star">
                      <input type="radio" name="rating" value="{{ i }}" required>
                      <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="m12 3.6 2.5 5.3 5.8.7-4.3 4 1.1 5.8L12 16.6l-5.1 2.8 1.1-5.8-4.3-4 5.8-.7z"/></svg>
                      <span class="rw-sr">{{ i }} {% if i == 1 %}star{% else %}stars{% endif %}</span>
                    </label>
                  {%- endfor -%}
                </div>
                <span class="rw-rate__word" data-rw-rate-word aria-hidden="true"></span>
              </div>
            </fieldset>

            <div class="rw-field">
              <label class="rw-label" for="rw-title-input-{{ sid }}">{{ st.title_label | default: 'Title' | escape }} <span class="rw-optional">{{ st.optional_label | default: 'optional' | escape }}</span></label>
              <input class="rw-input" type="text" id="rw-title-input-{{ sid }}" name="title" maxlength="100" autocomplete="off">
            </div>

            <div class="rw-field">
              <label class="rw-label" for="rw-text-{{ sid }}">{{ st.text_label | default: 'Your review' | escape }}</label>
              <textarea class="rw-input rw-input--area" id="rw-text-{{ sid }}" name="body" rows="5" minlength="10" maxlength="5000" required></textarea>
            </div>

            <div class="rw-form__pair">
              <div class="rw-field">
                <label class="rw-label" for="rw-name-{{ sid }}">{{ st.name_label | default: 'Your name' | escape }}</label>
                <input class="rw-input" type="text" id="rw-name-{{ sid }}" name="name" maxlength="60" autocomplete="name" required aria-describedby="rw-name-hint-{{ sid }}">
                <small class="rw-hint" id="rw-name-hint-{{ sid }}">{{ st.name_hint | default: 'Shown with your review' | escape }}</small>
              </div>
              <div class="rw-field">
                <label class="rw-label" for="rw-email-{{ sid }}">{{ st.email_label | default: 'Email' | escape }}</label>
                <input class="rw-input" type="email" id="rw-email-{{ sid }}" name="email" maxlength="254" autocomplete="email" required aria-describedby="rw-email-hint-{{ sid }}">
                <small class="rw-hint" id="rw-email-hint-{{ sid }}">{{ st.email_hint | default: 'Never shown' | escape }}</small>
              </div>
            </div>

            {%- comment -%} Left empty by people, filled in by spam bots: the script then sends nothing. {%- endcomment -%}
            <div class="rw-offscreen" aria-hidden="true">
              <label>Leave this empty <input type="text" name="rw_website" tabindex="-1" autocomplete="off"></label>
            </div>

            {%- if st.privacy_note != blank -%}
              <p class="rw-form__note">{{ st.privacy_note | replace: '<a ', '<a target="_blank" rel="noopener" ' }}</p>
            {%- endif -%}

            <p class="rw-status" data-rw-status role="status" aria-live="polite"></p>

            <div class="rw-form__actions">
              <button type="submit" class="rw-btn" data-rw-submit data-sending-label="{{ st.sending_label | default: 'Sending…' | escape }}">{{ st.submit_label | default: 'Send review' | escape }}</button>
              <button type="button" class="rw-btn rw-btn--ghost" data-rw-cancel>{{ st.cancel_label | default: 'Cancel' | escape }}</button>
            </div>
          </div>

          <div class="rw-done" data-rw-done tabindex="-1" hidden>
            <p class="rw-done__title" data-rw-done-title data-template="{{ st.success_heading | default: 'Thank you, [name]!' | escape }}"></p>
            {%- if st.confirm_text != blank -%}<p class="rw-done__text">{{ st.confirm_text | escape }}</p>{%- endif -%}
            <p class="rw-done__text" data-rw-preview-note hidden>Theme editor preview: nothing was sent to Judge.me.</p>
          </div>

          <p hidden data-rw-error-text>{{ st.error_text | default: "Your review couldn't be sent. Check your connection and try again." | escape }}</p>
        </form>
      </div>
    {%- endif -%}

    {%- if n_shown > 0 -%}
      <div class="rw-grid" data-rw-grid>
        {%- comment -%} 1. This product's reviews (on a product page) {%- endcomment -%}
        {%- for rec in own_rows -%}
          {%- liquid
            assign f = rec | split: '␟'
            if f.size < 9
              continue
            endif
            assign c_date = f[4] | date: '%B %Y'
            assign c_gift = false
            if f[8] == 'gift'
              assign c_gift = true
            endif
          -%}
          {%- render 'rw-review-card', rating: f[0], title: f[1], text: f[2], author: f[3], date: c_date, verified: true, verified_label: st.verified_label, gifted: c_gift -%}
        {%- endfor -%}

        {%- comment -%} 2. Everything else: other cases and the store, labelled {%- endcomment -%}
        {%- for rec in more_rows -%}
          {%- liquid
            assign f = rec | split: '␟'
            if f.size < 9
              continue
            endif
            assign c_date = f[4] | date: '%B %Y'
            assign c_gift = false
            if f[8] == 'gift'
              assign c_gift = true
            endif
            assign p_title = ''
            assign p_url = ''
            if f[7] == 'store'
              assign p_title = shop.name
            elsif f[5] != blank
              assign p_title = f[5] | append: ' case'
              if f[6] != blank
                assign p_url = product_base | append: f[6]
              endif
            endif
          -%}
          {%- render 'rw-review-card', rating: f[0], title: f[1], text: f[2], author: f[3], date: c_date, verified: true, verified_label: st.verified_label, gifted: c_gift, product_title: p_title, product_url: p_url, product_label: st.other_label -%}
        {%- endfor -%}
      </div>

      {%- if n_shown > st.per_page -%}
        <div class="rw-more">
          <button type="button" class="rw-btn rw-btn--ghost" data-rw-more>{{ st.more_label | default: 'Load more reviews' | escape }}</button>
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="rw-editor-hint">Judge.me reviews from verified buyers show here. Imported and unverified reviews never do. None yet.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Review widget",
  "tag": "div",
  "class": "section-review-widget",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "paragraph", "content": "Shows Judge.me reviews from verified buyers only. Imported and unverified reviews never show here. Judge.me's review request emails bring verified reviews in after each order." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real reviews from real people" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "text", "id": "count_text", "label": "Review count line", "default": "Based on [count] reviews" },
    { "type": "text", "id": "count_others_text", "label": "Review count line with other cases", "default": "Based on [count] reviews of our cases", "info": "Used when reviews of other cases are shown too." },
    { "type": "text", "id": "trust_note", "label": "Line under the summary", "default": "Reviews from verified buyers only." },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "cvc-reviews", "info": "The stars under the product title link here. Keep it the same as the product section's \"Reviews section anchor\"." },
    {
      "type": "select",
      "id": "scope",
      "label": "On a product page, show",
      "default": "product_and_others",
      "options": [
        { "value": "product_and_others", "label": "Its reviews first, then other cases" },
        { "value": "product", "label": "Only its own reviews" }
      ]
    },
    { "type": "text", "id": "other_label", "label": "Label on other cases' reviews", "default": "Review of" },
    { "type": "text", "id": "verified_label", "label": "Verified badge", "default": "Verified buyer" },
    { "type": "text", "id": "empty_heading", "label": "Heading with no reviews yet", "default": "No reviews yet" },
    { "type": "text", "id": "empty_text", "label": "Text with no reviews yet", "default": "Be the first to tell other shoppers what you think." },
    { "type": "text", "id": "empty_note", "label": "Text with no reviews yet, form off", "default": "Reviews from verified buyers show here." },
    { "type": "header", "content": "Review form" },
    { "type": "paragraph", "content": "Reviews written here go to Judge.me, like reviews from Judge.me's own form. Judge.me emails each reviewer a link to confirm. Once the reviewer's email matches an order, the review is verified and shows on the site. Every review sent appears in the Judge.me app." },
    { "type": "checkbox", "id": "show_form", "label": "Let customers write a review", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Write a review" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Write a review" },
    { "type": "text", "id": "form_intro", "label": "Form intro", "default": "Tell other shoppers how your case fits, feels and holds up." },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Your rating" },
    { "type": "text", "id": "rating_words", "label": "Words for 1 to 5 stars", "default": "Poor|Fair|Good|Great|Excellent", "info": "Five words separated by |" },
    { "type": "text", "id": "title_label", "label": "Title label", "default": "Title" },
    { "type": "text", "id": "optional_label", "label": "Optional tag", "default": "optional" },
    { "type": "text", "id": "text_label", "label": "Review label", "default": "Your review" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "name_hint", "label": "Name hint", "default": "Shown with your review" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email_hint", "label": "Email hint", "default": "Never shown" },
    { "type": "inline_richtext", "id": "privacy_note", "label": "Note above the button", "default": "We'll email you a link to confirm your review. By sending it, you agree to Judge.me's <a href=\"https://judge.me/terms\">terms</a> and <a href=\"https://judge.me/privacy\">privacy policy</a>." },
    { "type": "text", "id": "submit_label", "label": "Send button", "default": "Send review" },
    { "type": "text", "id": "sending_label", "label": "Send button while sending", "default": "Sending…" },
    { "type": "text", "id": "cancel_label", "label": "Cancel button", "default": "Cancel" },
    { "type": "text", "id": "success_heading", "label": "Thank-you heading", "default": "Thank you, [name]!", "info": "[name] is the reviewer's first name." },
    { "type": "text", "id": "confirm_text", "label": "Thank-you text", "default": "Tap the link in the email we sent you to confirm your review. Reviews from verified buyers show here." },
    { "type": "text", "id": "error_text", "label": "Error text", "default": "Your review couldn't be sent. Check your connection and try again." },
    { "type": "header", "content": "Layout" },
