{%- comment -%}
  Casify — Converting PDP: risk reversal.

  Guarantee cards + FAQ accordion (with FAQPage schema) + closing CTA that
  scrolls back to the real buybox.
{%- endcomment -%}

<section class="cv-sec cv-risk" id="cv-faq">

  {%- comment -%} ---------- Guarantee cards ---------- {%- endcomment -%}
  {%- assign has_g = false -%}
  {%- for b in section.blocks -%}{%- if b.type == 'guarantee' -%}{%- assign has_g = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_g -%}
    <div class="cv-guards" data-cv-reveal>
      <div class="cv-sec__hd cv-sec__hd--tight">
        <span class="cv-eyebrow">{{ section.settings.guard_eyebrow | default: 'Section 04 — zero risk' | escape }}</span>
        <h2>{{ section.settings.guard_heading | default: 'Every reason not to buy, removed' | escape }}</h2>
      </div>
      <div class="cv-guards__grid">
        {%- for b in section.blocks -%}
          {%- if b.type == 'guarantee' -%}
            <div class="cv-guard" data-cv-reveal style="--cv-i:{{ forloop.index0 }}" {{ b.shopify_attributes }}>
              <span class="cv-guard__ico">{%- render 'cv-icon', name: b.settings.icon, size: 32, animate: true -%}</span>
              <h3>{{ b.settings.title | escape }}</h3>
              <p>{{ b.settings.body | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
  {%- assign has_faq = false -%}
  {%- for b in section.blocks -%}{%- if b.type == 'faq' -%}{%- assign has_faq = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_faq -%}
    <div class="cv-faq" data-cv-reveal>
      <div class="cv-sec__hd cv-sec__hd--tight">
        <span class="cv-eyebrow">{{ section.settings.faq_eyebrow | default: 'Still deciding?' | escape }}</span>
        <h2>{{ section.settings.faq_heading | default: 'The questions we actually get asked' | escape }}</h2>
      </div>
      <div class="cv-faq__list" data-motion-dev="faq">
        {%- for b in section.blocks -%}
          {%- if b.type == 'faq' -%}
            <details class="cv-faq__item"{% if b.settings.default_open %} open{% endif %} {{ b.shopify_attributes }}>
              <summary class="cv-faq__q">
                <span>{{ b.settings.question | escape }}</span>
                {%- render 'cv-icon', name: 'chevron-down', size: 18, class: 'cv-faq__chev' -%}
              </summary>
              <div class="cv-faq__a">{{ b.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign fi = 0 -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'faq' -%}
            {%- if fi > 0 -%},{%- endif -%}
            {%- assign fi = fi | plus: 1 -%}
            {
              "@type": "Question",
              "name": {{ b.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ b.settings.answer | strip_html | json }} }
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
    </script>
  {%- endif -%}

  {%- comment -%} ---------- Closing CTA ---------- {%- endcomment -%}
  {%- if section.settings.closer_heading != blank -%}
    <div class="cv-closer" data-cv-reveal>
      <span class="cv-closer__stripe" aria-hidden="true"></span>
      <div class="cv-closer__inner">
        {%- if section.settings.closer_eyebrow != blank -%}
          <span class="cv-eyebrow cv-eyebrow--light">{{ section.settings.closer_eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.closer_heading | escape }}</h2>
        {%- if section.settings.closer_body != blank -%}
          <div class="cv-closer__body">{{ section.settings.closer_body }}</div>
        {%- endif -%}

        {%- comment -%}
          On a product page the button scrolls back to the buybox; anywhere
          else (homepage, landing pages) a link is set and it navigates.
        {%- endcomment -%}
        {%- if section.settings.closer_url != blank -%}
          <a class="cv-cta cv-cta--closer" href="{{ section.settings.closer_url }}">
            <span class="cv-cta__shine" aria-hidden="true"></span>
            {%- render 'cv-icon', name: 'bag', size: 19 -%}
            <span>{{ section.settings.closer_cta | default: 'Pick my model' | escape }}</span>
          </a>
        {%- else -%}
          <button type="button" class="cv-cta cv-cta--closer" data-cv-scroll-to-buy>
            <span class="cv-cta__shine" aria-hidden="true"></span>
            {%- render 'cv-icon', name: 'bag', size: 19 -%}
            <span>{{ section.settings.closer_cta | default: 'Pick my model' | escape }}</span>
          </button>
        {%- endif -%}

        {%- assign has_note = false -%}
        {%- for b in section.blocks -%}{%- if b.type == 'closer_note' -%}{%- assign has_note = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_note -%}
          <ul class="cv-closer__notes">
            {%- for b in section.blocks -%}
              {%- if b.type == 'closer_note' -%}
                <li {{ b.shopify_attributes }}>{%- render 'cv-icon', name: 'check', size: 14 -%} {{ b.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Convert — Guarantee & FAQ",
  "settings": [
    { "type": "text", "id": "guard_eyebrow", "label": "Guarantee eyebrow", "default": "Section 04 — zero risk" },
    { "type": "text", "id": "guard_heading", "label": "Guarantee heading", "default": "Every reason not to buy, removed" },
    { "type": "text", "id": "faq_eyebrow", "label": "FAQ eyebrow", "default": "Still deciding?" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "The questions we actually get asked" },
    { "type": "text", "id": "closer_eyebrow", "label": "Closer eyebrow", "default": "One case, one decision" },
    { "type": "text", "id": "closer_heading", "label": "Closer heading", "default": "Protect it before you need to" },
    { "type": "richtext", "id": "closer_body", "label": "Closer body", "default": "<p>A screen repair costs more than five of these. Pick your model and it ships in 1–3 business days.</p>" },
    { "type": "text", "id": "closer_cta", "label": "Closer button label", "default": "Pick my model" },
    { "type": "url", "id": "closer_url", "label": "Closer button link", "info": "Leave empty on a product page — the button then scrolls back to the buybox." }
  ],
  "blocks": [
    { "type": "guarantee", "name": "Guarantee card", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "returns", "label": "Returns" },
        { "value": "warranty-seal", "label": "Warranty" },
        { "value": "drop-shield", "label": "Protection" },
        { "value": "truck-fast", "label": "Shipping" },
        { "value": "lock-secure", "label": "Secure" },
        { "value": "lab", "label": "Lab tested" }
      ], "default": "returns" },
      { "type": "text", "id": "title", "label": "Title", "default": "30 days to change your mind" },
      { "type": "textarea", "id": "body", "label": "Body", "default": "Not the one? Send it back within 30 days of delivery — prepaid return label, full refund." }
    ]},
    { "type": "faq", "name": "FAQ item", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Will it fit my exact model?" },
      { "type": "richtext", "id": "answer", "label": "Answer" },
      { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }
    ]},
    { "type": "closer_note", "name": "Closer note", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on every order" }
    ]}
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Convert — Guarantee & FAQ",
      "blocks": [
        { "type": "guarantee", "settings": { "icon": "returns", "title": "30 days to change your mind", "body": "Not the one? Send it back within 30 days of delivery — prepaid return label, full refund." } },
        { "type": "guarantee", "settings": { "icon": "truck-fast", "title": "Ships in 1–3 business days", "body": "Every order is packed and sent within 1–3 business days, Monday to Friday — and shipping is free." } },
        { "type": "faq", "settings": { "question": "Will it fit my exact model?", "default_open": true, "answer": "<p>Each case is cut from that phone's own CAD file — one mould per model, not a universal shell. Pick your model above and the fit is exact: no gaps at the camera, no rattle, no covered mic.</p>" } },
        { "type": "faq", "settings": { "question": "Does wireless charging still work?", "answer": "<p>Yes, at full speed. The magnet ring is aligned to the MagSafe spec and passes Qi2 25W, MagSafe, and standard Qi. You don't need to take the case off to charge, mount, or use a wallet.</p>" } },
        { "type": "faq", "settings": { "question": "Is it really going to stay clear?", "answer": "<p>The back is UV-stable polycarbonate with a bonded top coat, not soft TPU. In accelerated testing equivalent to three years outdoors we measured no perceptible colour shift.</p>" } },
        { "type": "faq", "settings": { "question": "How thick does it actually feel?", "answer": "<p>2.8 mm across the back and 3.4 mm at the rail, adding about 24 g. That's thinner than a stack of three credit cards — it still slides into a pocket, and the grip texture means it doesn't slip out of your hand.</p>" } },
        { "type": "faq", "settings": { "question": "What if I ordered the wrong model?", "answer": "<p>Message support with your order number and we'll send the right one with a prepaid label for the first. No restocking fee, and you don't pay shipping twice.</p>" } },
        { "type": "faq", "settings": { "question": "Why is a multi-pack cheaper per case?", "answer": "<p>Same case, one shipment. Packing and shipping two or three together costs us less than three separate orders, so the saving goes to you. Most people keep one on the phone and one in a bag or car.</p>" } },
        { "type": "closer_note", "settings": { "text": "Free shipping on every order" } },
        { "type": "closer_note", "settings": { "text": "30-day returns, prepaid" } },
        { "type": "closer_note", "settings": { "text": "Ships in 1–3 business days" } },
        { "type": "closer_note", "settings": { "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}