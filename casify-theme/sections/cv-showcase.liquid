{%- comment -%}
  Casify — showcase cards (Chrismass design system).

  By default the row holds a card for every product in the shop (or in the
  chosen collection), each filled from its own product: photo, price,
  compare-at price, link, phone and color counts, a saving or "new" badge,
  and stars only when a review app has written a rating. Cards added as
  blocks come first, in block order, and carry copy written for that
  product (short title, one line, two features); every other product
  follows with copy read off its title and tags. Markup per card:
  snippets/cv-showcase-card.liquid.

  With more than three cards the row becomes a swipeable rail with
  previous/next buttons and a progress bar (assets/cv-showcase-motion.js;
  the rail works without GSAP). Cards are dealt onto the counter from one
  stack, the photo opens like a shop-window display, the badge stamps down
  and the enamel CTA assembles last. Styles: assets/cv-showcase.css (loads
  after theme.css, so it wins the cascade on the shared .cv-showcase
  selectors; card internals live under the cvsh- prefix).

  "Only the cards below" keeps the original hand-written cards, for a card
  without a product.

  With no cards at all (an empty shop or collection) shoppers see nothing,
  not a "0 pieces" heading over an empty counter; the theme editor shows a
  hint instead.
{%- endcomment -%}

{%- liquid
  assign coll = section.settings.collection | default: collections.all
  assign limit = section.settings.limit | default: 50
  # Products without a photo yet (a catalogue still syncing) are left out of the counter.
  assign pictured = coll.products | where: 'featured_image'
  assign shown = ','
  assign total = 0
-%}
{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'card' and total < limit -%}
      {%- liquid
        assign bp = block.settings.product
        assign skip = false
        if bp != blank
          assign key = bp.id | prepend: ',' | append: ','
          if shown contains key
            assign skip = true
          else
            assign shown = shown | append: bp.id | append: ','
          endif
        elsif section.settings.source == 'products'
          assign skip = true
        endif
      -%}
      {%- unless skip -%}
        {%- render 'cv-showcase-card', item: bp, block: block, index: total, sid: section.id, cta_label: section.settings.cta_label, sale_badge: section.settings.sale_badge, new_badge: section.settings.new_badge -%}
        {%- assign total = total | plus: 1 -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if section.settings.source == 'products' -%}
    {%- for item in pictured -%}
      {%- if total >= limit -%}{%- break -%}{%- endif -%}
      {%- assign key = item.id | prepend: ',' | append: ',' -%}
      {%- unless shown contains key -%}
        {%- assign shown = shown | append: item.id | append: ',' -%}
        {%- render 'cv-showcase-card', item: item, index: total, sid: section.id, cta_label: section.settings.cta_label, sale_badge: section.settings.sale_badge, new_badge: section.settings.new_badge -%}
        {%- assign total = total | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if total > 0 -%}
{{ 'cv-showcase.css' | asset_url | stylesheet_tag }}
<section class="cv-sec cv-showcase cvsh{% if total > 3 %} cvsh--rail{% endif %}" data-cvsh data-section-id="{{ section.id }}">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="cv-row__hd" data-cv-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="cv-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 data-cv-split id="cvshTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="cv-sec__lede">{{ section.settings.subheading | replace: '[count]', total }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.source == 'products' -%}
        <a class="cv-row__all" href="{{ coll.url | default: routes.all_products_collection_url }}">
          <span>{{ section.settings.link_label | escape }}</span>
          {%- render 'cv-icon', name: 'arrow-right', size: 15 -%}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if total > 3 -%}
    <div class="cvsh__rail" role="region" aria-roledescription="carousel"{% if section.settings.heading != blank %} aria-labelledby="cvshTitle-{{ section.id }}"{% else %} aria-label="Cases"{% endif %}>
      <ul class="cvsh__row" role="list" data-cvsh-row>{{ cards }}</ul>
      <div class="cvsh__bar" data-cvsh-bar>
        <div class="cvsh__track" aria-hidden="true"><span class="cvsh__thumb" data-cvsh-thumb></span></div>
        <p class="cvsh__count" data-cvsh-count data-total="{{ total }}">1 to 3 of {{ total }}</p>
        <div class="cvsh__nav">
          <button type="button" class="cvsh__btn" data-cvsh-prev aria-label="Previous cases" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button type="button" class="cvsh__btn" data-cvsh-next aria-label="Next cases">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
  {%- else -%}
    <ul class="cvsh__row" role="list" data-cvsh-row>{{ cards }}</ul>
  {%- endif -%}
</section>
{%- elsif request.design_mode -%}
<section class="cv-sec">
  <div class="cv-empty">
    <span class="cv-empty__ico">{%- render 'cv-icon', name: 'precision-fit', size: 36 -%}</span>
    <h2>No cases to show yet</h2>
    <p>Add products to the shop or the chosen collection, or add cards with a product. Shoppers don't see this section until it has a card.</p>
  </div>
</section>
{%- endif -%}

