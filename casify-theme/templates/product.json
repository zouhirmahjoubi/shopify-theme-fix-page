    "guarantee": {
      "type": "cv-pdp-guarantee",
      "blocks": {
        "q-ship": {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Each case is printed after you order, which takes up to 10 business days. In the United States it then arrives in 2 to 5 business days. Shipping is free.</p>",
            "default_open": true
          }
        },
        "q-returns": {
          "type": "faq",
          "settings": {
            "question": "Can I send it back?",
            "answer": "<p>Cases are printed for your order, so we don't take returns for a change of mind. If yours arrives damaged, misprinted or wrong, write to us within 30 days and we send a new one or refund you.</p>",
            "default_open": false
          }
        },
        "q-packs": {
          "type": "faq",
          "settings": {
            "question": "How do pack prices work?",
            "answer": "<p>With 2 cases in your bag each one is 18% off, and with 3 or more each one is 31% off. The saving comes off automatically at checkout, so the total on your button is what the cases cost, before any tax.</p>",
            "default_open": false
          }
        },
        "q-buy": {
          "type": "faq",
          "settings": {
            "question": "What does Buy now do?",
            "answer": "<p>It puts the case and pack you chose in your bag and takes you straight to checkout. Add to bag keeps you shopping instead.</p>",
            "default_open": false
          }
        },
        "q-model": {
          "type": "faq",
          "settings": {
            "question": "How do I check my phone model?",
            "answer": "<p>On an iPhone, open Settings, then General, then About, and look for Model Name. On a Samsung, open Settings, then About phone.</p>",
            "default_open": false
          }
        },
        "q-fit": {
          "type": "faq",
          "settings": {
            "question": "Will it fit my phone?",
            "answer": "<p>Pick your phone in the Model list. It only shows the models this case is made for.</p>",
            "default_open": false
          }
        },
        "g-ship": {
          "type": "promise",
          "settings": {
            "icon": "truck-fast",
            "title": "Free shipping",
            "body": "on every order, with no minimum"
          }
        },
        "g-returns": {
          "type": "promise",
          "settings": {
            "icon": "returns",
            "title": "Damage covered",
            "body": "free replacement or refund"
          }
        },
        "g-dispatch": {
          "type": "promise",
          "settings": {
            "icon": "clock",
            "title": "Printed to order",
            "body": "in the USA, shipped with tracking"
          }
        },
        "g-packs": {
          "type": "promise",
          "settings": {
            "icon": "price-tag",
            "title": "Pack savings at checkout",
            "body": "18% off each with 2 cases, 31% with 3"
          }
        }
      },
