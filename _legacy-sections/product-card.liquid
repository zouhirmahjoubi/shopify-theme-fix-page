<article class="cm-card">
  <a href="{{ product.url }}" class="cm-card__media">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" style="width:100%;height:100%;object-fit:cover;display:block">
    {%- endif -%}
    {%- if product.compare_at_price and product.compare_at_price > product.price -%}
      <span class="cm-stamp cm-stamp--card">Sale</span>
    {%- endif -%}
  </a>
  <div class="cm-card__body">
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    <div class="cm-card__price">
      {{ product.price | money }}
      {%- if product.compare_at_price and product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
    <form method="post" action="{{ routes.cart_add_url }}" data-cart-add-form>
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="btn btn--ghost cm-press">Add to bag</button>
    </form>
  </div>
</article>

<style>
  .cm-card{display:flex;flex-direction:column;background:var(--cream-50);border:1px solid var(--border-hairline);border-radius:14px;overflow:hidden;box-shadow:var(--shadow-xs);transition:transform var(--duration-base) var(--ease-candy),box-shadow var(--duration-base) var(--ease-standard)}
  .cm-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
  .cm-card__media{position:relative;display:block;aspect-ratio:1;background:var(--cream-100)}
  .cm-card__media img{width:100%;height:100%;object-fit:cover;display:block}
  .cm-stamp--card{position:absolute;top:12px;right:12px}
  .cm-card__body{padding:14px;display:flex;flex-direction:column;gap:8px}
  .cm-card__body h3{margin:0;font:700 16px/1.25 var(--font-display);color:var(--cocoa-600)}
  .cm-card__price{font:700 18px var(--font-display);color:var(--red-600)}
  .cm-card__price s{color:var(--cocoa-500);font-size:13px;font-weight:400;margin-left:6px}
</style>
