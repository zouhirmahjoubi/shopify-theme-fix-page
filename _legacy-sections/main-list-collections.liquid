<div class="cm-container" data-cm-reveal>
  <h1 style="font:800 clamp(28px,4vw,52px)/1.05 var(--font-display);color:var(--red-600);text-transform:uppercase;letter-spacing:-.03em;margin:0 0 24px">All collections</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px">
    {%- for col in collections -%}
      <a href="{{ col.url }}" style="background:var(--cream-50);border:1px solid var(--border-hairline);border-radius:14px;overflow:hidden;color:var(--cocoa-600)">
        {%- if col.featured_image -%}<img src="{{ col.featured_image | image_url: width: 600 }}" alt="{{ col.title | escape }}" loading="lazy" width="{{ col.featured_image.width }}" height="{{ col.featured_image.height }}" style="width:100%;height:160px;object-fit:cover;display:block">{%- endif -%}
        <div style="padding:14px">
          <h3 style="font:700 16px/1.3 var(--font-display);margin:0 0 4px">{{ col.title | escape }}</h3>
          <p style="font:700 10px var(--font-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--red-500);margin:0">{{ col.products_count }} products</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "List collections", "presets": [{ "name": "List collections" }] }
{% endschema %}
