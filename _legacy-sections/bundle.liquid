<section style="max-width:var(--max);margin:32px auto 0;padding:0 24px" data-cm-reveal>
  <h2 class="cm-section-title"><small>{{ section.settings.eyebrow | default: 'Pair it with' }}</small>{{ section.settings.heading | default: 'Complete the set' }}</h2>
  <div class="bundle cm-stagger-cm">
    {%- for block in section.blocks -%}
      <div class="card" {{ block.shopify_attributes }}>
        {%- if block.settings.badge != blank -%}<span class="stamp">{{ block.settings.badge }}</span>{%- endif -%}
        <h4>{{ block.settings.title }}</h4>
        <p>{{ block.settings.body }}</p>
        <div class="price">${{ block.settings.price }}{%- if block.settings.compare != blank -%} <s>${{ block.settings.compare }}</s>{%- endif -%}</div>
        <form method="post" action="{{ routes.cart_add_url }}" data-cart-add-form style="margin-top:8px">
          <input type="hidden" name="id" value="{{ block.settings.variant_id }}">
          <button type="submit" class="btn {% if block.settings.tone == 'teal' %}btn--teal{% elsif block.settings.tone == 'ghost' %}btn--ghost{% endif %} cm-press btn--block">{% if block.settings.tone == 'ghost' %}In bag{% else %}Add bundle &middot; ${{ block.settings.price }}{% endif %}</button>
        </form>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundle upsell",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pair it with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the set"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Phone case only"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "The Peppermint Cream. MagSafe ready."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "34"
        },
        {
          "type": "text",
          "id": "compare",
          "label": "Compare price (optional)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)"
        },
        {
          "type": "text",
          "id": "tone",
          "label": "Button tone",
          "info": "leave blank for red, 'teal' for teal, 'ghost' for cream"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Shopify variant ID"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bundle upsell",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Phone case only",
            "body": "The Peppermint Cream. MagSafe ready.",
            "price": "34",
            "variant_id": ""
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Case + charging puck",
            "body": "Matching cocoa MagSafe charger, 15W.",
            "price": "58",
            "compare": "66",
            "badge": "Most popular",
            "variant_id": ""
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Case + tin of 12 sweets",
            "body": "Peppermint creams, hand-tied ribbon.",
            "price": "62",
            "compare": "70",
            "tone": "teal",
            "variant_id": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
