<div class="cm-container" data-cm-reveal>
  <h1 style="font:800 clamp(28px,4vw,52px)/1.05 var(--font-display);color:var(--red-600);text-transform:uppercase;letter-spacing:-.03em;margin:0 0 24px">{{ blog.title | escape }}</h1>
  {%- if blog.articles.size > 0 -%}
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
      {%- for article in blog.articles -%}
        <article style="background:var(--cream-50);border:1px solid var(--border-hairline);border-radius:14px;overflow:hidden">
          {%- if article.image -%}<a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}" style="width:100%;height:180px;object-fit:cover;display:block"></a>{%- endif -%}
          <div style="padding:18px">
            <h3 style="font:700 18px/1.3 var(--font-display);margin:0 0 8px"><a href="{{ article.url }}" style="color:var(--cocoa-600)">{{ article.title | escape }}</a></h3>
            <p style="font:700 10px var(--font-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--red-500);margin:0">{{ article.published_at | date: '%b %d, %Y' }}</p>
            <p style="font-size:14px;color:var(--cocoa-500);line-height:1.55;margin:10px 0 0">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p style="color:var(--cocoa-500)">No posts yet.</p>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Blog", "presets": [{ "name": "Blog" }] }
{% endschema %}
