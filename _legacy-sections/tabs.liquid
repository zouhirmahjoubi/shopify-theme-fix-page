<nav class="tabs" role="tablist">
  {%- for block in section.blocks -%}
    <button class="tab{% if forloop.first %} is-active{% endif %}" data-tab="{{ block.settings.key | handleize }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>
  {%- endfor -%}
</nav>
<div class="tab-panels" style="max-width:var(--max);margin:0 auto;padding:0 24px">
  {%- for block in section.blocks -%}
    <div class="tab-panel" data-panel="{{ block.settings.key | handleize }}" {% unless forloop.first %}hidden{% endunless %}>
      <div style="padding:24px 0;color:var(--cocoa-600);font-size:15px;line-height:1.6;max-width:70ch">{{ block.settings.content }}</div>
    </div>
  {%- endfor -%}
</div>

<script>
  (function(){
    var tabs = document.querySelectorAll('.tab[data-tab]');
    var panels = document.querySelectorAll('.tab-panel[data-panel]');
    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){
        tabs.forEach(function(t){ t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        panels.forEach(function(p){ p.hidden = p.getAttribute('data-panel') !== tab.getAttribute('data-tab'); });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Tabs",
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Key (lowercase)",
          "default": "description"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "key": "description",
            "title": "Description",
            "content": "<p>A candy-striped case screen-printed on a 1.2mm matte polycarbonate shell. The print sits under a 0.2mm UV-cured top coat, so it won't scratch, fade or peel. MagSafe ready with a built-in N52 neodymium ring.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "key": "specs",
            "title": "Specs",
            "content": "<p>Material: 30% post-consumer polycarbonate, TPU frame. Drop rating: 6ft (MIL-STD-810G). MagSafe: N52 magnet array. Compatibility: iPhone 15 Pro (and many more).</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "key": "care",
            "title": "Care",
            "content": "<p>Wipe with a soft damp cloth. Don't use solvents, bleach, or abrasives. The print is sealed under a top coat and should outlast the phone.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
