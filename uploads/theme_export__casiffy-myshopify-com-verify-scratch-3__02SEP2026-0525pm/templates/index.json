    "faq": {
      "type": "faq",
      "settings": {},
      "blocks": {
        "block-0": {
          "type": "question",
          "settings": {
            "question": "Will the print scratch off?",
            "answer": "<p>The print sits under a 0.2mm UV-cured top coat. It won't flake, peel, or scratch off in normal use. If it does, the case is replaced under the 1-year warranty — no photos needed.</p>"
          }
        },
        "block-1": {
          "type": "question",
          "settings": {
            "question": "Is it compatible with my phone?",
            "answer": "<p>iPhone 14, 15, 15 Pro, 15 Pro Max and SE (3rd gen) for now. Pixel 9 and Galaxy S25 are in the queue — sign up below to be told when.</p>"
          }
        },
        "block-2": {
          "type": "question",
          "settings": {
            "question": "How fast does it ship?",
            "answer": "<p>US orders ship the next business day from Brooklyn. Free over $40; $4 otherwise. Arrives in 3–5 business days. International to 14 countries.</p>"
          }
        },
        "block-3": {
          "type": "question",
          "settings": {
            "question": "What's the return policy?",
            "answer": "<p>30 days, no questions asked. The case has to come back in its sleeve — that's the only condition. We'll send a return label by email.</p>"
          }
        },
        "block-4": {
          "type": "question",
          "settings": {
            "question": "Where is it made?",
            "answer": "<p>Designed in Brooklyn, printed and assembled in a partner shop in Porto. The shells are made from 30% recycled polycarbonate sourced in the EU.</p>"
          }
        }
      },
