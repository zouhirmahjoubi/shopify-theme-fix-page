    "tabs": {
      "type": "tabs",
      "settings": {},
      "blocks": {
        "block-0": {
          "type": "tab",
          "settings": {
            "key": "description",
            "title": "Description",
            "content": "<p>A candy-striped case screen-printed on a 1.2mm matte polycarbonate shell. The print sits under a 0.2mm UV-cured top coat, so it won't scratch, fade or peel. MagSafe ready with a built-in N52 neodymium ring.</p>"
          }
        },
        "block-1": {
          "type": "tab",
          "settings": {
            "key": "specs",
            "title": "Specs",
            "content": "<p>Material: 30% post-consumer polycarbonate, TPU frame. Drop rating: 6ft (MIL-STD-810G). MagSafe: N52 magnet array. Compatibility: iPhone 15 Pro (and many more).</p>"
          }
        },
        "block-2": {
          "type": "tab",
          "settings": {
            "key": "care",
            "title": "Care",
            "content": "<p>Wipe with a soft damp cloth. Don't use solvents, bleach, or abrasives. The print is sealed under a top coat and should outlast the phone.</p>"
          }
        }
      },
      "block_order": [
        "block-0",
        "block-1",
        "block-2"
      ]
    },
