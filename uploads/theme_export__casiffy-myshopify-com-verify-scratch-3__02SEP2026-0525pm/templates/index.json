    "reviews": {
      "type": "reviews",
      "settings": {},
      "blocks": {
        "block-0": {
          "type": "review",
          "settings": {
            "stars": 5,
            "body": "Looks exactly like the banner on the website. Dropped it twice on the kitchen tiles, came away with nothing. The print is sharp and the cream is the right cream — not that plasticky off-white.",
            "name": "Margaret W.",
            "date": "3 days ago",
            "device": "iPhone 15 Pro",
            "colour": "Candy stripe"
          }
        },
        "block-1": {
          "type": "review",
          "settings": {
            "stars": 5,
            "body": "MagSafe wallet snaps on, charges fine through it. The candy stripes line up cleanly — no halftone, no faded edges. Feels like a tin, not a wrapper.",
            "name": "Devon P.",
            "date": "1 week ago",
            "device": "iPhone 15 Pro Max",
            "colour": "Teal counter",
            "bg": "var(--teal-100)",
            "color": "var(--teal-600)"
          }
        },
        "block-2": {
          "type": "review",
          "settings": {
            "stars": 4,
            "body": "The Gold ticket colour is exactly the colour of the foil on the tin. Wish I'd ordered the matching tin too, going back for the bundle. Tiny gripe: the case is a touch slicker than I expected.",
            "name": "Saoirse L.",
            "date": "2 weeks ago",
            "device": "iPhone 15",
            "colour": "Gold ticket",
            "bg": "var(--gold-200)",
            "color": "var(--cocoa-600)"
          }
        }
      },
