{% assign current_variant = product.selected_or_first_available_variant %}
<nav class="crumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a><span class="sep">&middot;</span>
  <a href="{{ routes.all_products_collection_url }}">Shop</a><span class="sep">&middot;</span>
  <a href="{{ product.url }}">{{ product.type | default: 'Phone cases' }}</a><span class="sep">&middot;</span>
  <span style="color:var(--red-600)">{{ product.title | escape }}</span>
</nav>

<main class="pdp cm-page-in" id="pdp" data-product-json="{{ product.variants | json | escape }}">
  <section class="gallery">
    <div class="gallery__thumbs cm-stagger-cm" id="thumbs">
      {%- for image in product.images limit: 8 -%}
        <div class="cm-thumb{% if forloop.first %} is-active{% endif %}" data-full-src="{{ image | image_url: width: 900 }}" aria-label="{{ image.alt | default: product.title | escape }}">
          <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" width="80" height="80" loading="lazy">
        </div>
      {%- endfor -%}
    </div>

    <div class="gallery__main cm-product-hero" id="mainArt">
      <button class="heart" aria-label="Save">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 7.6a5 5 0 0 0-8.8-3.2 5 5 0 0 0-8.8 3.2c0 5 8.8 11 8.8 11s8.8-6 8.8-11z"/></svg>
      </button>
      <div class="case-art" id="caseArt">
        {%- if product.featured_image -%}
          <img id="mainProductImage" src="{{ current_variant.featured_image | default: product.featured_image | image_url: width: 900 }}" alt="{{ current_variant.featured_image.alt | default: product.featured_image.alt | default: product.title | escape }}" width="900" height="900" loading="eager">
        {%- endif -%}
      </div>
      <span class="zoom-hint">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M11 8v6M8 11h6"/></svg>
        Hover to zoom
      </span>
    </div>
  </section>

  <aside class="info cm-product-hero" style="animation-delay:80ms">
    <p class="eyebrow">Phone case &middot; {{ product.type | default: 'Premium protection' }}</p>
    <h1>{{ product.title | escape }}</h1>
    <p class="sub">{{ section.settings.subtitle | default: "A candy-striped case that wears well, drops well, and looks like the shop window." }}</p>

    <div class="rating-row">
      <span style="color:var(--gold-400);font-size:14px;letter-spacing:2px">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <a href="#reviews">4.9 &middot; 1,284 reviews</a>
      <span style="color:var(--cocoa-300)">&middot;</span>
      <span style="font-family:var(--font-label);font-size:10px;letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--teal-600)">1k+ bought this week</span>
    </div>

    <div class="price-row">
      <span class="price" id="priceMain">{{ current_variant.price | money }}</span>
      {%- if current_variant.compare_at_price and current_variant.compare_at_price > current_variant.price -%}
        <s id="priceCompare">{{ current_variant.compare_at_price | money }}</s>
        <span class="save" id="priceSave">Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}</span>
      {%- endif -%}
    </div>

    <div class="desc">{{ product.description | default: "Matte polycarbonate shell, 1.2mm raised lip around the camera, 6ft drop tested, wireless-charge ready. Prints don't fade; the case does the heavy lifting." }}</div>

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        {%- assign selected_value = current_variant.options[forloop.index0] -%}
        <div class="picker" data-option-picker data-option-index="{{ forloop.index0 }}">
          <div class="lbl"><span>{{ option.name }}</span><span class="selected" data-option-selected-label>{{ selected_value }}</span></div>
          <div class="chips">
            {%- for value in option.values -%}
              <button type="button" class="chip{% if value == selected_value %} is-selected{% endif %}" data-option-value="{{ value | escape }}">{{ value }}</button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endunless -%}

    <div class="stock-row" id="variantStockRow"></div>
    <div class="scarcity"><div id="variantScarcityFill" style="width:0%;height:6px;border-radius:3px;background:var(--red-500)"></div></div>

    <div class="qty-row">
      <span class="lbl">Qty</span>
      <div class="cm-stepper" id="stepper">
        <button id="qtyMinus" aria-label="Decrease" type="button">&minus;</button>
        <span class="cm-qty-value" id="qtyVal">1</span>
        <button id="qtyPlus" aria-label="Increase" type="button">+</button>
      </div>
    </div>

    <form method="post" action="{{ routes.cart_add_url }}" id="addToCartForm" data-cart-add-form>
      <input type="hidden" name="id" id="selectedVariantId" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" id="selectedQty" value="1">
      <div class="cta-row">
        <button type="submit" class="btn btn--block cm-add-btn cm-press" id="addBtn"{% unless current_variant.available %} disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
          <span id="addBtnLabel">{% if current_variant.available %}Add to bag &middot; {{ current_variant.price | money }}{% else %}Sold out{% endif %}</span>
        </button>
        <button type="button" class="btn btn--ghost cm-press" aria-label="Buy now" id="buyBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </form>

    <div id="addPillHost" style="min-height:24px;margin-top:6px"></div>

    <div class="micro">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M16 14a4 4 0 0 1-8 0"/><path d="M8 6V4a4 4 0 0 1 8 0v2"/></svg>
      <span>Free US shipping over $40 &middot; arrives 3&ndash;5 days</span>
    </div>

    <div class="pay-row">
      <span class="lbl">Pay with</span>
      <span class="pill">Visa</span>
      <span class="pill">Mastercard</span>
      <span class="pill">Amex</span>
      <span class="pill">Apple Pay</span>
      <span class="pill">Shop Pay</span>
      <span class="pill">Klarna</span>
    </div>
  </aside>
</main>

<div class="sticky-atb" id="stickyAtb">
  <div>
    <div style="font-family:var(--font-label);font-size:10px;letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--cocoa-500)">{{ product.title | escape }}</div>
    <div class="price" id="stickyPrice">{{ current_variant.price | money }}</div>
  </div>
  <button type="button" class="btn cm-add-btn cm-press" id="addBtnMobile"{% unless current_variant.available %} disabled{% endunless %}>Add to bag</button>
</div>

<script>
(function () {
  var pdp = document.getElementById('pdp');
  if (!pdp) return;
  var variants;
  try { variants = JSON.parse(pdp.dataset.productJson); } catch (e) { variants = []; }
  var selected = {{ current_variant.options | json }};
  var qty = 1;

  function money(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
  }
  function pulse(el) {
    if (!el) return;
    el.classList.remove('cm-price-pulse');
    void el.offsetWidth;
    el.classList.add('cm-price-pulse');
  }
  function findVariant(sel) {
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i], match = true;
      for (var j = 0; j < sel.length; j++) { if (v.options[j] !== sel[j]) { match = false; break; } }
      if (match) return v;
    }
    return null;
  }
  function setStock(variant) {
    var row = document.getElementById('variantStockRow');
    var fill = document.getElementById('variantScarcityFill');
    if (!row || !fill) return;
    if (!variant || !variant.available) {
      row.innerHTML = '<span class="low" style="color:var(--cocoa-500)">This combination is unavailable.</span>';
      fill.style.width = '100%'; fill.style.background = 'var(--cocoa-500)';
      return;
    }
    var qty = variant.inventory_quantity;
    if (typeof qty !== 'number' || variant.inventory_policy === 'continue') {
      row.innerHTML = '<span class="dot-live"></span><span class="low">In stock</span>';
      fill.style.width = '30%'; fill.style.background = 'var(--red-500)';
      return;
    }
    if (qty <= 0) {
      row.innerHTML = '<span class="low" style="color:var(--cocoa-500)">Out of stock.</span>';
      fill.style.width = '100%'; fill.style.background = 'var(--cocoa-500)';
    } else {
      var scarcity = Math.min(100, Math.max(8, 100 - qty * 4));
      row.innerHTML = '<span class="dot-live"></span><span class="low">In stock &middot; only ' + qty + ' left</span>';
      fill.style.width = scarcity + '%'; fill.style.background = 'var(--red-500)';
    }
  }
  function updateUI(variant) {
    var idInput = document.getElementById('selectedVariantId');
    var addBtn = document.getElementById('addBtn');
    var addBtnMobile = document.getElementById('addBtnMobile');
    var addBtnLabel = document.getElementById('addBtnLabel');
    var priceMain = document.getElementById('priceMain');
    var priceCompare = document.getElementById('priceCompare');
    var priceSave = document.getElementById('priceSave');
    var stickyPrice = document.getElementById('stickyPrice');
    var mainImg = document.getElementById('mainProductImage');

    setStock(variant);

    if (!variant) {
      if (idInput) idInput.value = '';
      if (addBtn) { addBtn.disabled = true; }
      if (addBtnMobile) { addBtnMobile.disabled = true; }
      if (addBtnLabel) addBtnLabel.textContent = 'Unavailable';
      return;
    }

    if (idInput) idInput.value = variant.id;
    if (addBtn) addBtn.disabled = !variant.available;
    if (addBtnMobile) addBtnMobile.disabled = !variant.available;
    if (addBtnLabel) addBtnLabel.textContent = variant.available ? ('Add to bag · ' + money(variant.price * qty)) : 'Sold out';
    if (priceMain) { priceMain.textContent = money(variant.price); pulse(priceMain); }
    if (stickyPrice) stickyPrice.textContent = money(variant.price * qty);
    if (priceCompare && priceSave) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        priceCompare.textContent = money(variant.compare_at_price);
        priceSave.textContent = 'Save ' + money(variant.compare_at_price - variant.price);
        priceCompare.style.display = ''; priceSave.style.display = '';
      } else {
        priceCompare.style.display = 'none'; priceSave.style.display = 'none';
      }
    }
    if (mainImg && variant.featured_image && variant.featured_image.src) {
      mainImg.src = variant.featured_image.src;
      var thumb = pdp.querySelector('.cm-thumb[data-full-src="' + variant.featured_image.src + '"]');
      if (thumb) {
        pdp.querySelectorAll('.cm-thumb').forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      }
    }
  }

  pdp.querySelectorAll('[data-option-picker]').forEach(function (picker) {
    var idx = parseInt(picker.getAttribute('data-option-index'), 10);
    var label = picker.querySelector('[data-option-selected-label]');
    picker.querySelectorAll('.chip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        picker.querySelectorAll('.chip').forEach(function (b) { b.classList.remove('is-selected'); });
        btn.classList.add('is-selected');
        selected[idx] = btn.getAttribute('data-option-value');
        if (label) label.textContent = selected[idx];
        updateUI(findVariant(selected));
      });
    });
  });

  pdp.querySelectorAll('.cm-thumb[data-full-src]').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      pdp.querySelectorAll('.cm-thumb').forEach(function (t) { t.classList.remove('is-active'); });
      thumb.classList.add('is-active');
      var mainImg = document.getElementById('mainProductImage');
      if (mainImg) mainImg.src = thumb.getAttribute('data-full-src');
    });
  });

  // Independent qty counter (theme.js's bindStepper only handles the visual
  // #qtyVal text + bump animation; this keeps the real hidden cart-form
  // field and every price total in sync with it without touching that code).
  var qtyMinus = document.getElementById('qtyMinus');
  var qtyPlus = document.getElementById('qtyPlus');
  var qtyHidden = document.getElementById('selectedQty');
  function syncQty() {
    if (qtyHidden) qtyHidden.value = qty;
    updateUI(findVariant(selected));
  }
  if (qtyMinus) qtyMinus.addEventListener('click', function () { if (qty > 1) { qty--; syncQty(); } });
  if (qtyPlus) qtyPlus.addEventListener('click', function () { qty++; syncQty(); });

  setStock(findVariant(selected));
})();
</script>

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "A candy-striped case that wears well, drops well, and looks like the shop window." }
  ],
  "presets": [{ "name": "Main product" }]
}
{% endschema %}
