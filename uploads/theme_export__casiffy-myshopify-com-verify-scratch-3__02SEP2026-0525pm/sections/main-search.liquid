<div class="cm-container" data-cm-reveal>
  <h1 style="font:800 clamp(28px,4vw,52px)/1.05 var(--font-display);color:var(--red-600);text-transform:uppercase;letter-spacing:-.03em;margin:0 0 24px">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;max-width:600px;margin-bottom:24px">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search sweets, gifts, and flavours" style="flex:1;height:48px;padding:0 16px;border:1.5px solid var(--border-hairline);border-radius:5px;background:#fff;font-size:15px">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="btn" style="width:auto;padding:0 24px;min-height:48px">Search</button>
  </form>
  {%- if search.performed -%}
    <p style="font:700 11px var(--font-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--cocoa-500);margin:0 0 18px">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {%- render 'product-card', product: item -%}
        {%- else -%}
          <a href="{{ item.url }}" style="background:var(--cream-50);border:1px solid var(--border-hairline);border-radius:14px;padding:14px;color:var(--cocoa-600)">
            <h3 style="font:700 16px/1.3 var(--font-display);margin:0">{{ item.title | escape }}</h3>
            <p style="font:700 10px var(--font-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--cocoa-500);margin:6px 0 0">{{ item.object_type }}</p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search", "presets": [{ "name": "Search" }] }
{% endschema %}
