<div class="cm-container" data-cm-reveal style="max-width:760px;margin:0 auto">
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}" style="width:100%;height:auto;border-radius:14px;margin-bottom:24px">
  {%- endif -%}
  <p style="font:700 10px var(--font-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--red-500);margin:0 0 12px">{{ article.published_at | date: '%B %d, %Y' }} &middot; {{ article.author }}</p>
  <h1 style="font:800 clamp(28px,4vw,52px)/1.05 var(--font-display);color:var(--red-600);text-transform:uppercase;letter-spacing:-.03em;margin:0 0 18px">{{ article.title | escape }}</h1>
  <div class="rte" style="color:var(--cocoa-600);font-size:16px;line-height:1.65">{{ article.content }}</div>
</div>

{% schema %}
{ "name": "Article", "presets": [{ "name": "Article" }] }
{% endschema %}
