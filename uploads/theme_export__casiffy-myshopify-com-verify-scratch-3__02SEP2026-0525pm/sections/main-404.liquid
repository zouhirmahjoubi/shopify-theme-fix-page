<div class="cm-container" data-cm-reveal style="text-align:center;max-width:540px;margin:80px auto">
  <h1 style="font:800 clamp(48px,8vw,96px)/1 var(--font-display);color:var(--red-500);margin:0 0 8px;letter-spacing:-.03em">404</h1>
  <h2 style="font:800 28px var(--font-display);color:var(--cocoa-600);text-transform:uppercase;margin:0 0 12px;letter-spacing:-.02em">Lost in the candy shop</h2>
  <p style="font-size:16px;color:var(--cocoa-500);line-height:1.6;margin:0 0 24px">The page you're after has rolled out the door. Let's get you back to the counter.</p>
  <a href="{{ routes.root_url }}" class="btn" style="text-decoration:none;width:auto;display:inline-flex">Back to the candy shop</a>
</div>

{% schema %}
{ "name": "404", "presets": [{ "name": "404" }] }
{% endschema %}
