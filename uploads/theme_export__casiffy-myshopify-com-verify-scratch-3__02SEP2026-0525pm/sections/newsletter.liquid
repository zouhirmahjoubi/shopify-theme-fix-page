<section class="newsletter-band" data-cm-reveal>
  <div class="newsletter-band__inner">
    <div class="newsletter-band__copy">
      <span class="tick">{{ section.settings.eyebrow | default: 'Join the list' }}</span>
      <h2>{{ section.settings.heading | default: 'Get 10% off your first order' }}</h2>
      <p>{{ section.settings.body | default: 'New drops, restocks, and the occasional sweet deal — no spam, unsubscribe anytime.' }}</p>
    </div>

    <div class="newsletter-band__form-wrap">
      {%- form 'customer', class: 'newsletter-band__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter-band__success" role="status">{{ section.settings.success_message | default: "You're in! Use code WELCOME10 at checkout for 10% off." }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="newsletter-band__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
          <input
            type="email"
            id="NewsletterEmail-{{ section.id }}"
            name="contact[email]"
            class="cm-input newsletter-band__input"
            placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
            required
            autocomplete="email"
          >
          <button type="submit" class="btn cm-press newsletter-band__btn">{{ section.settings.button_label | default: 'Get my code' }}</button>
        {%- endif -%}
      {%- endform -%}
      <p class="newsletter-band__fine">{{ section.settings.fine_print | default: 'By signing up you agree to receive marketing emails.' }}</p>
    </div>
  </div>
</section>

<style>
  .newsletter-band {
    background: var(--cocoa-700);
    background-image: repeating-linear-gradient(90deg, var(--red-500) 0 18px, var(--cocoa-700) 18px 36px);
    background-size: 100% 6px;
    background-position: top left;
    background-repeat: no-repeat;
    padding: 56px 0;
  }
  .newsletter-band__inner {
    max-width: var(--max); margin: 0 auto; padding: 0 24px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center;
  }
  .newsletter-band__copy .tick { display: block; color: var(--gold-300); font-family: var(--font-label); font-size: 11px; letter-spacing: var(--tracking-label); text-transform: uppercase; margin-bottom: 10px; }
  .newsletter-band__copy h2 { font-family: var(--font-display); color: var(--cream-50); font-size: clamp(26px, 3.2vw, 38px); font-weight: 800; letter-spacing: -.02em; margin: 0 0 10px; }
  .newsletter-band__copy p { color: var(--cream-200); font-size: 15px; line-height: 1.55; margin: 0; max-width: 44ch; }
  .newsletter-band__form { display: flex; gap: 10px; }
  .newsletter-band__input { background: var(--cream-50); border-radius: 8px; padding: 13px 16px; font-size: 15px; flex: 1; min-width: 0; }
  .newsletter-band__btn { width: auto; padding: 0 22px; white-space: nowrap; }
  .newsletter-band__fine { color: var(--cream-200); opacity: .7; font-size: 11.5px; margin: 10px 0 0; }
  .newsletter-band__success { color: var(--gold-300); font-family: var(--font-display); font-weight: 700; font-size: 18px; margin: 0; }
  .newsletter-band__error { color: var(--red-300); font-weight: 600; font-size: 13px; margin: 0 0 8px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (max-width: 780px) {
    .newsletter-band__inner { grid-template-columns: 1fr; gap: 22px; text-align: center; }
    .newsletter-band__copy p { margin: 0 auto; }
    .newsletter-band__form { flex-direction: column; }
    .newsletter-band__btn { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Newsletter signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "New drops, restocks, and the occasional sweet deal — no spam, unsubscribe anytime." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my code" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're in! Use code WELCOME10 at checkout for 10% off." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By signing up you agree to receive marketing emails." }
  ],
  "presets": [{ "name": "Newsletter signup" }]
}
{% endschema %}
