<section class="p3d" id="p3d-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="p3d__heading" data-cm-reveal>{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="p3d__stage" data-p3d data-src="{{ section.settings.model.url }}" data-spin="{{ section.settings.auto_rotate }}" style="--p3d-h:{{ section.settings.height }}px">
    {%- if section.settings.model == blank -%}
      <p class="p3d__empty">Upload a .glb model in the Theme Editor to preview it here.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .p3d{padding:48px 24px;max-width:1120px;margin:0 auto}
  .p3d__heading{font-family:var(--font-display);text-align:center;margin:0 0 24px}
  .p3d__stage{position:relative;height:var(--p3d-h);border-radius:12px;background:var(--cream-100);border:1px solid var(--border-hairline);overflow:hidden}
  .p3d__stage canvas{display:block;width:100%;height:100%;cursor:grab}
  .p3d__stage canvas:active{cursor:grabbing}
  .p3d__empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--cocoa-500);font-size:14px;text-align:center;padding:0 24px}
</style>

{%- if section.settings.model != blank -%}
  {%- comment -%} ponytail: a second copy of this section on the same page would emit a duplicate importmap, which browsers ignore — fine for the expected single-viewer-per-page case, revisit with a shared layout-level importmap if multi-instance is ever needed {%- endcomment -%}
  <script type="importmap">
  { "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.185.1/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.185.1/examples/jsm/"
  } }
  </script>
  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

    const stage = document.querySelector('#p3d-{{ section.id }} [data-p3d]');
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    stage.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
    camera.position.set(0, 0, 4);

    scene.add(new THREE.AmbientLight(0xffffff, 1.2));
    const key = new THREE.DirectionalLight(0xffffff, 1.4);
    key.position.set(3, 4, 5);
    scene.add(key);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.autoRotate = stage.dataset.spin === 'true';
    controls.autoRotateSpeed = 2;

    new GLTFLoader().load(stage.dataset.src, (gltf) => {
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3()).length() || 1;
      const center = box.getCenter(new THREE.Vector3());
      model.position.sub(center);
      model.scale.setScalar(2 / size);
      scene.add(model);
    });

    function resize() {
      const { clientWidth: w, clientHeight: h } = stage;
      if (!w || !h) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    new ResizeObserver(resize).observe(stage);
    resize();

    (function tick() {
      controls.update();
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "3D product viewer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Look inside" },
    { "type": "text", "id": "model", "label": "3D model URL (.glb)", "info": "Paste a public URL to a .glb model. The viewer will load it via three.js." },
    { "type": "range", "id": "height", "label": "Viewer height (px)", "min": 320, "max": 720, "step": 20, "default": 480 },
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate", "default": true }
  ],
  "presets": [{ "name": "3D product viewer" }]
}
{% endschema %}
