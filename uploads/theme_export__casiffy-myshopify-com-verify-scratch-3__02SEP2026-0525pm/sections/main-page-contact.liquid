<div class="cm-container" data-cm-reveal>
  <h1 class="contact-page__title">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}
    <div class="rte contact-page__intro">{{ page.content }}</div>
  {%- endif -%}

  <div class="contact-page__grid">
    <div class="contact-page__info">
      <h2 class="contact-page__info-hd">{{ section.settings.info_heading | default: 'Get in touch' }}</h2>
      <ul class="contact-page__info-list">
        {%- if shop.address.address1 != blank -%}
          <li>
            {% render 'icon', name: 'pin', size: 16 %}
            <span>{{ shop.address.address1 }}{% if shop.address.address2 != blank %}, {{ shop.address.address2 }}{% endif %}<br>{{ shop.address.city }}{% if shop.address.province_code != blank %}, {{ shop.address.province_code }}{% endif %} {{ shop.address.zip }}<br>{{ shop.address.country }}</span>
          </li>
        {%- endif -%}
        {%- if shop.phone != blank -%}
          <li>
            {% render 'icon', name: 'phone', size: 16 %}
            <span><a href="tel:{{ shop.phone }}">{{ shop.phone }}</a></span>
          </li>
        {%- endif -%}
        {%- if shop.email != blank -%}
          <li>
            {% render 'icon', name: 'mail', size: 16 %}
            <span><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></span>
          </li>
        {%- endif -%}
      </ul>
    </div>

    <div class="contact-page__form-card">
      {%- form 'contact', class: 'contact-page__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact-page__success" role="status">{{ section.settings.success_message | default: "Thanks — we'll get back to you soon." }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="contact-page__error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <label class="contact-page__label" for="ContactFormName">Name</label>
        <input class="cm-input contact-page__input" type="text" id="ContactFormName" name="contact[name]" value="{{ form.name }}" autocomplete="name">

        <label class="contact-page__label" for="ContactFormEmail">Email <i>*</i></label>
        <input class="cm-input contact-page__input" type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>

        <label class="contact-page__label" for="ContactFormPhone">Phone</label>
        <input class="cm-input contact-page__input" type="tel" id="ContactFormPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">

        <label class="contact-page__label" for="ContactFormMessage">Message <i>*</i></label>
        <textarea class="cm-input contact-page__input contact-page__textarea" id="ContactFormMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>

        <button type="submit" class="btn btn--block cm-press">{{ section.settings.button_label | default: 'Send message' }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

<style>
  .contact-page__title { font: 800 clamp(28px,4vw,52px)/1.05 var(--font-display); color: var(--red-600); text-transform: uppercase; letter-spacing: -.03em; margin: 0 0 18px; }
  .contact-page__intro { max-width: 70ch; color: var(--cocoa-600); font-size: 16px; line-height: 1.65; margin-bottom: 28px; }
  .contact-page__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 28px; align-items: start; }
  @media (max-width: 780px) { .contact-page__grid { grid-template-columns: 1fr; } }
  .contact-page__info, .contact-page__form-card {
    background: var(--cream-50); border: 1px solid var(--border-hairline);
    border-radius: 14px; padding: 22px; box-shadow: var(--shadow-xs);
  }
  .contact-page__info-hd { font: 700 20px var(--font-display); color: var(--cocoa-700); margin: 0 0 14px; }
  .contact-page__info-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .contact-page__info-list li { display: flex; align-items: flex-start; gap: 10px; font: 15px var(--font-body); color: var(--cocoa-600); line-height: 1.5; }
  .contact-page__info-list a { color: var(--text-link); text-decoration: underline; text-underline-offset: 3px; }
  .contact-page__info-list a:hover { color: var(--text-link-hover); }
  .contact-page__form { display: flex; flex-direction: column; gap: 6px; }
  .contact-page__label { font-size: 13px; font-weight: 600; color: var(--cocoa-600); margin-top: 10px; }
  .contact-page__label i { font-style: italic; color: var(--red-600); }
  .contact-page__label:first-child { margin-top: 0; }
  .contact-page__input {
    width: 100%; box-sizing: border-box; background: var(--white);
    border: 1px solid var(--border-hairline); border-radius: 8px; padding: 10px 12px;
    font: 14px var(--font-body); color: var(--cocoa-600); box-shadow: inset 0 1px 2px rgba(74,51,36,.08);
  }
  .contact-page__input:focus { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  .contact-page__textarea { resize: vertical; font-family: var(--font-body); }
  .contact-page__form .btn { margin-top: 14px; }
  .contact-page__success { color: var(--state-success); font-weight: 600; margin: 0 0 14px; }
  .contact-page__error { color: var(--state-danger); font-weight: 600; margin: 0 0 14px; }
</style>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "info_heading", "label": "Info heading", "default": "Get in touch" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — we'll get back to you soon." }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
