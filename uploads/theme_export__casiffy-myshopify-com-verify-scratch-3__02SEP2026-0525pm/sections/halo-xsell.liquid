<section class="halo-sec">
  <div class="halo-sec__hd" data-halo-reveal>
    <span class="tick">{{ section.settings.tick_label | default: 'Section 07 — finish the setup' }}</span>
    <h2>{{ section.settings.heading | default: "Three things people add in the same order" }}</h2>
  </div>

  <div class="halo-xs halo-stagger">
    {%- for block in section.blocks -%}
      {%- assign prod = block.settings.product -%}
      <div class="halo-xc" {{ block.shopify_attributes }}>
        <div class="halo-xc__art">
          {%- if prod != blank and prod.featured_image != blank -%}
            {{ prod.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: prod.title }}
          {%- elsif block.settings.icon_svg != blank -%}
            {{ block.settings.icon_svg }}
          {%- else -%}
            <svg width="76" height="112" viewBox="0 0 76 112" aria-hidden="true">
              <rect x="4" y="4" width="68" height="104" rx="14" fill="var(--cream-50)" stroke="var(--border-hairline)" stroke-width="2"/>
              <rect x="12" y="12" width="52" height="88" rx="9" fill="var(--cream-100)"/>
            </svg>
          {%- endif -%}
        </div>
        <h3>{{ block.settings.title | default: prod.title | escape }}</h3>
        <p>{{ block.settings.body }}</p>
        <div class="halo-xc__buy">
          <span class="halo-xc__price">
            {%- if prod != blank -%}
              {{ prod.price | money }}{%- if prod.compare_at_price > prod.price -%}<s>{{ prod.compare_at_price | money }}</s>{%- endif -%}
            {%- else -%}
              {{ block.settings.price | escape }}{%- if block.settings.compare_at_price != blank -%}<s>{{ block.settings.compare_at_price | escape }}</s>{%- endif -%}
            {%- endif -%}
          </span>
          {%- if prod != blank -%}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ prod.selected_or_first_available_variant.id }}">
              <button type="submit" class="halo-xc__add">Add</button>
            </form>
          {%- else -%}
            <button type="button" class="halo-xc__add">Add</button>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Halo — Cross sell",
  "blocks": [
    {
      "type": "item",
      "name": "Add-on",
      "settings": [
        { "type": "product",   "id": "product",          "label": "Product (optional)" },
        { "type": "text",      "id": "title",            "label": "Title (or override)" },
        { "type": "textarea",  "id": "body",             "label": "Description" },
        { "type": "text",      "id": "price",            "label": "Price (if no product)" },
        { "type": "text",      "id": "compare_at_price", "label": "Compare-at price (if no product)" },
        { "type": "html",      "id": "icon_svg",         "label": "Icon SVG (if no image)" }
      ]
    }
  ],
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "tick_label", "label": "Section tick", "default": "Section 07 — finish the setup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three things people add in the same order" }
  ],
  "presets": [
    {
      "name": "Halo — Cross sell",
      "blocks": [
        { "type": "item", "settings": {
          "title": "ArmorGlass Screen Protector",
          "body":  "9H tempered glass with an alignment frame, so it goes on straight the first time. Two in a pack.",
          "price": "$19", "compare_at_price": "$29",
          "icon_svg": "<svg width=\"76\" height=\"112\" viewBox=\"0 0 76 112\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"68\" height=\"104\" rx=\"14\" fill=\"#FFFDF8\" stroke=\"#A87B58\" stroke-width=\"2\"/><rect x=\"12\" y=\"12\" width=\"52\" height=\"88\" rx=\"9\" fill=\"#FBF3E4\"/><path d=\"M24 56l9 9 20-21\" stroke=\"#4E7C7B\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>"
        } },
        { "type": "item", "settings": {
          "title": "Halo Wallet",
          "body":  "Three cards, 1,100 g of magnet, and a fold-out stand. Snaps onto the case without weakening the charge.",
          "price": "$29", "compare_at_price": "$45",
          "icon_svg": "<svg width=\"96\" height=\"96\" viewBox=\"0 0 96 96\" aria-hidden=\"true\"><rect x=\"14\" y=\"22\" width=\"68\" height=\"52\" rx=\"10\" fill=\"#FFFDF8\" stroke=\"#A87B58\" stroke-width=\"2\"/><circle cx=\"48\" cy=\"48\" r=\"17\" fill=\"none\" stroke=\"#4A3324\" stroke-opacity=\".25\" stroke-width=\"6\" stroke-dasharray=\"5.5 4\"/></svg>"
        } },
        { "type": "item", "settings": {
          "title": "VentLock Car Mount",
          "body":  "Built for the 1,400 g ring. Grips the vent blade instead of hanging off it, so it doesn't droop on hot days.",
          "price": "$25", "compare_at_price": "$39",
          "icon_svg": "<svg width=\"96\" height=\"96\" viewBox=\"0 0 96 96\" aria-hidden=\"true\"><rect x=\"26\" y=\"16\" width=\"44\" height=\"64\" rx=\"10\" fill=\"#FFFDF8\" stroke=\"#A87B58\" stroke-width=\"2\"/><path d=\"M48 80v-8M34 88h28\" stroke=\"#A87B58\" stroke-width=\"3\" stroke-linecap=\"round\"/><circle cx=\"48\" cy=\"44\" r=\"13\" fill=\"none\" stroke=\"#C4302B\" stroke-width=\"4\"/></svg>"
        } }
      ]
    }
  ]
}
{% endschema %}
