{%- comment -%}
  Build Your Box — guided multi-step bundle builder.
  Each "slot" block is one step (Case, Charger, Tin, etc.).
  Each slot pulls a Shopify Collection; the buyer picks a product/variant
  inside that slot. Progress, running total + tier discount + "Add box
  to cart" all update live. Adding the box posts one /cart/add.js call
  with every chosen variant as a line item.
{%- endcomment -%}
{%- liquid
  assign slot_blocks = section.blocks | where: 'type', 'slot'
  assign slot_count = slot_blocks.size
  if slot_count == 0
    assign slot_count = 3
  endif
-%}

<section
  class="build-box"
  data-build-box
  data-required-slots="{{ slot_count }}"
  data-discount-threshold="{{ section.settings.discount_threshold | default: 3 }}"
  data-discount-pct="{{ section.settings.discount_pct | default: 10 }}"
  style="--bb-accent: {{ section.settings.accent | default: 'var(--red-600)' }}; --bb-bg: {{ section.settings.bg | default: 'var(--cream-50)' }};"
>
  <div class="build-box__head cm-reveal">
    <span class="cm-stamp build-box__stamp">{{ section.settings.eyebrow | default: 'Build a box' }}</span>
    <h2 class="cm-section-title"><small>{{ section.settings.heading | default: 'Make it yours' }}</small>{{ section.settings.subheading | default: 'Pick one from each shelf.' }}</h2>
    {%- if section.settings.lede != blank -%}
      <p class="build-box__lede">{{ section.settings.lede }}</p>
    {%- endif -%}
  </div>

  <ol class="build-box__progress cm-stagger-sm" aria-label="Build progress">
    {%- for block in slot_blocks -%}
      <li class="build-box__step {% if forloop.first %}is-active{% endif %}"
          data-step="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}>
        <span class="build-box__step-num">{{ forloop.index }}</span>
        <span class="build-box__step-label">{{ block.settings.eyebrow | default: 'Step ' | append: forloop.index }}</span>
        <span class="build-box__step-check" aria-hidden="true">&#10003;</span>
      </li>
    {%- else -%}
      {%- for i in (1..3) -%}
        <li class="build-box__step {% if i == 1 %}is-active{% endif %}" data-step="{{ i | minus: 1 }}">
          <span class="build-box__step-num">{{ i }}</span>
          <span class="build-box__step-label">Step {{ i }}</span>
          <span class="build-box__step-check" aria-hidden="true">&#10003;</span>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ol>

  <div class="build-box__layout">
    <div class="build-box__panels">
      {%- for block in slot_blocks -%}
        {%- liquid
          assign coll    = block.settings.collection
          assign title   = block.settings.title
          assign sub     = block.settings.sub
          assign sidx    = forloop.index0
          assign coll_id = coll.id | default: blank
        -%}
        <article
          class="build-box__panel halo-buy {% if forloop.first %}is-open{% endif %}"
          data-panel="{{ sidx }}"
          data-collection-id="{{ coll_id }}"
          data-collection-handle="{{ coll.handle | default: '' }}"
          {{ block.shopify_attributes }}
        >
          <header class="build-box__panel-head">
            <span class="build-box__panel-eyebrow">Step {{ sidx | plus: 1 }} of {{ slot_count }}</span>
            <h3 class="halo-title build-box__panel-title">{{ title | default: 'Choose one' }}</h3>
            {%- if sub != blank -%}
              <p class="halo-sub build-box__panel-sub">{{ sub }}</p>
            {%- endif -%}
          </header>

          <div class="build-box__products" data-products data-loading>
            {%- if coll != blank and coll.products.size > 0 -%}
              {%- assign pcount = 0 -%}
              {%- for product in coll.products limit: 8 -%}
                {%- assign pcount = pcount | plus: 1 -%}
                {%- assign variant = product.selected_or_first_available_variant -%}
                {%- assign img_url = product.featured_image | image_url: width: 240 -%}
                <button
                  type="button"
                  class="build-box__product"
                  data-product
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-title="{{ product.title | escape }}"
                  data-image="{{ img_url }}"
                  {% if img_url != blank %}style="--bb-img: url('{{ img_url }}');"{% endif %}
                >
                  <span class="build-box__product-img">
                    {%- if img_url != blank -%}
                      <span class="build-box__product-img-fill" style="background-image:url('{{ img_url }}')"></span>
                    {%- else -%}
                      <span class="build-box__product-img-placeholder"></span>
                    {%- endif -%}
                  </span>
                  <span class="build-box__product-meta">
                    <span class="build-box__product-title">{{ product.title }}</span>
                    <span class="build-box__product-price">{{ variant.price | money }}</span>
                  </span>
                  <span class="build-box__product-pick" aria-hidden="true">+</span>
                </button>
              {%- endfor -%}
            {%- else -%}
              <p class="build-box__empty" data-empty>
                Select a collection in the theme editor to load products for this slot.
              </p>
            {%- endif -%}
            <span class="build-box__skeleton" data-skeleton hidden>
              <span></span><span></span><span></span><span></span>
            </span>
          </div>

          <footer class="build-box__panel-foot">
            <button type="button" class="build-box__nav build-box__nav--prev" data-prev {% if forloop.first %}disabled{% endif %}>
              <span aria-hidden="true">&larr;</span> Back
            </button>
            <button type="button" class="build-box__nav build-box__nav--next halo-cta cm-press" data-next>
              Next <span aria-hidden="true">&rarr;</span>
            </button>
          </footer>
        </article>
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="build-box__panel halo-buy {% if i == 1 %}is-open{% endif %}" data-panel="{{ i | minus: 1 }}">
            <header class="build-box__panel-head">
              <span class="build-box__panel-eyebrow">Step {{ i }} of 3</span>
              <h3 class="halo-title build-box__panel-title">Choose one</h3>
            </header>
            <div class="build-box__products" data-products data-loading>
              <p class="build-box__empty" data-empty>Add a Collection in the editor to load this slot.</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <aside class="build-box__summary halo-buy" data-summary>
      <header class="build-box__summary-head">
        <h3 class="halo-title">Your box</h3>
        <span class="build-box__summary-count" data-count>0 / {{ slot_count }}</span>
      </header>

      <div class="build-box__bar" aria-hidden="true">
        <span class="build-box__bar-fill" data-bar style="width:0%"></span>
      </div>

      <ul class="build-box__summary-list" data-list>
        {%- for block in slot_blocks -%}
          <li class="build-box__summary-row" data-row="{{ forloop.index0 }}">
            <span class="build-box__summary-step">{{ forloop.index }}</span>
            <span class="build-box__summary-label">{{ block.settings.title | default: 'Step ' | append: forloop.index }}</span>
            <span class="build-box__summary-val" data-row-val>—</span>
          </li>
        {%- else -%}
          {%- for i in (1..3) -%}
            <li class="build-box__summary-row" data-row="{{ i | minus: 1 }}">
              <span class="build-box__summary-step">{{ i }}</span>
              <span class="build-box__summary-label">Step {{ i }}</span>
              <span class="build-box__summary-val" data-row-val>—</span>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>

      <dl class="build-box__totals">
        <div><dt>Subtotal</dt><dd data-subtotal>$0.00</dd></div>
        <div class="build-box__discount" data-discount-row hidden>
          <dt>Bundle saving <span data-discount-tier></span></dt>
          <dd data-discount-amount>-$0.00</dd>
        </div>
        <div class="build-box__grand"><dt>Total</dt><dd data-total>$0.00</dd></div>
      </dl>

      <button type="button" class="halo-cta build-box__add cm-press" data-add disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
          <path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
        </svg>
        <span data-add-label>Complete your box</span>
      </button>

      <p class="halo-cta-sub">
        <span class="halo-dot"></span>
        <b data-stock-label>Pick {{ slot_count }} items to unlock the saving</b>
      </p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Build your box",
  "tag": "section",
  "class": "section-build-box",
  "settings": [
    { "type": "text",     "id": "eyebrow",            "label": "Eyebrow",         "default": "Build a box" },
    { "type": "text",     "id": "heading",            "label": "Heading",         "default": "Make it yours" },
    { "type": "text",     "id": "subheading",         "label": "Subheading",      "default": "Pick one from each shelf." },
    { "type": "textarea", "id": "lede",               "label": "Lede paragraph" },
    { "type": "text",     "id": "accent",             "label": "Accent colour",   "default": "var(--red-600)" },
    { "type": "text",     "id": "bg",                 "label": "Background",      "default": "var(--cream-50)" },
    { "type": "range",    "id": "discount_threshold", "label": "Items needed for discount", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "range",    "id": "discount_pct",       "label": "Discount %",      "min": 0, "max": 40, "step": 5, "default": 10 }
  ],
  "blocks": [
    {
      "type": "slot",
      "name": "Slot (step)",
      "limit": 6,
      "settings": [
        { "type": "text",     "id": "eyebrow",    "label": "Step label",      "default": "Pick a case" },
        { "type": "text",     "id": "title",      "label": "Slot title",      "default": "Choose your case" },
        { "type": "textarea", "id": "sub",        "label": "Slot subtitle" },
        { "type": "collection","id": "collection","label": "Source collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Build your box",
      "blocks": [
        { "type": "slot", "settings": { "eyebrow": "Pick a case", "title": "Choose your case", "sub": "MagSafe-ready candy stripe shell." } },
        { "type": "slot", "settings": { "eyebrow": "Add a charger","title": "Choose a charger", "sub": "Snap-on 15W MagSafe." } },
        { "type": "slot", "settings": { "eyebrow": "Sweet finish","title": "Choose a tin",     "sub": "Hand-tied, posted next day." } }
      ]
    }
  ]
}
{% endschema %}