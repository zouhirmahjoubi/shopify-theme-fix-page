<section class="halo-closer" id="halo-promise">
  <h2 data-halo-reveal>{{ section.settings.heading | default: "Buy the case. If it fails, we pay for the screen." }}</h2>
  <p data-halo-reveal>{{ section.settings.subheading | default: "Twelve feet, 1,400 grams, no yellowing, 90 days to send it back. There isn't much left to think about." }}</p>
  <button class="halo-cta" type="button" onclick="document.getElementById('haloPdp').scrollIntoView({behavior:'smooth',block:'start'})" data-halo-reveal>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
    Pick my model
  </button>
  <span class="tick">{{ section.settings.tick_label | default: 'Free shipping over $45 · ships from Austin, TX' }}</span>
</section>

{% schema %}
{
  "name": "Halo — Closer",
  "settings": [
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "Buy the case. If it fails, we pay for the screen." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Twelve feet, 1,400 grams, no yellowing, 90 days to send it back. There isn't much left to think about." },
    { "type": "text",     "id": "tick_label", "label": "Tick line",  "default": "Free shipping over $45 · ships from Austin, TX" }
  ],
  "presets": [{ "name": "Halo — Closer" }]
}
{% endschema %}
