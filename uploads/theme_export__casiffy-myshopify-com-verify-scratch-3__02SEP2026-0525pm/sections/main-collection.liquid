<div class="cm-container" data-cm-reveal>
  <h1 style="font:800 clamp(28px,4vw,52px)/1.05 var(--font-display);color:var(--red-600);text-transform:uppercase;letter-spacing:-.03em;margin:0 0 24px">{{ collection.title | escape }}</h1>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      <p style="color:var(--cocoa-500)">No products in this collection yet.</p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{ "name": "Collection", "presets": [{ "name": "Collection" }] }
{% endschema %}
