{
  "$schema": "casify-design-tokens/v1",
  "meta": {
    "theme": "Casify (Chrismass design)",
    "version": "1.0.0",
    "source": "assets/theme.css (:root), config/settings_schema.json, config/settings_data.json"
  },
  "primitive": {
    "color": {
      "cream": { "50": "#FDF9F1", "100": "#FBF3E4", "200": "#F5E9D3", "300": "#EADCBF", "400": "#DCC9A6" },
      "red":   { "300": "#E58C82", "400": "#D8564A", "500": "#C4302B", "600": "#A8231F", "700": "#7E1A17" },
      "teal":  { "100": "#E4F0EE", "200": "#CDE3E0", "300": "#A8C8C4", "400": "#86B0AE", "500": "#6C9E9C", "600": "#4E7C7B" },
      "cocoa": { "300": "#A87B58", "400": "#8A5A3C", "500": "#6B4229", "600": "#4A3324", "700": "#33231A" },
      "gold":  { "200": "#F0E2C2", "300": "#E7D3A8", "400": "#D2B57C", "500": "#B08F52" },
      "white": "#FFFDF8",
      "black": "#241812"
    },
    "font": {
      "display": "\"Playfair Display\", Georgia, \"Times New Roman\", serif",
      "body": "\"Libre Baskerville\", Georgia, serif",
      "script": "\"Parisienne\", \"Snell Roundhand\", cursive",
      "label": "\"Special Elite\", \"Courier New\", monospace"
    },
    "motion": {
      "duration": { "fast": "160ms", "base": "240ms", "slow": "420ms" },
      "easing": {
        "standard": "cubic-bezier(.4,0,.2,1)",
        "candy": "cubic-bezier(.34,1.56,.64,1)",
        "outSoft": "cubic-bezier(0,0,.2,1)"
      }
    },
    "layout": {
      "maxWidth": "1160px"
    }
  },
  "semantic": {
    "brand": {
      "primary": "{primitive.color.red.500}",
      "primaryHover": "{primitive.color.red.600}",
      "primaryPress": "{primitive.color.red.700}",
      "secondary": "{primitive.color.teal.500}",
      "secondaryHover": "{primitive.color.teal.600}",
      "accent": "{primitive.color.gold.400}"
    },
    "surface": {
      "page": "{primitive.color.cream.100}",
      "card": "{primitive.color.cream.50}",
      "inset": "{primitive.color.cream.200}",
      "ticket": "{primitive.color.gold.200}",
      "ink": "{primitive.color.cocoa.700}",
      "overlay": "rgba(36,24,18,.55)"
    },
    "text": {
      "body": "{primitive.color.cocoa.600}",
      "heading": "{primitive.color.red.600}",
      "muted": "{primitive.color.cocoa.400}",
      "onDark": "{primitive.color.cream.100}",
      "onBrand": "{primitive.color.cream.50}",
      "link": "{primitive.color.red.600}",
      "linkHover": "{primitive.color.red.700}"
    },
    "border": {
      "hairline": "rgba(74,51,36,.28)",
      "strong": "{primitive.color.cocoa.500}",
      "dashed": "rgba(74,51,36,.45)"
    },
    "state": {
      "focusRing": "{primitive.color.teal.600}",
      "success": "{primitive.color.teal.600}",
      "warning": "{primitive.color.gold.500}",
      "danger": "{primitive.color.red.600}",
      "info": "{primitive.color.teal.500}"
    },
    "typography": {
      "trackingLabel": "0.18em"
    },
    "shadow": {
      "diecut": "0 1px 0 rgba(255,253,248,.7) inset, 0 -1px 0 rgba(74,51,36,.14) inset, 0 2px 5px rgba(51,35,26,.16)",
      "xs": "0 1px 1px rgba(51,35,26,.10)",
      "sm": "0 1px 3px rgba(51,35,26,.14)",
      "md": "0 3px 8px rgba(51,35,26,.16)",
      "lg": "0 10px 24px rgba(51,35,26,.20)",
      "lifted": "0 14px 34px rgba(51,35,26,.24)"
    }
  },
  "sectionAliases": {
    "_comment": "Halo PDP section (theme.css line ~778) re-labels the same brand palette under its own names; values are identical to the primitives above.",
    "halo": {
      "ink": "{primitive.color.cocoa.700}",
      "paper": "{primitive.color.cream.100}",
      "ticket": "{primitive.color.gold.200}",
      "line": "rgba(74,51,36,.28)",
      "red": "{primitive.color.red.500}",
      "redDark": "{primitive.color.red.600}",
      "teal": "{primitive.color.teal.600}",
      "amber": "{primitive.color.gold.500}"
    }
  },
  "themeSettings": {
    "_comment": "Merchant-editable brand colors from config/settings_schema.json; current values live in config/settings_data.json",
    "logoHeight": { "type": "range", "min": 32, "max": 120, "step": 2, "default": 56, "unit": "px" },
    "colors": {
      "candy_red": { "default": "#C4302B", "current": "#C4302B" },
      "candy_teal": { "default": "#6C9E9C", "current": "#6C9E9C" },
      "candy_cream": { "default": "#FDF9F1", "current": "#FDF9F1" },
      "candy_cocoa": { "default": "#4A3324", "current": "#4A3324" }
    }
  }
}
