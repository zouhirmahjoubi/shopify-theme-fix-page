<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% if page_title %}{{ page_title }} | {% endif %}{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {%- render 'palette-vars' -%}
    <script>window.themeMoneyFormat = {{ shop.money_format | json }};</script>
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}{% if template.name == 'product' and template.suffix != 'classic' %} halo-tpl{% endif %}">
    <a href="#MainContent" class="cm-skip-link">Skip to content</a>
    {% sections 'header-group' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
    <script src="{{ 'casify-data.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'halo.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'build-box.js' | asset_url }}" defer></script>
  </body>
</html>
