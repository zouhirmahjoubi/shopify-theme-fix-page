+/* One shop clip under the photo (.cvvr--solo): the clip on the left, its words
+   beside it with the top and bottom edges level, so a single card is not left
+   alone in a row built for several. What it is shown on reads beside the clip. */
+/* ds-allow-hardcode:start: no spacing scale in this theme; the clip keeps the width it has in the phone rail (46%) and the gaps follow the inline row above */
+.cvvr--inline.cvvr--solo .cvvr__inner {
+  display: grid;
+  grid-template-columns: minmax(0, min(46%, 220px)) minmax(0, 1fr);
+  grid-template-rows: auto 1fr auto;
+  column-gap: 16px;
+}
+.cvvr--inline.cvvr--solo .cvvr__wrap { grid-column: 1; grid-row: 1 / -1; }
