{%- comment -%}
  Casify — converting PDP inline SVG icon library.

  Every glyph is drawn on a 24×24 grid, inherits `currentColor`, and is safe to
  animate from CSS (stroke-dasharray on `.cv-ico__draw`, transform on
  `.cv-ico__pulse` / `.cv-ico__fall`).

  Params:
    name  (required) — glyph key, see the case list below
    size  (px, default 24)
    class (extra classes, e.g. "cv-ico--lg")
    color (default currentColor)
    animate (boolean) — adds `cv-ico--anim` so CSS keyframes engage

  Usage:
    {%- render 'cv-icon', name: 'drop-shield', size: 40, animate: true -%}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
  assign extra = class | default: ''
  assign clr = color | default: 'currentColor'
  assign anim = ''
  if animate
    assign anim = ' cv-ico--anim'
  endif
-%}
<span class="cv-ico {{ extra }}{{ anim }}" style="width:{{ s }}px;height:{{ s }}px;color:{{ clr }}" aria-hidden="true">
  {%- case name -%}

    {%- comment -%} ---- Protection / durability ---- {%- endcomment -%}
    {%- when 'drop-shield' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path class="cv-ico__draw" d="M12 2.6l7.4 2.6v6.2c0 4.9-3.1 8.4-7.4 10.1C7.7 19.8 4.6 16.3 4.6 11.4V5.2z"/>
        <path class="cv-ico__fall" d="M12 7.2v5.4"/>
        <path d="M9.6 10.4L12 12.9l2.4-2.5"/>
      </svg>

    {%- when 'drop-height' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 21h16"/>
        <rect class="cv-ico__fall" x="9" y="2.5" width="6" height="10" rx="2"/>
        <path class="cv-ico__draw" d="M19 4.5v12"/>
        <path d="M17 6.5l2-2 2 2M17 14.5l2 2 2-2"/>
      </svg>

    {%- when 'honeycomb' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <path d="M8.2 3.4h4.1l2 3.5-2 3.5H8.2l-2-3.5z"/>
        <path d="M14.9 8.6H19l2 3.5-2 3.5h-4.1l-2-3.5z" opacity=".7"/>
        <path d="M8.2 13.8h4.1l2 3.5-2 3.5H8.2l-2-3.5z" opacity=".5"/>
        <path d="M1.6 8.6h4.1l2 3.5-2 3.5H1.6l-2-3.5z" opacity=".35"/>
      </svg>

    {%- comment -%} ---- Magnet / charging ---- {%- endcomment -%}
    {%- when 'magnet-ring' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle class="cv-ico__pulse" cx="12" cy="12" r="8.4" stroke-dasharray="3.2 2.6"/>
        <circle cx="12" cy="12" r="4.4"/>
        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'magnet' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 3.5v8a6 6 0 0 0 12 0v-8"/>
        <path d="M6 9.2h4.6M13.4 9.2H18"/>
        <path class="cv-ico__pulse" d="M12 20.5v1.8"/>
      </svg>

    {%- when 'wireless-charge' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path class="cv-ico__pulse" d="M4.4 8.2a10 10 0 0 1 15.2 0"/>
        <path d="M7.2 11.6a6.4 6.4 0 0 1 9.6 0" opacity=".75"/>
        <path d="M12.6 14.4l-2.4 3.6h2.4l-.8 3.4 3.2-4.4h-2.4z" fill="currentColor" stroke="none"/>
      </svg>

    {%- comment -%} ---- Clarity / material ---- {%- endcomment -%}
    {%- when 'no-yellow' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.6"/>
        <path d="M12 3.4a8.6 8.6 0 0 1 0 17.2z" fill="currentColor" opacity=".16" stroke="none"/>
        <path class="cv-ico__draw" d="M5.9 18.1L18.1 5.9"/>
      </svg>

    {%- when 'sparkle-clear' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path class="cv-ico__pulse" d="M12 3.2l1.7 4.6 4.6 1.7-4.6 1.7L12 15.8l-1.7-4.6L5.7 9.5l4.6-1.7z"/>
        <path d="M18.4 15.6l.8 2.1 2.1.8-2.1.8-.8 2.1-.8-2.1-2.1-.8 2.1-.8z" opacity=".7"/>
      </svg>

    {%- when 'uv-sun' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.2"/>
        <g class="cv-ico__pulse">
          <path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2"/>
          <path d="M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"/>
        </g>
      </svg>

    {%- when 'ring-dot' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle class="cv-ico__pulse" cx="12" cy="12" r="8.2"/>
        <circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none"/>
      </svg>

    {%- comment -%} ---- Fit / build ---- {%- endcomment -%}
    {%- when 'slim' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9.4" y="2.6" width="5.2" height="18.8" rx="2.2"/>
        <path class="cv-ico__draw" d="M5.4 6.2v11.6M18.6 6.2v11.6"/>
        <path d="M3.4 8.2l2-2 2 2M20.6 8.2l-2-2-2 2"/>
      </svg>

    {%- when 'camera-lip' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.4" y="5.4" width="17.2" height="13.2" rx="3"/>
        <circle class="cv-ico__pulse" cx="12" cy="12" r="3.6"/>
        <path d="M8.6 5.4l1.2-2h4.4l1.2 2"/>
        <circle cx="17.4" cy="9" r="1" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'button-click' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="6.6" y="2.6" width="10.8" height="18.8" rx="2.6"/>
        <path class="cv-ico__pulse" d="M20 8.4v3.2"/>
        <path d="M4 7.6v2.4M4 11.6v2.4"/>
      </svg>

    {%- when 'precision-fit' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.2 8.4V4.8a1.6 1.6 0 0 1 1.6-1.6h3.6M20.8 8.4V4.8a1.6 1.6 0 0 0-1.6-1.6h-3.6"/>
        <path d="M3.2 15.6v3.6a1.6 1.6 0 0 0 1.6 1.6h3.6M20.8 15.6v3.6a1.6 1.6 0 0 1-1.6 1.6h-3.6"/>
        <circle class="cv-ico__pulse" cx="12" cy="12" r="3.2"/>
      </svg>

    {%- when 'device' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="6.4" y="2.6" width="11.2" height="18.8" rx="2.6"/>
        <path d="M10.4 5.2h3.2"/>
        <circle class="cv-ico__pulse" cx="12" cy="18" r="1" fill="currentColor" stroke="none"/>
      </svg>

    {%- comment -%} ---- Nav (header links) ---- {%- endcomment -%}
    {%- when 'device-notch' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="6.4" y="2.6" width="11.2" height="18.8" rx="2.6"/>
        <circle cx="12" cy="5.4" r=".9" fill="currentColor" stroke="none"/>
        <circle class="cv-ico__pulse" cx="12" cy="18" r="1" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'mail' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.6" y="5" width="18.8" height="14" rx="2.2"/>
        <path class="cv-ico__draw" d="M3.2 6.2l8.8 6.6 8.8-6.6"/>
      </svg>

    {%- when 'grid' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
        <rect x="3.4" y="3.4" width="7.2" height="7.2" rx="1.4"/>
        <rect x="13.4" y="3.4" width="7.2" height="7.2" rx="1.4"/>
        <rect x="3.4" y="13.4" width="7.2" height="7.2" rx="1.4"/>
        <rect class="cv-ico__pulse" x="13.4" y="13.4" width="7.2" height="7.2" rx="1.4"/>
      </svg>

    {%- comment -%} ---- Collection headers (bigger, richer variants of the nav glyphs) ---- {%- endcomment -%}
    {%- when 'collection-iphone' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5.4" y="2.2" width="13.2" height="19.6" rx="3.2"/>
        <rect class="cv-ico__draw" x="9" y="3.7" width="6" height="1.7" rx=".85"/>
        <circle class="cv-ico__pulse" cx="12" cy="19" r="1" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'collection-samsung' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5.4" y="2.2" width="13.2" height="19.6" rx="2.4"/>
        <circle class="cv-ico__draw" cx="12" cy="4.7" r=".9"/>
        <path class="cv-ico__pulse" d="M8.4 20.4h7.2" stroke-width="1.3"/>
      </svg>

    {%- when 'collection-all' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
        <rect x="3" y="6.6" width="8" height="13.4" rx="1.8" transform="rotate(-9 7 13.3)" opacity=".7"/>
        <rect class="cv-ico__draw" x="8" y="5.3" width="8" height="13.4" rx="1.8"/>
        <rect class="cv-ico__pulse" x="13" y="6.6" width="8" height="13.4" rx="1.8" transform="rotate(9 17 13.3)" opacity=".7"/>
      </svg>

    {%- comment -%} ---- Commerce / trust ---- {%- endcomment -%}
    {%- when 'bag' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.6 7.6h14.8l-1.1 12.8H5.7z"/>
        <path d="M9 7.6V5.8a3 3 0 0 1 6 0v1.8"/>
      </svg>

    {%- when 'truck-fast' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2.6 6.6h10.8v9.2H2.6z"/>
        <path d="M13.4 9.8h3.8l3.2 3.2v2.8h-7z"/>
        <circle cx="7" cy="18.4" r="1.7"/><circle cx="17" cy="18.4" r="1.7"/>
        <path class="cv-ico__pulse" d="M.8 9.4h3M.8 12.4h2"/>
      </svg>

    {%- when 'returns' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path class="cv-ico__draw" d="M3.6 11.4a8.4 8.4 0 0 1 14.6-5.2"/>
        <path d="M18.4 3.4v3.4h-3.4"/>
        <path class="cv-ico__draw" d="M20.4 12.6a8.4 8.4 0 0 1-14.6 5.2"/>
        <path d="M5.6 20.6v-3.4H9"/>
      </svg>

    {%- when 'lock-secure' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4.6" y="10.2" width="14.8" height="10.4" rx="2.4"/>
        <path d="M8.2 10.2V7.6a3.8 3.8 0 0 1 7.6 0v2.6"/>
        <circle cx="12" cy="15.4" r="1.4" fill="currentColor" stroke="none"/>
      </svg>

    {%- when 'warranty-seal' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle class="cv-ico__pulse" cx="12" cy="9.8" r="6.4"/>
        <path d="M9.4 9.8l1.9 1.9 3.3-3.6"/>
        <path d="M8.4 15.4l-1 6 4.6-2.4 4.6 2.4-1-6"/>
      </svg>

    {%- when 'check' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path class="cv-ico__draw" d="M4.4 12.4l5.2 5.2 10-11.2"/>
      </svg>

    {%- when 'cross' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M6.4 6.4l11.2 11.2M17.6 6.4L6.4 17.6"/>
      </svg>

    {%- when 'star' -%}
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2.6l2.9 6.1 6.6.9-4.8 4.7 1.2 6.6L12 17.7l-5.9 3.2 1.2-6.6-4.8-4.7 6.6-.9z"/>
      </svg>

    {%- when 'quote' -%}
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M9.4 5.6c-3.4 1.5-5.6 4.4-5.6 8.1 0 3 1.7 4.7 3.9 4.7 2 0 3.5-1.4 3.5-3.4 0-1.9-1.3-3.2-3.1-3.2-.3 0-.6 0-.8.1.4-1.9 1.8-3.5 3.6-4.5zM19.8 5.6c-3.4 1.5-5.6 4.4-5.6 8.1 0 3 1.7 4.7 3.9 4.7 2 0 3.5-1.4 3.5-3.4 0-1.9-1.3-3.2-3.1-3.2-.3 0-.6 0-.8.1.4-1.9 1.8-3.5 3.6-4.5z"/>
      </svg>

    {%- when 'chevron-down' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9.4l6 6 6-6"/>
      </svg>

    {%- when 'arrow-right' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.6 12h14.8"/><path d="M13.4 6l6 6-6 6"/>
      </svg>

    {%- when 'clock' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.6"/>
        <path class="cv-ico__pulse" d="M12 7.4V12l3.4 2.2"/>
      </svg>

    {%- when 'lab' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9.4 2.8v6.4l-4.6 8a2 2 0 0 0 1.7 3h10.8a2 2 0 0 0 1.7-3l-4.6-8V2.8"/>
        <path d="M8.2 2.8h7.6"/>
        <path class="cv-ico__pulse" d="M6.8 15.4h10.4"/>
      </svg>

    {%- when 'ruler' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.4" y="8.4" width="19.2" height="7.2" rx="1.6"/>
        <path d="M7 8.4v3M11 8.4v3.8M15 8.4v3M19 8.4v3.8"/>
      </svg>

    {%- when 'gift' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.4" y="9.4" width="17.2" height="11.2" rx="1.8"/>
        <path d="M3.4 13.4h17.2M12 9.4v11.2"/>
        <path d="M12 9.4S10.6 3.4 8 3.4a2.4 2.4 0 0 0 0 6M12 9.4s1.4-6 4-6a2.4 2.4 0 0 1 0 6"/>
      </svg>

    {%- comment -%} ---- Media / UGC controls ---- {%- endcomment -%}
    {%- when 'play' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M8.4 5.4a1 1 0 0 1 1.53-.85l8.2 5.15a1.3 1.3 0 0 1 0 2.2l-8.2 5.15a1 1 0 0 1-1.53-.85z"/>
      </svg>

    {%- when 'pause' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <rect x="7" y="5" width="3.6" height="14" rx="1.2"/>
        <rect x="13.4" y="5" width="3.6" height="14" rx="1.2"/>
      </svg>

    {%- when 'sound-on' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 9.4h3.2L12 5.2v13.6L7.2 14.6H4z" fill="currentColor" stroke="none"/>
        <path class="cv-ico__pulse" d="M15.6 9.2a4 4 0 0 1 0 5.6M18.2 6.8a7.6 7.6 0 0 1 0 10.4"/>
      </svg>

    {%- when 'sound-off' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 9.4h3.2L12 5.2v13.6L7.2 14.6H4z" fill="currentColor" stroke="none"/>
        <path d="M16 9.6l4.4 4.8M20.4 9.6L16 14.4"/>
      </svg>

    {%- when 'expand' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 3.6H3.6V9M15 3.6h5.4V9M9 20.4H3.6V15M15 20.4h5.4V15"/>
      </svg>

    {%- when 'close' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
        <path d="M6.2 6.2l11.6 11.6M17.8 6.2L6.2 17.8"/>
      </svg>

    {%- when 'heart' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
        <path class="cv-ico__pulse" d="M12 20.4S3.6 15.4 3.6 9.6A4.2 4.2 0 0 1 12 7.6a4.2 4.2 0 0 1 8.4 2c0 5.8-8.4 10.8-8.4 10.8z"/>
      </svg>

    {%- when 'flame' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
        <path class="cv-ico__pulse" d="M12 2.6s5.4 4.6 5.4 9.6a5.4 5.4 0 0 1-10.8 0c0-2 1.2-3.6 1.2-3.6s.6 1.8 1.8 1.8c1.4 0 1.2-2 .6-3.6-.6-1.6.6-3.4 1.8-4.2z"/>
      </svg>

    {%- when 'video' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.6" y="6" width="13.2" height="12" rx="2.4"/>
        <path class="cv-ico__pulse" d="M15.8 10.6l5.6-3.2v9.2l-5.6-3.2z"/>
      </svg>

    {%- when 'user-check' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9.6" cy="8" r="3.8"/>
        <path d="M2.8 20.2a6.8 6.8 0 0 1 13.6 0"/>
        <path class="cv-ico__draw" d="M16.6 12.6l2.2 2.2 3.6-3.8"/>
      </svg>

    {%- comment -%} ---- Candy shop motifs ---- {%- endcomment -%}
    {%- when 'lollipop' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="9.4" r="6.6"/>
        <path class="cv-ico__pulse" d="M12 9.4c0-2.4-1.8-3.6-3.6-3-1.8.6-2.4 2.6-1.2 4 1.2 1.4 3.4 1.4 4.8 0 1.4-1.4 1.4-3.6 0-4.8"/>
        <path d="M12 15.6V21.4"/>
      </svg>

    {%- when 'candy-cane' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9.5 21V9.8a5 5 0 0 1 10 0 3.2 3.2 0 0 1-6.4 0"/>
        <path class="cv-ico__pulse" d="M10.4 12.4l3-3M11.6 15.6l3.6-3.6M12.8 18.8l3.4-3.4" stroke-width="1.3" opacity=".8"/>
      </svg>

    {%- when 'twist-wrapper' -%}
