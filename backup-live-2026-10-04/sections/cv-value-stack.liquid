{%- comment -%}
  Casify — Converting PDP: value stack, redesigned.

  Content is unchanged: every heading, problem, fix, benefit, and every proof-
  bar name/value/percentage is exactly what shipped before, straight out of
  the same schema/preset defaults. This pass only changes how it's built and
  how it moves.

  Three parts, all block-driven:
    1. "problem → fix" rows: icon in a brass medallion, a count-up metric, and
       a them-vs-us balance beam that tips toward "us" on reveal
    2. a benefit grid, lightly refreshed
    3. the proof chart rebuilt as a vertical gauge: each contender's column
       rises from the counter line in sequence, tallest first, ours capped
       with a candy-cane flag
  Styles: assets/cv-value-stack.css. Motion: assets/cv-value-stack-motion.js.
{%- endcomment -%}
{{ 'cv-value-stack.css' | asset_url | stylesheet_tag }}
<script>
  (function (root) {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('cvvs-pending');
    setTimeout(function () { root.classList.remove('cvvs-pending'); }, 1600);
  })(document.documentElement);
</script>

{%- comment -%} No "cvvs" class here: cv-vs.css styles .cvvs as the "Us vs. them" section root. {%- endcomment -%}
<section class="cv-sec cv-values" id="cv-value" data-cvvs>
  <div class="cv-sec__hd" data-cv-reveal>
    <span class="cv-eyebrow">
      <span class="cv-eyebrow__ico" aria-hidden="true">{{ 'icon-candy-swirl.svg' | inline_asset_content }}</span>
      {{ section.settings.eyebrow | default: 'Section 02 — why it wins' | escape }}
    </span>
    <h2 data-cv-split>{{ section.settings.heading | default: 'Three things every other case gets wrong' | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <div class="cv-sec__lede">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- 1. Problem / fix rows ---------- {%- endcomment -%}
  {%- assign fix_i = 0 -%}
  {%- for b in section.blocks -%}
    {%- if b.type == 'fix' -%}
      {%- assign fix_i = fix_i | plus: 1 -%}
      {%- assign fix_i_mod = fix_i | modulo: 2 -%}
      <article class="cvvs-fix{% if fix_i_mod == 0 %} cvvs-fix--flip{% endif %}" data-cvvs-fix {{ b.shopify_attributes }}>
        <div class="cvvs-fix__figure">
          <span class="cvvs-fix__medal" aria-hidden="true"></span>
          <span class="cvvs-fix__ico">{%- render 'cv-icon', name: b.settings.icon, size: 56, animate: true -%}</span>
          <span class="cvvs-fix__metric" data-cvvs-metric data-value="{{ b.settings.metric_value }}">
            <b data-cvvs-metric-num>{{ b.settings.metric_value | escape }}</b><i>{{ b.settings.metric_unit | escape }}</i>
          </span>
        </div>

        <div class="cvvs-fix__body">
          <span class="cvvs-fix__index">{{ fix_i | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="cvvs-fix__problem">{{ b.settings.problem | escape }}</h3>
          <div class="cvvs-fix__copy">{{ b.settings.body }}</div>

          {%- if b.settings.them_label != blank or b.settings.us_label != blank -%}
            <div class="cvvs-beam" data-cvvs-beam>
              <span class="cvvs-beam__side cvvs-beam__side--them">
                <span class="cvvs-beam__tag">{%- render 'cv-icon', name: 'cross', size: 13 -%} {{ b.settings.them_title | default: 'Typical case' | escape }}</span>
                <strong>{{ b.settings.them_label | escape }}</strong>
              </span>
              <span class="cvvs-beam__fulcrum" aria-hidden="true">
                <span class="cvvs-beam__bar" data-cvvs-beam-bar></span>
              </span>
              <span class="cvvs-beam__side cvvs-beam__side--us">
                <span class="cvvs-beam__tag">{%- render 'cv-icon', name: 'check', size: 13 -%} {{ b.settings.us_title | default: 'This case' | escape }}</span>
                <strong>{{ b.settings.us_label | escape }}</strong>
              </span>
            </div>
          {%- endif -%}
        </div>
      </article>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ---------- 2. Benefit grid ---------- {%- endcomment -%}
  {%- assign has_benefit = false -%}
  {%- for b in section.blocks -%}{%- if b.type == 'benefit' -%}{%- assign has_benefit = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_benefit -%}
    <div class="cvvs-benefits">
      {%- if section.settings.benefits_heading != blank -%}
        <h3 class="cvvs-benefits__hd" data-cv-reveal>{{ section.settings.benefits_heading | escape }}</h3>
      {%- endif -%}
      <ul class="cvvs-benefits__grid" role="list">
        {%- for b in section.blocks -%}
          {%- if b.type == 'benefit' -%}
            <li class="cvvs-benefit" data-cvvs-benefit style="--i:{{ forloop.index0 }}" {{ b.shopify_attributes }}>
              <span class="cvvs-benefit__ico">{%- render 'cv-icon', name: b.settings.icon, size: 28, animate: true -%}</span>
              <h4>{{ b.settings.title | escape }}</h4>
              <p>{{ b.settings.body | escape }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- 3. Proof gauge ---------- {%- endcomment -%}
  {%- assign bars = section.blocks | where: 'type', 'bar' -%}
  {%- if bars.size > 0 -%}
    <div class="cvvs-gauge" data-cvvs-gauge>
      <div class="cvvs-gauge__hd">
        <span class="cv-eyebrow">{{ section.settings.proof_eyebrow | default: 'Measured, not claimed' | escape }}</span>
        <h3>{{ section.settings.proof_heading | default: 'Drop height before the phone was damaged' | escape }}</h3>
      </div>
      <div class="cvvs-gauge__rig" tabindex="0" role="group" aria-label="{{ section.settings.proof_heading | default: 'Drop height before the phone was damaged' | escape }}">
        {%- for b in bars -%}
          <div class="cvvs-gauge__col{% if b.settings.highlight %} is-us{% endif %}" data-cvvs-col data-pct="{{ b.settings.pct | default: 50 }}" style="--i:{{ forloop.index0 }}" {{ b.shopify_attributes }}>
            <span class="cvvs-gauge__val" data-cvvs-col-val>{{ b.settings.value | escape }}</span>
            <span class="cvvs-gauge__bar" data-cvvs-col-bar style="--fill: {{ b.settings.pct | default: 50 }}%">
              {%- if b.settings.highlight -%}<span class="cvvs-gauge__flag" aria-hidden="true">{%- render 'cv-icon', name: 'candy-cane', size: 20 -%}</span>{%- endif -%}
            </span>
            <span class="cvvs-gauge__name">{{ b.settings.name | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
      <span class="cvvs-gauge__line" aria-hidden="true"></span>
      {%- if section.settings.proof_footnote != blank -%}
        <p class="cvvs-gauge__foot">{%- render 'cv-icon', name: 'lab', size: 14 -%} {{ section.settings.proof_footnote | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
<script src="{{ 'cv-value-stack-motion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Convert — Value stack",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Section 02 — why it wins" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three things every other case gets wrong" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "benefits_heading", "label": "Benefit grid heading", "default": "Everything else you get" },
    { "type": "text", "id": "proof_eyebrow", "label": "Proof eyebrow", "default": "Measured, not claimed" },
    { "type": "text", "id": "proof_heading", "label": "Proof heading", "default": "Drop height before the phone was damaged" },
    { "type": "text", "id": "proof_footnote", "label": "Proof footnote", "default": "Independent lab, 26 drops per unit onto concrete, MIL-STD-810G 516.6." }
  ],
  "blocks": [
    { "type": "fix", "name": "Problem / fix row", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "drop-shield", "label": "Drop shield" },
        { "value": "honeycomb", "label": "Air-cell structure" },
        { "value": "magnet-ring", "label": "Magnet ring" },
        { "value": "no-yellow", "label": "No yellowing" },
        { "value": "slim", "label": "Slim profile" },
        { "value": "uv-sun", "label": "UV exposure" }
      ], "default": "drop-shield" },
      { "type": "text", "id": "metric_value", "label": "Metric number", "default": "12" },
      { "type": "text", "id": "metric_unit", "label": "Metric unit", "default": "ft" },
      { "type": "text", "id": "problem", "label": "The problem", "default": "It cracks on the first real drop" },
      { "type": "richtext", "id": "body", "label": "The fix" },
      { "type": "text", "id": "them_title", "label": "Them — label", "default": "Typical case" },
      { "type": "text", "id": "them_label", "label": "Them — value", "default": "6–8 ft" },
      { "type": "text", "id": "us_title", "label": "Us — label", "default": "This case" },
      { "type": "text", "id": "us_label", "label": "Us — value", "default": "12 ft" }
    ]},
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "wireless-charge", "label": "Wireless charging" },
        { "value": "camera-lip", "label": "Camera lip" },
        { "value": "button-click", "label": "Button feel" },
        { "value": "precision-fit", "label": "Precision fit" },
        { "value": "sparkle-clear", "label": "Clarity" },
        { "value": "returns", "label": "Returns" },
        { "value": "warranty-seal", "label": "Warranty" },
        { "value": "truck-fast", "label": "Fast shipping" }
      ], "default": "wireless-charge" },
      { "type": "text", "id": "title", "label": "Title", "default": "Qi2 25W charging" },
      { "type": "textarea", "id": "body", "label": "Body", "default": "Charges at full speed with the case on." }
    ]},
    { "type": "bar", "name": "Proof bar", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "This case" },
      { "type": "text", "id": "value", "label": "Displayed value", "default": "12.0 ft" },
      { "type": "range", "id": "pct", "label": "Bar fill %", "min": 4, "max": 100, "step": 2, "default": 100 },
      { "type": "checkbox", "id": "highlight", "label": "Highlight as ours", "default": false }
    ]}
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Convert — Value stack",
      "blocks": [
        { "type": "fix", "settings": { "icon": "honeycomb", "metric_value": "12", "metric_unit": "ft", "problem": "It cracks on the first real drop", "body": "<p>Slim usually means solid plastic corners that pass the shock straight into the frame. These corners are a honeycomb of collapsing air cells — they crush, absorb, and spring back. 26 drops onto concrete, no phone damage.</p>", "them_title": "Typical slim case", "them_label": "6–8 ft", "us_title": "This case", "us_label": "12 ft" } },
        { "type": "fix", "settings": { "icon": "magnet-ring", "metric_value": "1400", "metric_unit": "g", "problem": "The magnet lets go when you need it", "body": "<p>\"MagSafe compatible\" is a sticker, not a spec. We publish pull force. Eighteen N52 magnets in a full ring hold 1,400 g, so your phone stays on the vent mount over a speed bump and still charges at the full Qi2 25W.</p>", "them_title": "Category average", "them_label": "800–900 g", "us_title": "This case", "us_label": "1,400 g" } },
        { "type": "fix", "settings": { "icon": "no-yellow", "metric_value": "36", "metric_unit": "mo", "problem": "Clear turns yellow by month four", "body": "<p>Cheap TPU oxidises under UV and skin oil — that's why your last clear case looked like an old fingernail. This back is UV-stable polycarbonate with a bonded top coat: no measurable colour shift after the equivalent of three years outdoors.</p>", "them_title": "Standard TPU", "them_label": "Yellow by month 4", "us_title": "This case", "us_label": "No shift at 36 mo" } },
        { "type": "benefit", "settings": { "icon": "wireless-charge", "title": "Qi2 25W charging", "body": "Full-speed wireless charging with the case on — no adapter, no guessing." } },
        { "type": "benefit", "settings": { "icon": "camera-lip", "title": "Raised camera lip", "body": "1.4 mm of rim means the lens sits clear of the table face-down." } },
        { "type": "benefit", "settings": { "icon": "button-click", "title": "Buttons that still click", "body": "Harder-durometer covers moulded in, so they never go mushy." } },
        { "type": "benefit", "settings": { "icon": "precision-fit", "title": "Cut from the CAD file", "body": "One mould per model — no universal shells, no loose corners." } },
        { "type": "benefit", "settings": { "icon": "sparkle-clear", "title": "Anti-fingerprint coat", "body": "Wipes clean and keeps the finish even after months in a pocket." } },
        { "type": "benefit", "settings": { "icon": "returns", "title": "30 days to decide", "body": "Any reason, prepaid label, refunded as soon as it's scanned." }},
        { "type": "bar", "settings": { "name": "This case", "value": "12.0 ft", "pct": 100, "highlight": true } },
        { "type": "bar", "settings": { "name": "Rugged bulk case", "value": "10.5 ft", "pct": 88 } },
        { "type": "bar", "settings": { "name": "Designer clear case", "value": "7.2 ft", "pct": 60 } },
        { "type": "bar", "settings": { "name": "Slim hard shell", "value": "5.1 ft", "pct": 42 } },
        { "type": "bar", "settings": { "name": "Marketplace case", "value": "2.9 ft", "pct": 24 } },
        { "type": "bar", "settings": { "name": "No case", "value": "0.9 ft", "pct": 8 } }
      ]
    }
  ]
}
{% endschema %}
