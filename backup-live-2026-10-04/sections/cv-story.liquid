{%- comment -%}
  Casify — Converting PDP: scroll-scrubbed drop sequence.

  A sticky stage on the left, chapters on the right. Scroll position through
  the section drives a single 0→1 progress value (`--cv-p`), and everything —
  the falling phone, the height readout, the impact flash, the shockwave, the
  crushing air cells, the progress rail — is a pure function of that number.
  Nothing animates on a timer, so scrubbing back up rewinds it exactly.

  Progress is published by the `story` module in assets/cv-product.js.
  With reduced motion (or no JS) the stage parks at the impact frame and the
  chapters simply read as a list, which is the honest fallback.
{%- endcomment -%}

{%- liquid
  assign ch_count = 0
  for b in section.blocks
    if b.type == 'chapter'
      assign ch_count = ch_count | plus: 1
    endif
  endfor
-%}

<section class="cv-sec cv-story" id="cv-story" data-cv-story>
  <div class="cv-sec__hd" data-cv-reveal>
    <span class="cv-eyebrow">{{ section.settings.eyebrow | default: 'Section 03 — the drop, frame by frame' | escape }}</span>
    <h2 data-cv-split>{{ section.settings.heading | default: 'What actually happens in 0.8 seconds' | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <div class="cv-sec__lede">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

  <div class="cv-story__grid">
    {%- comment -%} ---------- Sticky stage ---------- {%- endcomment -%}
    <div class="cv-story__col">
      <div class="cv-story__sticky">
        <div class="cv-story__stage" data-cv-story-stage>
          <span class="cv-story__sky" aria-hidden="true"></span>

          {%- comment -%} Height ruler {%- endcomment -%}
          <div class="cv-story__ruler" aria-hidden="true">
            {%- for tick in (0..4) -%}
              {%- assign ft = 12 | minus: forloop.index0 | times: 3 -%}
              <span class="cv-story__tick"><i>{{ ft }}</i></span>
            {%- endfor -%}
          </div>

          {%- comment -%} The falling phone {%- endcomment -%}
          <div class="cv-story__faller" aria-hidden="true">
            <span class="cv-story__trail"></span>
            <svg class="cv-story__phone" viewBox="0 0 76 148" fill="none">
              <rect class="cv-story__shell" x="3" y="3" width="70" height="142" rx="16"
                    fill="var(--cream-50)" stroke="var(--cocoa-600)" stroke-width="2.5"/>
              <rect x="10" y="11" width="56" height="126" rx="10" fill="var(--cocoa-700)" opacity=".9"/>
              <circle cx="38" cy="60" r="15" fill="none" stroke="var(--teal-400)" stroke-width="3" opacity=".85"/>
              <circle cx="38" cy="60" r="5" fill="var(--teal-400)" opacity=".8"/>
              <rect x="46" y="18" width="20" height="20" rx="6" fill="var(--cocoa-600)" stroke="var(--cream-300)" stroke-width="1.5"/>
              {%- comment -%} Corner air cells — these crush on impact {%- endcomment -%}
              <g class="cv-story__cells" stroke="var(--red-500)" stroke-width="2" fill="none">
                <path class="cv-story__cell" d="M6 128c4 0 8 3 8 8"/>
                <path class="cv-story__cell" d="M70 128c-4 0-8 3-8 8"/>
                <path class="cv-story__cell" d="M6 20c4 0 8-3 8-8"/>
                <path class="cv-story__cell" d="M70 20c-4 0-8-3-8-8"/>
              </g>
            </svg>
          </div>

          {%- comment -%} Impact {%- endcomment -%}
          <span class="cv-story__flash" aria-hidden="true"></span>
          <span class="cv-story__ring" aria-hidden="true"></span>
          <span class="cv-story__ring cv-story__ring--2" aria-hidden="true"></span>
          <div class="cv-story__ground" aria-hidden="true">
            <span class="cv-story__ground-line"></span>
            <span class="cv-story__ground-label">{{ section.settings.ground_label | default: 'Concrete' | escape }}</span>
          </div>

          {%- comment -%} Live readout {%- endcomment -%}
          <div class="cv-story__readout">
            <span class="cv-story__readout-n" data-cv-story-height>0.0</span>
            <span class="cv-story__readout-u">{{ section.settings.height_unit | default: 'ft to impact' | escape }}</span>
            <span class="cv-story__readout-phase" data-cv-story-phase>{{ section.settings.phase_start | default: 'Held' | escape }}</span>
          </div>

          <span class="cv-story__verdict" data-cv-story-verdict aria-hidden="true">
            {%- render 'cv-icon', name: 'check', size: 15 -%}
            {{ section.settings.verdict | default: 'Phone intact' | escape }}
          </span>
        </div>

        <div class="cv-story__rail" aria-hidden="true">
          <span class="cv-story__rail-fill" data-cv-story-rail></span>
        </div>
      </div>
    </div>

    {%- comment -%} ---------- Chapters ---------- {%- endcomment -%}
    {%- if ch_count > 0 -%}
      <ol class="cv-story__chapters">
        {%- for b in section.blocks -%}
          {%- if b.type == 'chapter' -%}
            <li class="cv-story__chapter"
                data-cv-story-chapter
                data-cv-at="{{ b.settings.at | default: 0 }}"
                style="--cv-i:{{ forloop.index0 }}"
                {{ b.shopify_attributes }}>
              <span class="cv-story__chapter-n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div class="cv-story__chapter-body">
                {%- if b.settings.metric != blank -%}
                  <span class="cv-story__chapter-metric">
                    <b>{{ b.settings.metric | escape }}</b>
                    <i>{{ b.settings.metric_unit | escape }}</i>
                  </span>
                {%- endif -%}
                <h3>{{ b.settings.title | escape }}</h3>
                <div class="cv-story__chapter-copy">{{ b.settings.body }}</div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>

  {%- if section.settings.footnote != blank -%}
    <p class="cv-story__foot" data-cv-reveal>
      {%- render 'cv-icon', name: 'lab', size: 14 -%}
      {{ section.settings.footnote | escape }}
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Convert — Drop sequence",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Section 03 — the drop, frame by frame" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What actually happens in 0.8 seconds" },
    { "type": "richtext", "id": "subheading", "label": "Sub-heading", "default": "<p>Scroll to run the drop. Every number below was measured on the way down.</p>" },
    { "type": "text", "id": "height_unit", "label": "Readout unit", "default": "ft to impact" },
    { "type": "text", "id": "phase_start", "label": "Starting phase label", "default": "Held" },
    { "type": "text", "id": "ground_label", "label": "Ground label", "default": "Concrete" },
    { "type": "text", "id": "verdict", "label": "Impact verdict", "default": "Phone intact" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Independent lab · 26 drops per unit onto concrete · MIL-STD-810G 516.6" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "range", "id": "at", "label": "Activates at (% of scroll)", "min": 0, "max": 100, "step": 5, "default": 0 },
        { "type": "text", "id": "metric", "label": "Metric" },
        { "type": "text", "id": "metric_unit", "label": "Metric unit" },
        { "type": "text", "id": "title", "label": "Title", "default": "Release" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Convert — Drop sequence",
      "blocks": [
        { "type": "chapter", "settings": { "at": 0, "metric": "12", "metric_unit": "ft", "title": "Release", "body": "<p>Twelve feet is roof-of-the-car height, or the top of a stairwell. Four times the height Apple drop-tests to, and the height we publish because it's the one that keeps happening.</p>" } },
        { "type": "chapter", "settings": { "at": 30, "metric": "0.86", "metric_unit": "s", "title": "Free fall", "body": "<p>The case is doing nothing yet. What matters is that the corners are already the thickest part of the shell — 4.7 mm against 2.8 mm across the back — because that's where the floor is going to arrive first.</p>" } },
        { "type": "chapter", "settings": { "at": 60, "metric": "19", "metric_unit": "mph", "title": "Contact", "body": "<p>A corner lands first, near enough every time. A solid plastic corner has nowhere to put that energy, so it hands it straight to the aluminium frame and the glass bonded to it.</p>" } },
        { "type": "chapter", "settings": { "at": 75, "metric": "-64", "metric_unit": "% force", "title": "The cells collapse", "body": "<p>The honeycomb crushes for about three milliseconds, and that tiny delay is the whole trick — spreading the same energy over more time cuts the peak force reaching the phone by roughly two thirds.</p>" } },
        { "type": "chapter", "settings": { "at": 90, "metric": "26", "metric_unit": "drops", "title": "It springs back", "body": "<p>The cells re-inflate and the case is ready for the next one. Twenty-six consecutive drops per unit, no phone damage, no permanent deformation in the corner.</p>" } }
      ]
    }
  ]
}
{% endschema %}
