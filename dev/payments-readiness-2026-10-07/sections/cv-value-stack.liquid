{%- comment -%}
  Casify — Converting PDP: value stack, redesigned.

  Content is unchanged: every heading, problem, fix, benefit, and every proof-
  bar name/value/percentage is exactly what shipped before, straight out of
  the same schema/preset defaults. This pass only changes how it's built and
  how it moves.

  Three parts, all block-driven:
    1. "problem → fix" rows: icon in a brass medallion, a count-up metric, and
       a them-vs-us balance beam that tips toward "us" on reveal
    2. a benefit grid, lightly refreshed
    3. the proof chart rebuilt as a vertical gauge: each contender's column
       rises from the counter line in sequence, tallest first, ours capped
       with a candy-cane flag
  Styles: assets/cv-value-stack.css. Motion: assets/cv-value-stack-motion.js.
{%- endcomment -%}
{{ 'cv-value-stack.css' | asset_url | stylesheet_tag }}
<script>
  (function (root) {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('cvvs-pending');
    setTimeout(function () { root.classList.remove('cvvs-pending'); }, 1600);
  })(document.documentElement);
</script>

{%- comment -%} No "cvvs" class here: cv-vs.css styles .cvvs as the "Us vs. them" section root. {%- endcomment -%}
<section class="cv-sec cv-values" id="cv-value" data-cvvs>
  <div class="cv-sec__hd" data-cv-reveal>
    <span class="cv-eyebrow">
      <span class="cv-eyebrow__ico" aria-hidden="true">{{ 'icon-candy-swirl.svg' | inline_asset_content }}</span>
      {{ section.settings.eyebrow | default: 'Before you order' | escape }}
    </span>
    <h2 data-cv-split>{{ section.settings.heading | default: 'Three steps to choose your case' | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <div class="cv-sec__lede">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- 1. Problem / fix rows ---------- {%- endcomment -%}
  {%- assign fix_i = 0 -%}
  {%- for b in section.blocks -%}
    {%- if b.type == 'fix' -%}
      {%- assign fix_i = fix_i | plus: 1 -%}
      {%- assign fix_i_mod = fix_i | modulo: 2 -%}
      <article class="cvvs-fix{% if fix_i_mod == 0 %} cvvs-fix--flip{% endif %}" data-cvvs-fix {{ b.shopify_attributes }}>
        <div class="cvvs-fix__figure">
          <span class="cvvs-fix__medal" aria-hidden="true"></span>
          <span class="cvvs-fix__ico">{%- render 'cv-icon', name: b.settings.icon, size: 56, animate: true -%}</span>
          <span class="cvvs-fix__metric" data-cvvs-metric data-value="{{ b.settings.metric_value }}">
            <b data-cvvs-metric-num>{{ b.settings.metric_value | escape }}</b><i>{{ b.settings.metric_unit | escape }}</i>
          </span>
        </div>

        <div class="cvvs-fix__body">
          <span class="cvvs-fix__index">{{ fix_i | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="cvvs-fix__problem">{{ b.settings.problem | escape }}</h3>
          <div class="cvvs-fix__copy">{{ b.settings.body }}</div>

          {%- if b.settings.them_label != blank or b.settings.us_label != blank -%}
            <div class="cvvs-beam" data-cvvs-beam>
              <span class="cvvs-beam__side cvvs-beam__side--them">
                <span class="cvvs-beam__tag">{%- render 'cv-icon', name: 'cross', size: 13 -%} {{ b.settings.them_title | default: 'Typical case' | escape }}</span>
                <strong>{{ b.settings.them_label | escape }}</strong>
              </span>
              <span class="cvvs-beam__fulcrum" aria-hidden="true">
                <span class="cvvs-beam__bar" data-cvvs-beam-bar></span>
              </span>
              <span class="cvvs-beam__side cvvs-beam__side--us">
                <span class="cvvs-beam__tag">{%- render 'cv-icon', name: 'check', size: 13 -%} {{ b.settings.us_title | default: 'This case' | escape }}</span>
                <strong>{{ b.settings.us_label | escape }}</strong>
              </span>
            </div>
          {%- endif -%}
        </div>
      </article>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ---------- 2. Benefit grid ---------- {%- endcomment -%}
  {%- assign has_benefit = false -%}
  {%- for b in section.blocks -%}{%- if b.type == 'benefit' -%}{%- assign has_benefit = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_benefit -%}
    <div class="cvvs-benefits">
      {%- if section.settings.benefits_heading != blank -%}
        <h3 class="cvvs-benefits__hd" data-cv-reveal>{{ section.settings.benefits_heading | escape }}</h3>
      {%- endif -%}
      <ul class="cvvs-benefits__grid" role="list">
        {%- for b in section.blocks -%}
          {%- if b.type == 'benefit' -%}
            <li class="cvvs-benefit" data-cvvs-benefit style="--i:{{ forloop.index0 }}" {{ b.shopify_attributes }}>
              <span class="cvvs-benefit__ico">{%- render 'cv-icon', name: b.settings.icon, size: 28, animate: true -%}</span>
              <h4>{{ b.settings.title | escape }}</h4>
              <p>{{ b.settings.body | escape }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- 3. Proof gauge ---------- {%- endcomment -%}
  {%- assign bars = section.blocks | where: 'type', 'bar' -%}
  {%- if bars.size > 0 -%}
    <div class="cvvs-gauge" data-cvvs-gauge>
      <div class="cvvs-gauge__hd">
        <span class="cv-eyebrow">{{ section.settings.proof_eyebrow | default: 'Product information' | escape }}</span>
        <h3>{{ section.settings.proof_heading | default: 'Product information' | escape }}</h3>
      </div>
      <div class="cvvs-gauge__rig" tabindex="0" role="group" aria-label="{{ section.settings.proof_heading | default: 'Product information' | escape }}">
        {%- for b in bars -%}
          <div class="cvvs-gauge__col{% if b.settings.highlight %} is-us{% endif %}" data-cvvs-col data-pct="{{ b.settings.pct | default: 50 }}" style="--i:{{ forloop.index0 }}" {{ b.shopify_attributes }}>
            <span class="cvvs-gauge__val" data-cvvs-col-val>{{ b.settings.value | escape }}</span>
            <span class="cvvs-gauge__bar" data-cvvs-col-bar style="--fill: {{ b.settings.pct | default: 50 }}%">
              {%- if b.settings.highlight -%}<span class="cvvs-gauge__flag" aria-hidden="true">{%- render 'cv-icon', name: 'candy-cane', size: 20 -%}</span>{%- endif -%}
            </span>
            <span class="cvvs-gauge__name">{{ b.settings.name | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
      <span class="cvvs-gauge__line" aria-hidden="true"></span>
      {%- if section.settings.proof_footnote != blank -%}
        <p class="cvvs-gauge__foot">{%- render 'cv-icon', name: 'lab', size: 14 -%} {{ section.settings.proof_footnote | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
<script src="{{ 'cv-value-stack-motion.js' | asset_url }}" defer></script>

