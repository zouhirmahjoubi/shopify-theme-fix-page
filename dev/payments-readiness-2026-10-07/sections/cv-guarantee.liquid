            },
            {
              "value": "warranty-seal",
              "label": "Warranty"
            },
            {
              "value": "drop-shield",
              "label": "Protection"
            },
            {
              "value": "truck-fast",
              "label": "Shipping"
            },
            {
              "value": "lock-secure",
              "label": "Secure"
            },
            {
              "value": "lab",
              "label": "Lab tested"
            }
          ],
          "default": "returns"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30-day returns"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "You have 30 days after delivery to request a return. Read our return policy for conditions and instructions."
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I choose the right model?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "closer_note",
      "name": "Closer note",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on every order"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Convert — Guarantee & FAQ",
      "blocks": [
        {
          "type": "guarantee",
          "settings": {
            "icon": "returns",
            "title": "30-day returns",
            "body": "You have 30 days after delivery to request a return. Read our return policy for conditions and instructions."
          }
        },
        {
          "type": "guarantee",
          "settings": {
            "icon": "truck-fast",
            "title": "Dispatch in 1–2 business days",
            "body": "Orders dispatch from the USA within 1–2 business days. Delivery estimates vary by product and are shown at checkout."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I choose the right model?",
            "answer": "<p>Check your model name in your phone settings, then choose the matching model from the list on the product page.</p>",
            "default_open": true
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Does this case support wireless charging?",
            "answer": "<p>Compatibility varies by design. Read the product details for the case you choose and check your charger requirements.</p>",
