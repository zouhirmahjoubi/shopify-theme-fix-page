            "default_open": false
          }
        },
        {
          "type": "closer_note",
          "settings": {
            "text": "Free shipping on every order"
          }
        },
        {
          "type": "closer_note",
          "settings": {
            "text": "30-day returns"
          }
        },
        {
          "type": "closer_note",
          "settings": {
            "text": "Ships in 1–2 business days"
          }
        },
        {
          "type": "closer_note",
