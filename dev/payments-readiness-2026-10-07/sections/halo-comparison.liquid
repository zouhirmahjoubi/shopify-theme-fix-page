<section class="halo-sec">
  <div class="halo-sec__hd" data-halo-reveal>
    <span class="tick">{{ section.settings.tick_label | default: 'Section 05 — side by side' }}</span>
    <h2>{{ section.settings.heading | default: "Halo vs. the case you're using right now" }}</h2>
  </div>

  <div class="halo-cmp">
    <div class="halo-cmp__box">
      <table>
        <thead>
          <tr>
            <th scope="col">Measured spec</th>
            {%- for col in section.blocks -%}
              {%- if col.type == 'column' -%}
                <th scope="col"{% if forloop.first %} class="col-us"{% endif %}>{{ col.settings.col | escape }}</th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for row in section.blocks -%}
            {%- if row.type == 'row' -%}
              <tr>
                <th scope="row">{{ row.settings.row | escape }}</th>
                {%- assign ci = 0 -%}
                {%- for col in section.blocks -%}
                  {%- if col.type == 'column' -%}
                    {%- assign ci = ci | plus: 1 -%}
                    {%- assign key = 'cell_' | append: ci -%}
                    {%- assign raw = row.settings[key] | default: '' -%}
                    {%- assign parts = raw | split: '||' -%}
                    {%- assign value = parts[0] | default: '' -%}
                    {%- assign kind  = parts[1] | default: 'val' -%}
                    <td class="{% if forloop.first %}col-us {% endif %}{% if kind == 'yes' %}yes{% elsif kind == 'no' %}no{% else %}val{% endif %}">{{ value | escape }}</td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
